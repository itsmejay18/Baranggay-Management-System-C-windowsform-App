<UserControl x:Class="baranggaysystem1.Views.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">

    <!--
    Reusable statistics card for dashboards and module headers.
    Shows a metric value with label, icon, and optional trend indicator.
    
    Usage:
      <controls:StatCard 
          Label="Total Residents"
          Value="1,234"
          Icon="Users"
          IconBackground="#F0FDF4"
          IconForeground="#22C55E"
          TrendText="+12 this month"
          TrendDirection="Up" />
    -->

    <Border x:Name="cardBorder"
            Background="White"
            CornerRadius="16"
            Padding="20"
            BorderBrush="#F1F5F9"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.04" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Icon -->
            <Border x:Name="iconBorder"
                    Grid.Row="0"
                    Width="52" Height="52"
                    CornerRadius="14"
                    Background="#F0FDF4"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,14">
                <fa:IconBlock x:Name="iconElement"
                              Icon="ChartBar"
                              FontSize="24"
                              Foreground="#22C55E"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            </Border>

            <!-- Value and Label -->
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="labelText"
                           Text="Metric"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Margin="0,0,0,6"
                           FontFamily="Trebuchet MS" />
                <TextBlock x:Name="valueText"
                           Text="0"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           FontFamily="Century Gothic" />
            </StackPanel>

            <!-- Trend indicator -->
            <Border x:Name="trendPanel"
                    Grid.Row="2"
                    Background="#F0FDF4"
                    CornerRadius="6"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="trendArrow"
                               Text="↑"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               Margin="0,0,4,0" />
                    <TextBlock x:Name="trendText"
                               Text=""
                               FontSize="11"
                               Foreground="#16A34A"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
