<UserControl x:Class="baranggaysystem1.Views.Controls.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380"
             Opacity="0">

    <Border x:Name="toastBorder"
            Background="#FF1e293b"
            CornerRadius="14"
            Padding="0"
            Margin="0,8"
            BorderBrush="#FF334155"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.35" ShadowDepth="6" Direction="270" />
        </Border.Effect>

        <Grid>
            <!-- Colored accent bar on the left -->
            <Rectangle x:Name="accentBar"
                       Width="4"
                       HorizontalAlignment="Left"
                       Fill="#3B82F6"
                       RadiusX="0" RadiusY="0" />

            <Grid Margin="18,14,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon with background circle -->
                <Border x:Name="iconBorder"
                        Width="32" Height="32"
                        CornerRadius="16"
                        Background="#1D3B82F6"
                        VerticalAlignment="Top"
                        Margin="0,0,12,0">
                    <TextBlock x:Name="toastIcon"
                               Text="ℹ️"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="toastTitle"
                               Text="Notification"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="toastMessage"
                               Text=""
                               FontSize="11.5"
                               Foreground="#94a3b8"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               LineHeight="16"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- Close button -->
                <Button x:Name="closeButton"
                        Grid.Column="2"
                        Content="✕"
                        FontSize="12"
                        Foreground="#64748b"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        Margin="8,0,0,0"
                        Click="CloseButton_Click"
                        ToolTip="Dismiss" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
