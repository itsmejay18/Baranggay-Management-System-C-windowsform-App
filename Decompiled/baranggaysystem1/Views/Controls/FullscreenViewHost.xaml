<UserControl x:Class="baranggaysystem1.Views.Controls.FullscreenViewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:conv="clr-namespace:baranggaysystem1.Views.Converters"
             xmlns:controls="clr-namespace:baranggaysystem1.Views.Controls"
             x:Name="fullscreenHost">

    <!--
    FullscreenViewHost: Reusable container UserControl providing consistent fullscreen view chrome.
    Provides: Back button, title area, action toolbar (top or side), and content presenter.
    
    Requirements: 1.4, 2.1, 5.1, 5.2, 9.1, 9.2, 9.3, 9.4, 9.5
    
    Usage:
      var host = new FullscreenViewHost();
      host.ViewTitle = "Add New Resident";
      host.ViewSubtitle = "Fill in the resident information below";
      host.ContentArea = myFormPanel;
      host.ShowSideToolbar = false;
    -->

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <!-- Outer Border: CornerRadius 14, CardStyle DropShadowEffect, with TranslateTransform for animation -->
    <Border x:Name="outerBorder"
            Style="{StaticResource FullscreenHostBorderStyle}">

        <!-- Main layout grid: Header row + Content area (80-90% height) -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header row: auto-sized for back button, icon, title, subtitle, toolbar -->
                <RowDefinition Height="Auto" />
                <!-- Content area: takes remaining space (proportional sizing for 80-90%) -->
                <RowDefinition Height="9*" />
                <!-- Bottom margin spacer -->
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- ============================================================
                 HEADER ROW: Back button, optional Icon, ViewTitle, ViewSubtitle, Top Toolbar
                 ============================================================ -->
            <Grid Grid.Row="0" Margin="16,16,16,8">
                <Grid.ColumnDefinitions>
                    <!-- Back button (fixed 44x44) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Optional icon -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Title -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Subtitle -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Top toolbar (horizontal) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back Button: 44x44 minimum tap target, fixed at top -->
                <Button x:Name="backButton"
                        Grid.Column="0"
                        Style="{StaticResource FullscreenBackButtonStyle}"
                        Click="BackButton_Click"
                        AutomationProperties.Name="Back"
                        ToolTip="Go Back (Alt+Left)"
                        IsTabStop="True"
                        TabIndex="0">
                    <fa:IconImage Icon="ArrowLeft"
                                  Width="18" Height="18"
                                  Foreground="{StaticResource Slate700Brush}" />
                </Button>

                <!-- Optional View Icon: collapses when no icon is provided -->
                <Border x:Name="iconArea"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <fa:IconImage x:Name="viewIcon"
                                  Width="22" Height="22"
                                  Foreground="{StaticResource Slate600Brush}" />
                </Border>

                <!-- View Title -->
                <TextBlock x:Name="titleText"
                           Grid.Column="2"
                           Style="{StaticResource FullscreenTitleStyle}"
                           Text="View Title"
                           AutomationProperties.Name="View Title" />

                <!-- View Subtitle: collapses when empty/null -->
                <TextBlock x:Name="subtitleText"
                           Grid.Column="3"
                           Style="{StaticResource FullscreenSubtitleStyle}"
                           Text=""
                           Visibility="Collapsed"
                           AutomationProperties.Name="View Subtitle" />

                <!-- Top Toolbar Panel (horizontal): visible when ShowSideToolbar is false -->
                <StackPanel x:Name="topToolbarPanel"
                            Grid.Column="5"
                            Style="{StaticResource FullscreenToolbarPanelStyle}" />

                <!-- Read-only indicator: shown when all toolbar actions are hidden due to permissions -->
                <Border x:Name="readOnlyIndicator"
                        Grid.Column="5"
                        Visibility="Collapsed"
                        Background="{StaticResource Slate100Brush}"
                        CornerRadius="6"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock Text="Read Only"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{StaticResource Slate500Brush}"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Read-only view" />
                </Border>
            </Grid>

            <!-- ============================================================
                 CONTENT AREA: occupies 80-90% of available height via Grid row proportions
                 Layout: optional side toolbar + content presenter + loading overlay + error panel
                 ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Content area -->
                    <ColumnDefinition Width="*" />
                    <!-- Side toolbar (conditional) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Content Presenter Area -->
                <ContentPresenter x:Name="contentPresenter"
                                  Grid.Column="0"
                                  Style="{StaticResource FullscreenContentPresenterStyle}" />

                <!-- Loading Overlay: shown during async data fetch (Requirement 7.5) -->
                <controls:LoadingOverlay x:Name="loadingOverlay"
                                         Grid.Column="0"
                                         Panel.ZIndex="10" />

                <!-- Error Panel with Retry: shown when data fetch fails or times out (Requirement 7.6) -->
                <Border x:Name="errorPanel"
                        Grid.Column="0"
                        Panel.ZIndex="10"
                        Visibility="Collapsed"
                        Background="#F8FFFFFF"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border Background="White"
                            CornerRadius="16"
                            Padding="40,32"
                            BorderBrush="#FEE2E2"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" Direction="270" />
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" MaxWidth="400">
                            <!-- Error icon -->
                            <fa:IconImage Icon="ExclamationTriangle"
                                          Width="40" Height="40"
                                          Foreground="#EF4444"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,16" />

                            <!-- Error title -->
                            <TextBlock Text="Failed to Load Data"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       FontFamily="Trebuchet MS" />

                            <!-- Error message -->
                            <TextBlock x:Name="errorMessageText"
                                       Text="An error occurred while loading data."
                                       FontSize="13"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20"
                                       FontFamily="Trebuchet MS" />

                            <!-- Retry button -->
                            <Button x:Name="retryButton"
                                    Click="RetryButton_Click"
                                    HorizontalAlignment="Center"
                                    Padding="20,10"
                                    Cursor="Hand"
                                    AutomationProperties.Name="Retry loading data">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#3B82F6" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2563EB" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Redo" Width="14" Height="14"
                                                  Foreground="White" Margin="0,0,8,0" />
                                    <TextBlock Text="Retry" Foreground="White"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Side Toolbar Panel (vertical): visible only when ShowSideToolbar is true -->
                <Border x:Name="sideToolbarBorder"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Margin="0,8,20,20"
                        VerticalAlignment="Stretch">
                    <StackPanel x:Name="sideToolbarPanel"
                                Style="{StaticResource FullscreenSideToolbarStyle}" />
                </Border>
            </Grid>

            <!-- Row 2 is the bottom spacer (1* of 10 total = ~10% bottom margin) -->
        </Grid>
    </Border>
</UserControl>
