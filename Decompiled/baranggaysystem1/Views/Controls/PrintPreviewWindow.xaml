<Window x:Class="baranggaysystem1.Views.Controls.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview"
        WindowStartupLocation="CenterOwner"
        Width="850"
        Height="700"
        ResizeMode="CanResize"
        Background="#FF1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FF2d2d44" Padding="16,10" BorderBrush="#FF334155" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="🖨️ Print"
                        Click="PrintButton_Click"
                        Padding="16,8"
                        FontSize="13"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0" />
                <Button Content="💾 Save as PDF"
                        Click="SavePdfButton_Click"
                        Padding="16,8"
                        FontSize="13"
                        Background="#3498db"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0" />
                <Button Content="🔍 Zoom In"
                        Click="ZoomInButton_Click"
                        Padding="12,8"
                        FontSize="12"
                        Background="Transparent"
                        Foreground="#AAB8C2"
                        BorderBrush="#5c5c8a"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,4,0" />
                <Button Content="🔍 Zoom Out"
                        Click="ZoomOutButton_Click"
                        Padding="12,8"
                        FontSize="12"
                        Background="Transparent"
                        Foreground="#AAB8C2"
                        BorderBrush="#5c5c8a"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,16,0" />
                <TextBlock x:Name="zoomLabel"
                           Text="100%"
                           FontSize="12"
                           Foreground="#AAB8C2"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <Button Content="Close"
                        Click="CloseButton_Click"
                        Padding="16,8"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="#FF6B6B"
                        BorderBrush="#FF6B6B"
                        BorderThickness="1"
                        Cursor="Hand"
                        HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- Preview Area -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#FF0f172a">
            <Border x:Name="previewContainer"
                    Background="White"
                    Margin="40"
                    Padding="48"
                    MinWidth="600"
                    MaxWidth="800"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" />
                </Border.Effect>

                <!-- Document content will be placed here -->
                <StackPanel x:Name="documentContent">
                    <TextBlock x:Name="previewPlaceholder"
                               Text="Document preview will appear here."
                               FontSize="14"
                               Foreground="#64748b"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
