<UserControl x:Class="baranggaysystem1.Views.Controls.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Reusable pagination bar for data grids and lists.
    Shows page info, prev/next buttons, and page size selector.
    
    Usage:
      <controls:PaginationBar x:Name="pager"
          PageChanged="OnPageChanged" />
      
    Code-behind:
      pager.Update(currentPage: 1, totalPages: 10, totalItems: 245);
    -->

    <Border Background="White"
            CornerRadius="12"
            Padding="16,10"
            BorderBrush="#F1F5F9"
            BorderThickness="1"
            Margin="0,10,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.03" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Page info -->
            <TextBlock x:Name="pageInfoText"
                       Grid.Column="0"
                       Text="Page 1 of 1"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#475569"
                       VerticalAlignment="Center" />

            <!-- Total items -->
            <TextBlock x:Name="totalItemsText"
                       Grid.Column="1"
                       Text=""
                       FontSize="11"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />

            <!-- Navigation buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Page size selector -->
                <TextBlock Text="Show:"
                           FontSize="11"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="pageSizeCombo"
                          Width="62"
                          FontSize="11"
                          VerticalContentAlignment="Center"
                          SelectionChanged="PageSizeCombo_SelectionChanged">
                    <ComboBoxItem Content="25" />
                    <ComboBoxItem Content="50" IsSelected="True" />
                    <ComboBoxItem Content="100" />
                </ComboBox>

                <!-- Separator -->
                <Border Width="1" Height="20" Background="#F1F5F9" Margin="14,0" />

                <!-- First page -->
                <Button x:Name="firstButton"
                        Content="⟨⟨"
                        Click="FirstButton_Click"
                        Padding="8,5"
                        FontSize="12"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#64748B"
                        Cursor="Hand"
                        ToolTip="First page" />

                <!-- Previous -->
                <Button x:Name="prevButton"
                        Content="⟨"
                        Click="PrevButton_Click"
                        Padding="8,5"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#64748B"
                        Cursor="Hand"
                        ToolTip="Previous page" />

                <!-- Current page indicator -->
                <Border Background="#EFF6FF"
                        CornerRadius="8"
                        Padding="12,5"
                        Margin="4,0">
                    <TextBlock x:Name="currentPageText"
                               Text="1"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#2563EB" />
                </Border>

                <!-- Next -->
                <Button x:Name="nextButton"
                        Content="⟩"
                        Click="NextButton_Click"
                        Padding="8,5"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#64748B"
                        Cursor="Hand"
                        ToolTip="Next page" />

                <!-- Last page -->
                <Button x:Name="lastButton"
                        Content="⟩⟩"
                        Click="LastButton_Click"
                        Padding="8,5"
                        FontSize="12"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#64748B"
                        Cursor="Hand"
                        ToolTip="Last page" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
