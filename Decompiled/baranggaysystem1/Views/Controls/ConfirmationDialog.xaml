<Window x:Class="baranggaysystem1.Views.Controls.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <!--
    Modern confirmation dialog replacing MessageBox.
    Provides consistent styling and better UX than system dialogs.
    
    Usage:
      var result = ConfirmationDialog.Show(
          owner: this,
          title: "Delete Resident",
          message: "Are you sure you want to archive this resident? This action can be undone.",
          confirmText: "Archive",
          cancelText: "Cancel",
          type: ConfirmationType.Warning);
    -->

    <Border Background="White"
            CornerRadius="18"
            Padding="0"
            BorderBrush="#F1F5F9"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Opacity="0.14" ShadowDepth="10" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header with icon -->
            <Border Grid.Row="0" Padding="28,24,28,0">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="iconCircle"
                            Width="48" Height="48"
                            CornerRadius="24"
                            Background="#FEF2F2"
                            Margin="0,0,16,0">
                        <TextBlock x:Name="iconText"
                                   Text="⚠"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="titleText"
                                   Text="Confirm Action"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   FontFamily="Century Gothic" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Message -->
            <Border Grid.Row="1" Padding="28,16,28,22">
                <TextBlock x:Name="messageText"
                           Text="Are you sure you want to proceed?"
                           FontSize="13.5"
                           Foreground="#475569"
                           TextWrapping="Wrap"
                           LineHeight="21" />
            </Border>

            <!-- Buttons -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    Padding="28,16"
                    CornerRadius="0,0,18,18"
                    BorderBrush="#F1F5F9"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="cancelButton"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            Padding="20,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="White"
                            Foreground="#475569"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="cancelBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cancelBorder" Property="Background" Value="#F8FAFC" />
                                        <Setter TargetName="cancelBorder" Property="BorderBrush" Value="#94A3B8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="confirmButton"
                            Content="Confirm"
                            Click="ConfirmButton_Click"
                            Padding="20,10"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Direction="270" />
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
