<UserControl x:Class="baranggaysystem1.Views.Controls.FormValidationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <!--
    Inline form validation feedback panel.
    Shows validation errors in a clear, accessible format.
    
    Usage:
      <controls:FormValidationPanel x:Name="validationPanel" />
      
    Code-behind:
      validationPanel.ShowErrors(new[] { "First name is required.", "Invalid email." });
      validationPanel.ShowSuccess("Resident saved successfully.");
      validationPanel.Clear();
    -->

    <Border x:Name="panelBorder"
            CornerRadius="10"
            Padding="14,12"
            Margin="0,8,0,8"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock x:Name="statusIcon"
                       Text="⚠"
                       FontSize="16"
                       VerticalAlignment="Top"
                       Margin="0,2,12,0" />

            <!-- Messages -->
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="headerText"
                           Text="Please fix the following:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <ItemsControl x:Name="errorList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="•" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Single message (for success/info) -->
                <TextBlock x:Name="singleMessage"
                           Text=""
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- Dismiss button -->
            <Button x:Name="dismissButton"
                    Grid.Column="2"
                    Content="✕"
                    FontSize="12"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Top"
                    Opacity="0.6"
                    Click="DismissButton_Click" />
        </Grid>
    </Border>
</UserControl>
