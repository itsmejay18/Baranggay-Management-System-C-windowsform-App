<UserControl x:Class="baranggaysystem1.Views.Controls.EmptyStatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">

    <!-- 
    Reusable empty state panel for lists/grids with no data.
    Shows an icon, title, description, and optional action button.
    
    Usage:
      <controls:EmptyStatePanel 
          Icon="Users" 
          Title="No Residents Found"
          Description="Add your first resident or adjust your filters."
          ActionText="Add Resident"
          ActionClick="AddResident_Click" />
    -->

    <Border x:Name="rootBorder"
            Background="Transparent"
            Padding="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
            <!-- Illustration circle with subtle ring -->
            <Grid Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Ellipse Fill="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="2" />
                <Border Width="80" Height="80"
                        CornerRadius="40"
                        Background="#F1F5F9"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <fa:IconBlock x:Name="iconBlock"
                                  Icon="FolderOpen"
                                  FontSize="34"
                                  Foreground="#94A3B8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Title -->
            <TextBlock x:Name="titleText"
                       Text="No Data"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontFamily="Century Gothic"
                       Margin="0,0,0,10" />

            <!-- Description -->
            <TextBlock x:Name="descriptionText"
                       Text="There's nothing here yet."
                       FontSize="13"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,24" />

            <!-- Action button (optional) -->
            <Button x:Name="actionButton"
                    Content="Take Action"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Padding="22,11"
                    FontSize="13"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="ActionButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#3B82F6" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="btnBorder" Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12" Color="#3B82F6" Direction="270" />
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#2563EB" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Secondary hint -->
            <TextBlock x:Name="hintText"
                       Text=""
                       FontSize="11"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,14,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
