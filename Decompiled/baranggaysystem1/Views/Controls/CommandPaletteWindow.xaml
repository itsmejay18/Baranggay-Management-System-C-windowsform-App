<Window x:Class="baranggaysystem1.Views.Controls.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Navigation"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="520"
        MaxHeight="500"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#FF1e293b"
            CornerRadius="16"
            BorderBrush="#FF334155"
            BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.4" ShadowDepth="8" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Input -->
            <Border Grid.Row="0" BorderBrush="#FF334155" BorderThickness="0,0,0,1" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="searchBox"
                             Grid.Column="1"
                             FontSize="15"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"
                             CaretBrush="White"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />
                </Grid>
            </Border>

            <!-- Results List -->
            <ListBox x:Name="resultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="340"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ResultsList_SelectionChanged"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,10" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="#94a3b8"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Shortcut}"
                                           FontSize="10"
                                           Foreground="#64748b"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF334155" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2d3a4f" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#FF334155" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="↑↓ Navigate" FontSize="10" Foreground="#64748b" Margin="0,0,16,0" />
                    <TextBlock Text="Enter Select" FontSize="10" Foreground="#64748b" Margin="0,0,16,0" />
                    <TextBlock Text="Esc Close" FontSize="10" Foreground="#64748b" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
