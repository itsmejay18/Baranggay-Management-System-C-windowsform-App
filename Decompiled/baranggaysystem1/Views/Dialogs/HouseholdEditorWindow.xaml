<Window x:Class="baranggaysystem1.Views.Dialogs.HouseholdEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Width="760" Height="620" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding WindowTitle}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="24,20" Background="{StaticResource Slate900Brush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="10" Background="#1E293B" Margin="0,0,12,0">
              <fa:IconBlock Icon="Home" Foreground="#38BDF8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" Text="{Binding WindowTitle}" />
              <TextBlock Foreground="#CBD5E1" FontSize="12" Margin="0,3,0,0" Text="{Binding Subtitle}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#334155" Padding="14,10" CornerRadius="12" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="RECORD" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" />
            <TextBlock Foreground="#FFFFFFFF" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Text="{Binding HouseholdLabel}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20,24,20">
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Address Details" Style="{StaticResource HeadingTextStyle}" />
              <TextBlock Text="Fill in the barangay household location details before assigning family members." Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,16" />
              <TextBlock Text="Purok" Style="{StaticResource LabelTextStyle}" />
              <ComboBox DisplayMemberPath="Name" Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding PurokOptions}" SelectedItem="{Binding SelectedPurok}" />
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="House No." Style="{StaticResource LabelTextStyle}" />
                  <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding HouseNo, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Street" Style="{StaticResource LabelTextStyle}" />
                  <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Subdivision" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,0" />
              <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding Subdivision, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Landmark or remarks" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,0" />
              <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding AddressNote, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="14" Padding="16">
              <StackPanel>
                <Border Width="42" Height="42" CornerRadius="12" Background="#DBEAFE">
                  <fa:IconBlock Icon="MapMarkerAlt" Foreground="#2563EB" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="What this does" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" Margin="0,14,0,6" />
                <TextBlock Text="Creates or updates the household address record used by resident and family assignment." Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />
                <Separator Margin="0,14,0,14" />
                <TextBlock Text="After saving" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Slate700Brush}" />
                <TextBlock Text="New households will open family management right away so you can add members." Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="Map Coordinates" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Text="Optional values for future mapping and address pinpointing." Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,16" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Latitude" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Longitude" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <TextBlock Text="Household details are saved to local MySQL." VerticalAlignment="Center" Style="{StaticResource SmallTextStyle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="110" Height="40" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
          <Button Style="{StaticResource PrimaryButtonStyle}" Width="170" Height="40" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>