<Window x:Class="baranggaysystem1.Views.Dialogs.AnnouncementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Announcement" Width="600" Height="620" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1D4ED8" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="Bullhorn" Foreground="#BFDBFE" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Name="eyebrowText" Text="NEW ANNOUNCEMENT" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="headerTitleText" Text="Publish a barangay announcement" Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" />
        <TextBlock Name="headerSubtitleText" Text="Create updates that appear on the dashboard feed and can be prioritized for visibility." Foreground="#DBEAFE" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <TextBlock Text="Announcement Title" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
        <TextBox Name="txtTitle" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="150" />
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Priority" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="priorityCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Publish Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="statusCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <CheckBox Name="chkPinned" Content="Pin this announcement to the top of the dashboard feed" Margin="0,18,0,0" FontSize="12" Foreground="{StaticResource Slate700Brush}" />
        <TextBlock Text="Announcement Body" Style="{StaticResource LabelTextStyle}" Margin="0,20,0,8" />
        <TextBox Name="txtBody" Style="{StaticResource StyledTextBoxStyle}" Height="220" MaxLength="4000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />
        <Border Margin="0,20,0,0" Padding="14" Background="#EFF6FF" CornerRadius="10" BorderBrush="#DBEAFE" BorderThickness="1">
          <DockPanel>
            <fa:IconBlock Icon="InfoCircle" Foreground="#2563EB" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Published announcements appear in the dashboard feed. Use Archived to keep the record without promoting it in current operations." Foreground="#1D4ED8" FontSize="12" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40" Margin="0,0,12,0" IsCancel="True" />
        <Button Name="btnConfirm" Content="Save Announcement" Style="{StaticResource PrimaryButtonStyle}" Width="180" Height="40" IsDefault="True" Click="BtnConfirm_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>