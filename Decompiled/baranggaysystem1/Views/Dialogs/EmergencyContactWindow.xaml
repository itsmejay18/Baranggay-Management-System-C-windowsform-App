<Window x:Class="baranggaysystem1.Views.Dialogs.EmergencyContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Emergency Contact" Width="620" Height="680"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#DC2626" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="PhoneAlt" Foreground="#FECACA" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Name="eyebrowText" Text="NEW CONTACT" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="headerTitleText" Text="Register an emergency contact"
                   Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Category" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="categoryCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
            <CheckBox Name="chkPriority" Content="Priority hotline (pin to top)" Margin="0,0,0,10" FontSize="12" />
            <CheckBox Name="chkActive" Content="Active" IsChecked="True" FontSize="12" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Agency / Organization" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtAgency" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="200" />

        <TextBlock Text="Contact Person" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtPerson" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="150" />

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Primary Phone" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtPhonePrimary" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="50" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Secondary Phone" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtPhoneSecondary" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="50" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Email" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtEmail" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="150" />

        <TextBlock Text="Address" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtAddress" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="300" />

        <TextBlock Text="Notes" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtNotes" Style="{StaticResource StyledTextBoxStyle}" Height="80"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}"
            BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40"
                Margin="0,0,12,0" IsCancel="True" />
        <Button Name="btnSave" Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                Width="140" Height="40" IsDefault="True" Click="BtnSave_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
