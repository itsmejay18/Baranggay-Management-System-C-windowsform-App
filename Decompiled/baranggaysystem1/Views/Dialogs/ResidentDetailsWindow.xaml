<Window x:Class="baranggaysystem1.Views.Dialogs.ResidentDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Width="780" Height="680" MinWidth="600" MinHeight="500" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding Title}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header with Photo -->
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Photo Upload Area -->
        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="#1E3A5F" Margin="0,0,16,0" Cursor="Hand" MouseLeftButtonDown="PhotoArea_Click" ToolTip="Click to upload photo">
          <Grid>
            <Image Name="residentPhoto" Stretch="UniformToFill" Visibility="Collapsed">
              <Image.Clip>
                <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32" />
              </Image.Clip>
            </Image>
            <StackPanel Name="photoPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
              <fa:IconBlock Icon="Camera" FontSize="20" Foreground="#94A3B8" HorizontalAlignment="Center" />
              <TextBlock Text="Photo" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Foreground="#FFFFFFFF" FontFamily="{StaticResource CenturyGothic}" FontSize="16" FontWeight="Bold" Text="{Binding Title}" />
          <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" Text="Fill in resident details across all tabs below." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Tabbed Content -->
    <TabControl Grid.Row="1" Margin="0" Padding="0" BorderThickness="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Padding" Value="14,8" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </TabControl.Resources>

      <!-- Tab 1: Personal Info -->
      <TabItem Header="Personal Info">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="First Name *" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Last Name *" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Middle Name" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Suffix" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <Separator Margin="0,4,0,12" Background="{StaticResource Slate100Brush}" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Gender *" Style="{StaticResource LabelTextStyle}" />
                <ComboBox Style="{StaticResource StyledComboBoxStyle}" Padding="6" ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Gender}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Civil Status" Style="{StaticResource LabelTextStyle}" />
                <ComboBox Style="{StaticResource StyledComboBoxStyle}" Padding="6" ItemsSource="{Binding CivilStatusOptions}" SelectedItem="{Binding CivilStatus}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Birth Date *" Style="{StaticResource LabelTextStyle}" />
                <DatePicker Padding="4" Height="32" SelectedDate="{Binding DateOfBirth}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Nationality" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Nationality, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Religion" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Religion, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Blood Type" Style="{StaticResource LabelTextStyle}" />
                <ComboBox Style="{StaticResource StyledComboBoxStyle}" Padding="6" ItemsSource="{Binding BloodTypeOptions}" SelectedItem="{Binding BloodType}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Occupation" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Occupation, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Educational Attainment" Style="{StaticResource LabelTextStyle}" />
                <ComboBox Style="{StaticResource StyledComboBoxStyle}" Padding="6" ItemsSource="{Binding EducationOptions}" SelectedItem="{Binding EducationalAttainment}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Place of Birth" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding PlaceOfBirth, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Email Address" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 2: Address & Household -->
      <TabItem Header="Address &amp; Household">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Purok / Zone *" Style="{StaticResource LabelTextStyle}" />
                <ComboBox DisplayMemberPath="Name" Style="{StaticResource StyledComboBoxStyle}" Padding="6" ItemsSource="{Binding PurokOptions}" SelectedItem="{Binding SelectedPurok}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Contact Number" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding ContactNo, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="House No." Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding HouseNo, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Street" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <Separator Margin="0,4,0,12" Background="{StaticResource Slate100Brush}" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Date of Residency" Style="{StaticResource LabelTextStyle}" />
                <DatePicker Padding="4" Height="32" SelectedDate="{Binding DateOfResidency}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Household Relationship" Style="{StaticResource LabelTextStyle}" />
                <ComboBox Style="{StaticResource StyledComboBoxStyle}" Padding="6" ItemsSource="{Binding HouseholdRelationshipOptions}" SelectedItem="{Binding HouseholdRelationship}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 3: Government IDs -->
      <TabItem Header="Government IDs">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <StackPanel>
            <TextBlock Text="Government identification numbers for verification and services." Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,16" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="PhilHealth No." Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding PhilHealthNo, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="SSS No." Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding SssNo, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="TIN No." Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding TinNo, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Voter's ID No." Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding VotersIdNo, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 4: Registries -->
      <TabItem Header="Registries">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
          <StackPanel>
            <TextBlock Text="Check all applicable registries for this resident." Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,16" />
            <UniformGrid Columns="2" Margin="0,0,0,8">
              <CheckBox Content="PWD (Person with Disability)" Margin="0,0,0,12" IsChecked="{Binding IsPwd}" />
              <CheckBox Content="Senior Citizen" Margin="0,0,0,12" IsChecked="{Binding IsSenior}" />
              <CheckBox Content="4Ps Beneficiary" Margin="0,0,0,12" IsChecked="{Binding Is4PsBeneficiary}" />
              <CheckBox Content="Registered Voter" Margin="0,0,0,12" IsChecked="{Binding IsRegisteredVoter}" />
              <CheckBox Content="Solo Parent" Margin="0,0,0,12" IsChecked="{Binding IsSoloParent}" />
              <CheckBox Content="Youth (15-30 years old)" Margin="0,0,0,12" IsChecked="{Binding IsYouth}" />
              <CheckBox Content="Indigent" Margin="0,0,0,12" IsChecked="{Binding IsIndigent}" />
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Footer Actions -->
    <Border Grid.Row="2" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
        <Button Content="Save Resident" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
