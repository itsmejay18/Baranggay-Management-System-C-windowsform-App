<Window x:Class="baranggaysystem1.Views.Dialogs.FacilityBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Facility Booking" Width="640" Height="720"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#059669" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="CalendarPlus" Foreground="#A7F3D0" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="NEW BOOKING" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Reserve a barangay facility" Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="System will check for schedule conflicts before saving."
                   Foreground="#D1FAE5" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <TextBlock Text="Facility" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
        <ComboBox Name="facilityCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40"
                  DisplayMemberPath="facility_name" SelectedValuePath="facility_id" />

        <TextBlock Text="Requester Name" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtRequester" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="150" />

        <TextBlock Text="Contact Number" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtContact" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="50" />

        <TextBlock Text="Purpose" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtPurpose" Style="{StaticResource StyledTextBoxStyle}" Height="70"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 Padding="10" MaxLength="300" />

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Start Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Name="dpStart" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Start Time (HH:MM)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtStartTime" Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="08:00" MaxLength="5" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="End Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Name="dpEnd" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="End Time (HH:MM)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtEndTime" Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="17:00" MaxLength="5" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Expected Guests" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtGuests" Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Total Amount (PHP)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtAmount" Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="0.00" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}"
            BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40"
                Margin="0,0,12,0" IsCancel="True" />
        <Button Name="btnSave" Content="Save Booking" Style="{StaticResource PrimaryButtonStyle}"
                Width="160" Height="40" IsDefault="True" Click="BtnSave_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
