<Window x:Class="baranggaysystem1.Views.Dialogs.HouseholdTransferHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Household Transfer History" Width="940" Height="600" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="ExchangeAlt" Foreground="#38BDF8" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Text="HOUSEHOLD TRANSFER HISTORY" Foreground="#BFDBFE" FontSize="13" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="householdTitleText" Text="Household #" Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" />
        <TextBlock Name="historySummaryText" Text="Loading household movement history..." Foreground="#CBD5E1" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Margin="24,20,24,0" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,0,0,1" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Resident Transfer Timeline" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Name="timelineMetaText" Text="Family moves, removals, and reassignment events appear here." Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Grid Row="1">
          <DataGrid Name="historyGrid" Margin="12,10,12,12" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="56" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Resident" Width="1.2*" Binding="{Binding ResidentName}" />
              <DataGridTextColumn Header="Moved From" Width="1.5*" Binding="{Binding OldAddress}" />
              <DataGridTextColumn Header="Moved To" Width="1.5*" Binding="{Binding NewAddress}" />
              <DataGridTextColumn Header="Reason" Width="1.3*" Binding="{Binding Reason}" />
              <DataGridTextColumn Header="Processed By" Width="1.0*" Binding="{Binding TransferredBy}" />
              <DataGridTextColumn Header="Date" Width="1.1*" Binding="{Binding TransferredAt, StringFormat={}{0:MMM dd, yyyy hh:mm tt}}" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Name="emptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="76" Height="76" CornerRadius="24" Background="#F8FAFC" Margin="0,0,0,14">
              <fa:IconBlock Icon="History" FontSize="30" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Name="emptyLabel" Text="No transfer history found for this household." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Transfers recorded from the household tools will appear here." Style="{StaticResource SmallTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Button Content="Close" Width="110" Height="38" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClose_Click" />
    </Border>
  </Grid>
</Window>