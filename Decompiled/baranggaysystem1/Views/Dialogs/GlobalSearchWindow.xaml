<Window x:Class="baranggaysystem1.Views.Dialogs.GlobalSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Global Search" Width="640" Height="500" MinWidth="360" MinHeight="240" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="20,14">
      <TextBlock Text="Global Search" Foreground="#FFFFFFFF" FontFamily="{StaticResource CenturyGothic}" FontSize="16" FontWeight="Bold" />
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
      <StackPanel Name="contentPanel">
        <TextBlock Text="Content for Global Search goes here." Style="{StaticResource SubtitleTextStyle}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Margin="0,0,10,0" />
        <Button Name="btnConfirm" Content="Save" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnConfirm_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>