<Window x:Class="baranggaysystem1.Views.Dialogs.GlobalSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Global Search" Width="680" Height="560" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="True" Background="Transparent" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Border CornerRadius="16" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" Margin="16">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.18" Direction="270" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Search Input -->
      <Border Grid.Row="0" Padding="20,18,20,0">
        <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" Height="44">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="16" Foreground="{StaticResource Slate400Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="14" Padding="0,0,12,0" TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="2" Content="ESC" Style="{StaticResource GhostButtonStyle}" Height="28" MinWidth="40" Padding="8,0" FontSize="10" Foreground="{StaticResource Slate400Brush}" Margin="0,0,8,0" Click="BtnClose_Click" />
          </Grid>
        </Border>
      </Border>

      <!-- Module Filter Tabs -->
      <Border Grid.Row="1" Padding="20,12,20,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton Name="filterAll" Content="All" GroupName="SearchFilter" IsChecked="True" Style="{StaticResource RibbonRadioTabStyle}" Checked="FilterTab_Checked" />
          <RadioButton Name="filterResidents" Content="Residents" GroupName="SearchFilter" Style="{StaticResource RibbonRadioTabStyle}" Checked="FilterTab_Checked" />
          <RadioButton Name="filterClearances" Content="Clearances" GroupName="SearchFilter" Style="{StaticResource RibbonRadioTabStyle}" Checked="FilterTab_Checked" />
          <RadioButton Name="filterBlotter" Content="Blotter" GroupName="SearchFilter" Style="{StaticResource RibbonRadioTabStyle}" Checked="FilterTab_Checked" />
          <RadioButton Name="filterPayments" Content="Payments" GroupName="SearchFilter" Style="{StaticResource RibbonRadioTabStyle}" Checked="FilterTab_Checked" />
        </StackPanel>
      </Border>

      <!-- Results List -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,12,20,0">
        <StackPanel Name="resultsPanel">
          <StackPanel Name="emptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
            <fa:IconBlock Icon="Search" FontSize="40" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="Type to search across all modules" Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Search residents, clearances, blotter cases, and payments" Style="{StaticResource SmallTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="3" Padding="20,12" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,1,0,0">
        <Grid>
          <TextBlock Name="resultCountLabel" Text="Type at least 2 characters to search" Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="↑↓ Navigate" Style="{StaticResource SmallTextStyle}" Margin="0,0,12,0" />
            <TextBlock Text="Enter Open" Style="{StaticResource SmallTextStyle}" Margin="0,0,12,0" />
            <TextBlock Text="Esc Close" Style="{StaticResource SmallTextStyle}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
