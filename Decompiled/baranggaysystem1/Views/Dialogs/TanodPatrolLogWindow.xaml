<Window x:Class="baranggaysystem1.Views.Dialogs.TanodPatrolLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Patrol Log" Width="580" Height="640"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#DC2626" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="ClipboardList" Foreground="#FECACA" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="NEW LOG ENTRY" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Record a patrol observation or incident" Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Location" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtLocation" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="200" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Incident Type" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtIncident" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="60" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Severity" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <ComboBox Name="severityCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />

        <TextBlock Text="Description" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtDescription" Style="{StaticResource StyledTextBoxStyle}" Height="120"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />

        <TextBlock Text="Action Taken" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtAction" Style="{StaticResource StyledTextBoxStyle}" Height="80"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />

        <TextBlock Text="Reported By" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtReporter" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="150" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}"
            BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40"
                Margin="0,0,12,0" IsCancel="True" />
        <Button Name="btnSave" Content="Save Log" Style="{StaticResource PrimaryButtonStyle}"
                Width="140" Height="40" IsDefault="True" Click="BtnSave_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
