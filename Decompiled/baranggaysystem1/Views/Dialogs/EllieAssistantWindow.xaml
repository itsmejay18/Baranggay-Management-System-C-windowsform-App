<Window x:Class="baranggaysystem1.Views.Dialogs.EllieAssistantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ellie AI Assistant" Width="560" Height="520" MinWidth="400" MinHeight="300" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="16,10">
      <StackPanel>
        <TextBlock Text="Ellie — Barangay AI Assistant" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold" />
        <TextBlock Text="Ask questions about residents, cases, certificates, or system data." Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Name="chatScroller" VerticalScrollBarVisibility="Auto" Padding="16,12">
      <StackPanel Name="chatPanel">
        <Border Background="#F0F9FF" CornerRadius="8" Padding="12,10" Margin="0,0,40,8">
          <TextBlock Text="Hi! I'm Ellie, your barangay assistant. Ask me anything about your data — resident counts, pending cases, certificate stats, or general questions." TextWrapping="Wrap" FontSize="12" Foreground="#1E40AF" />
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,1,0,0" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Name="txtQuestion" Grid.Column="0" Height="34" VerticalContentAlignment="Center" FontSize="12" Padding="10,0" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" Background="#FFFFFF" KeyDown="TxtQuestion_KeyDown" />
        <Button Name="btnSend" Grid.Column="1" Content="Send" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="16,0" Margin="8,0,0,0" Click="BtnSend_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
