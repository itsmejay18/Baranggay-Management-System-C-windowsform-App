<Window x:Class="baranggaysystem1.Views.Dialogs.HouseholdCertificateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Household Certificate" Width="700" Height="560" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="46" Height="46" CornerRadius="12" Background="#DBEAFE" Margin="0,0,14,0">
            <fa:IconBlock Icon="FileSignature" Foreground="#2563EB" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Household Certificate" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Text="Generate a printable PDF certification for the selected household." Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center" Background="#E0F2FE" Padding="12,7" CornerRadius="999">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="FilePdf" Foreground="#0369A1" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="PDF export" FontSize="11" FontWeight="Bold" Foreground="#075985" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,16,20,16">
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" Text="{Binding HouseholdLabel}" />
            <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding HouseholdAddress}" />
            <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" Text="{Binding PurokLabel, StringFormat=Purok: {0}}" />
            <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" Text="{Binding MemberSummary}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="Certificate Details" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Text="The generated PDF will be saved in your Documents folder under Barangay Management System." Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,14" />
            <TextBlock Text="Purpose" Style="{StaticResource LabelTextStyle}" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="180" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Presented to" Style="{StaticResource LabelTextStyle}" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding PresentedTo, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Issued date" Style="{StaticResource LabelTextStyle}" />
                <DatePicker Height="40" SelectedDate="{Binding IssuedDate}" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Include household member roster in the certificate" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{StaticResource Slate800Brush}" IsChecked="{Binding IncludeMemberRoster}" />
            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="InfoCircle" Foreground="#C2410C" FontSize="14" Margin="0,2,10,0" />
                <TextBlock Width="520" Text="This generates a printable household certification PDF. It does not create a resident clearance request in the service queue." TextWrapping="Wrap" Style="{StaticResource SmallTextStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="20,16">
      <Grid>
        <TextBlock Text="The PDF opens automatically after generation when supported by Windows." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="38" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
          <Button Content="Generate PDF" Style="{StaticResource PrimaryButtonStyle}" Width="140" Height="38" Command="{Binding GenerateCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center">
        <fa:IconBlock Icon="Spinner" FontSize="40" Foreground="{StaticResource Slate600Brush}" HorizontalAlignment="Center">
          <UIElement.RenderTransform>
            <RotateTransform CenterX="20" CenterY="20" />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </fa:IconBlock>
        <TextBlock Text="Generating household certificate..." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>