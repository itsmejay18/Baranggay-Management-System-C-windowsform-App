<Window x:Class="baranggaysystem1.Views.Dialogs.HouseholdTransferWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Transfer Family" Width="720" Height="540" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="46" Height="46" CornerRadius="12" Background="#FEF3C7" Margin="0,0,14,0">
            <fa:IconBlock Icon="PeopleArrows" Foreground="#D97706" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Transfer Family" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Text="Move all members from the selected household into another empty household." Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center" Background="#ECFCCB" Padding="12,7" CornerRadius="999">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="CheckCircle" Foreground="#3F6212" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Safe empty-household transfer" FontSize="11" FontWeight="Bold" Foreground="#365314" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,16,20,16">
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Source Household" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" Margin="0,10,0,0" Text="{Binding SourceHouseholdLabel}" />
            <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,3,0,0" Text="{Binding SourcePurokLabel, StringFormat=Purok: {0}}" />
            <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,12,0,0" Text="{Binding MemberCount, StringFormat=Members to move: {0}}" />
            <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding MembersPreview}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="Destination Household" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,14" Text="{Binding DestinationHint}" />
            <TextBlock Text="Move family to" Style="{StaticResource LabelTextStyle}" />
            <ComboBox DisplayMemberPath="AddressLabel" Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding DestinationHouseholds}" SelectedItem="{Binding SelectedDestination}" />
            <TextBlock Text="Transfer note" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,0" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding TransferReason, UpdateSourceTrigger=PropertyChanged}" />
            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="InfoCircle" Foreground="#C2410C" FontSize="14" Margin="0,2,10,0" />
                <TextBlock Width="560" Text="The destination must be empty. After transfer, the original household stays in the registry and can be reused or deleted later." TextWrapping="Wrap" Style="{StaticResource SmallTextStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="20,16">
      <Grid>
        <TextBlock Text="Transfers use the same resident movement audit trail." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="38" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
          <Button Content="Transfer Family" Style="{StaticResource PrimaryButtonStyle}" Width="150" Height="38" Command="{Binding TransferCommand}" IsEnabled="{Binding CanTransfer}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>