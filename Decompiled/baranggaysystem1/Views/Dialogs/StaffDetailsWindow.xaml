<Window x:Class="baranggaysystem1.Views.Dialogs.StaffDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="500" Height="580" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding Title}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="20,14">
      <TextBlock Foreground="#FFFFFFFF" FontFamily="{StaticResource CenturyGothic}" FontSize="16" FontWeight="Bold" Text="{Binding Title}" />
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
      <StackPanel>
        <TextBlock Text="System Credentials" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,12" />
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Username (Login ID)" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewUser}" />
        </StackPanel>
        <ContentControl Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Initial Temporary Password" Style="{StaticResource SmallTextStyle}" />
              <TextBox IsReadOnly="True" Background="#00FFFFFF" BorderThickness="0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding TemporaryPassword}" />
              <TextBlock Text="The user must change this on first login." Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}" />
            </StackPanel>
          </Border>
        </ContentControl>
        <Separator Margin="0,4,0,16" Background="{StaticResource Slate100Brush}" />
        <TextBlock Text="Personal Details" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,12" />
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="First Name" Style="{StaticResource LabelTextStyle}" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Last Name" Style="{StaticResource LabelTextStyle}" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Middle Name" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Email Address" Style="{StaticResource LabelTextStyle}" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Contact Number" Style="{StaticResource LabelTextStyle}" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <Separator Margin="0,4,0,16" Background="{StaticResource Slate100Brush}" />
        <TextBlock Text="Organizational Role" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,12" />
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Position" Style="{StaticResource LabelTextStyle}" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Department" Style="{StaticResource LabelTextStyle}" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="System Role" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Style="{StaticResource StyledComboBoxStyle}" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding RoleName}" />
        </StackPanel>
        <CheckBox Content="Account is Active (can login)" Margin="0,8,0,0" IsChecked="{Binding IsActive}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
        <Button Content="Save Staff Profile" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>