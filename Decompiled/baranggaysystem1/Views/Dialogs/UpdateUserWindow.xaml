<Window x:Class="baranggaysystem1.Views.Dialogs.UpdateUserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Update User Password" Width="400" Height="400" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="20,14">
      <TextBlock Text="Update System Password" Foreground="#FFFFFFFF" FontFamily="{StaticResource CenturyGothic}" FontSize="16" FontWeight="Bold" />
    </Border>
    <StackPanel Grid.Row="1" Margin="20,24">
      <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,24" Text="{Binding TargetUsername, StringFormat=Modifying credentials for {0}}" />
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="New Password" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="Confirm Password" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <CheckBox Content="Require user to change password on next login" Margin="0,8,0,0" IsChecked="{Binding RequirePasswordChange}" />
    </StackPanel>
    <Border Grid.Row="2" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
        <Button Content="Update Password" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding UpdatePasswordCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>