<Window x:Class="baranggaysystem1.Views.Dialogs.InventoryItemWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Inventory Item" Width="580" Height="720" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0F766E" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="BoxOpen" Foreground="#99F6E4" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Name="windowEyebrowText" Text="NEW INVENTORY ITEM" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="windowTitleText" Text="Add inventory stock item" Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" />
        <TextBlock Text="Track stock levels, reorder thresholds, and storage details for supplies held by the barangay." Foreground="#CCFBF1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <TextBlock Text="Item Name" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
        <TextBox Name="itemNameTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Category" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="categoryComboBox" IsEditable="True" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Unit" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="unitComboBox" IsEditable="True" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Quantity On Hand" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="quantityTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,10,0">
            <TextBlock Text="Reorder Level" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="reorderLevelTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="10,0,0,0">
            <TextBlock Text="Unit Cost (PHP)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="unitCostTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Storage Location" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="locationTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Record Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="statusComboBox" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Last Restocked" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <DatePicker Name="lastRestockedDatePicker" Height="40" />
        <TextBlock Text="Notes" Style="{StaticResource LabelTextStyle}" Margin="0,20,0,8" />
        <TextBox Name="notesTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />
        <Border Margin="0,24,0,0" Padding="16" Background="#CCFBF1" CornerRadius="8" BorderBrush="#5EEAD4" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="ClipboardCheck" Foreground="#0F766E" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="Set a realistic reorder level so the finance workspace can highlight low-stock items before they run out." Foreground="#115E59" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40" Margin="0,0,12,0" IsCancel="True" />
        <Button Name="saveButton" Content="Save Item" Style="{StaticResource PrimaryButtonStyle}" Width="150" Height="40" Click="SaveButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>