<Window x:Class="baranggaysystem1.Views.Dialogs.TanodShiftAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Shift Attendance" Width="720" Height="540"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#DC2626" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="UserCheck" Foreground="#FECACA" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="SHIFT ATTENDANCE" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="headerTitle" Text="Roll call for patrol shift"
                   Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" />
        <TextBlock Name="headerSubtitle" Text="" Foreground="#FECACA" FontSize="12" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFFFF" Margin="20,20,20,0" CornerRadius="10"
            BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1">
      <Grid>
        <DataGrid Name="assignmentsGrid" Style="{StaticResource StyledDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}"
                  RowStyle="{StaticResource StyledDataGridRowStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="AssignmentsGrid_SelectionChanged" />
        <TextBlock Name="emptyLabel" Text="No members assigned to this shift."
                   Foreground="{StaticResource Slate400Brush}" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}"
            BorderThickness="0,1,0,0" Padding="20,16" Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Mark selected as:" FontWeight="SemiBold"
                     Foreground="{StaticResource Slate700Brush}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Name="btnPresent" Content="Present" Style="{StaticResource ContextualActionButtonStyle}"
                  Margin="0,0,8,0" Click="BtnMarkPresent_Click" />
          <Button Name="btnLate" Content="Late" Style="{StaticResource ActionButtonStyle}"
                  Margin="0,0,8,0" Click="BtnMarkLate_Click" />
          <Button Name="btnAbsent" Content="Absent" Style="{StaticResource ActionButtonStyle}"
                  Click="BtnMarkAbsent_Click" />
        </StackPanel>
        <Button Grid.Column="1" Content="Close" Style="{StaticResource SecondaryButtonStyle}"
                Width="100" Height="40" IsCancel="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
