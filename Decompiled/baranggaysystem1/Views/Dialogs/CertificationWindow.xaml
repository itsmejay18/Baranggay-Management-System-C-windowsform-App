<Window x:Class="baranggaysystem1.Views.Dialogs.CertificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Width="640" Height="720" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding WindowTitle}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="FileSignature" Foreground="#F59E0B" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" Text="{Binding HeaderEyebrow}" />
        </StackPanel>
        <TextBlock Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" Text="{Binding ResidentName, TargetNullValue=Select Resident}" />
        <TextBlock Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding HelperText}" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <Border Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16" Visibility="{Binding ShowResidentPicker, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Resident" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox DisplayMemberPath="DisplayName" Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding ResidentOptions}" SelectedItem="{Binding SelectedResident}" />
          </StackPanel>
        </Border>
        <Border Margin="0,-8,0,12" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="10" Padding="12,10" Visibility="{Binding ShowResidentPicker, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <fa:IconBlock Icon="InfoCircle" Foreground="#B45309" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Choose the resident first so the request is linked to a real household record." Foreground="#92400E" FontSize="12" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
        <Border Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Document Details" Style="{StaticResource HeadingTextStyle}" FontSize="18" />
              <Border Grid.Column="1" Background="#E0F2FE" Padding="10,5" CornerRadius="999">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="ClipboardCheck" Foreground="#0369A1" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Foreground="#075985" FontWeight="Bold" FontSize="11" Text="{Binding WindowTitle}" />
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="Document Type" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
            <ComboBox DisplayMemberPath="Name" Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding CertificationTypes}" SelectedItem="{Binding SelectedType}" />
            <TextBlock Text="Purpose" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="84" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" />
            <Border Margin="0,16,0,0" Background="#F8FAFC" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Padding="14" Visibility="{Binding IsBusinessType, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="Business Details" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Business Name" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Business Nature" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding BusinessNature, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Processing Fee (PHP)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding Fee, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="O.R. Number" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="{Binding OrNumber, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,16,0,0" Visibility="{Binding ShowPaymentFields, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Payment Method" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                <ComboBox Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Issue Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                <DatePicker Height="40" SelectedDate="{Binding IssuedDate}" />
              </StackPanel>
            </Grid>
            <Border Margin="0,18,0,0" Padding="14" Background="#EFF6FF" CornerRadius="10" BorderBrush="#DBEAFE" BorderThickness="1">
              <DockPanel>
                <fa:IconBlock Icon="InfoCircle" Foreground="#2563EB" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Released certificates automatically store the document number, verification token, and expiry when the document type has a validity period." Foreground="#1D4ED8" FontSize="12" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="110" Height="40" Margin="0,0,12,0" IsCancel="True" />
          <Button Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="40" Content="{Binding ActionButtonText}" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center">
        <fa:IconBlock Icon="Spinner" FontSize="40" Foreground="{StaticResource Slate600Brush}" HorizontalAlignment="Center">
          <UIElement.RenderTransform>
            <RotateTransform CenterX="20" CenterY="20" />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </fa:IconBlock>
        <TextBlock Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" Text="{Binding LoadingMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>