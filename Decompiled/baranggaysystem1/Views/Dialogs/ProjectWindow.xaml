<Window x:Class="baranggaysystem1.Views.Dialogs.ProjectWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Project / Program" Width="620" Height="820" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0F766E" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="Tasks" Foreground="#99F6E4" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Name="eyebrowText" Text="NEW RECORD" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="headerTitleText" Text="Track a barangay project or program" Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" />
        <TextBlock Name="headerSubtitleText" Text="Store scope, attendance, and outcome details so the dashboard reflects real field work and community programs." Foreground="#CCFBF1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Record Type" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="typeCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Delivery Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="statusCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Project / Program Name" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <TextBox Name="txtName" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="150" />
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Budget (PHP)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtBudget" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Outcome Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="outcomeStatusCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Start Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Name="startDatePicker" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="End Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Name="endDatePicker" Height="40" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Project Lead / Owner" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <TextBox Name="txtLead" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="100" />
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Target Attendance" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtAttendanceTarget" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Actual Attendance" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtAttendanceCount" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Latest Activity / Outcome Date" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <DatePicker Name="activityDatePicker" Height="40" />
        <TextBlock Text="Outcome Summary" Style="{StaticResource LabelTextStyle}" Margin="0,20,0,8" />
        <TextBox Name="txtOutcomeSummary" Style="{StaticResource StyledTextBoxStyle}" Height="150" MaxLength="4000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />
        <TextBlock Text="Scope / Delivery Notes" Style="{StaticResource LabelTextStyle}" Margin="0,20,0,8" />
        <TextBox Name="txtRemarks" Style="{StaticResource StyledTextBoxStyle}" Height="180" MaxLength="4000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />
        <Border Margin="0,20,0,0" Padding="14" Background="#ECFEFF" CornerRadius="10" BorderBrush="#A5F3FC" BorderThickness="1">
          <DockPanel>
            <fa:IconBlock Icon="InfoCircle" Foreground="#0F766E" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Use the same record for projects or programs, then keep attendance, latest activity, and outcome details current so the dashboard reflects operational follow-through." Foreground="#115E59" FontSize="12" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40" Margin="0,0,12,0" IsCancel="True" />
        <Button Name="btnConfirm" Content="Save Record" Style="{StaticResource PrimaryButtonStyle}" Width="170" Height="40" IsDefault="True" Click="BtnConfirm_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>