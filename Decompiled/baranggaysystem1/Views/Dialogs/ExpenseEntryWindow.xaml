<Window x:Class="baranggaysystem1.Views.Dialogs.ExpenseEntryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Expense Entry" Width="560" Height="690" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#B45309" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="MoneyBillWave" Foreground="#FDE68A" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Name="windowEyebrowText" Text="NEW EXPENSE ENTRY" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="windowTitleText" Text="Record a barangay expense" Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" />
        <TextBlock Text="Capture expense details, amount, and reference information so the finance ledger stays audit-ready." Foreground="#FEF3C7" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Expense Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Name="expenseDatePicker" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Expense Category" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="categoryComboBox" IsEditable="True" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Expense Title" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <TextBox Name="titleTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
        <TextBlock Text="Payee / Vendor" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <TextBox Name="payeeTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Amount (PHP)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="amountTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" FontSize="18" FontWeight="Bold" Foreground="#92400E" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Payment Method" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="paymentMethodComboBox" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Ledger Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="statusComboBox" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Reference No." Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="referenceTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Notes" Style="{StaticResource LabelTextStyle}" Margin="0,20,0,8" />
        <TextBox Name="notesTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />
        <Border Margin="0,24,0,0" Padding="16" Background="#FEF3C7" CornerRadius="8" BorderBrush="#FCD34D" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="InfoCircle" Foreground="#B45309" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="Use posted for completed disbursements and pending for obligations that still need settlement or reimbursement." Foreground="#92400E" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40" Margin="0,0,12,0" IsCancel="True" />
        <Button Name="saveButton" Content="Save Expense" Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="40" Click="SaveButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>