<Window x:Class="baranggaysystem1.Views.Dialogs.DocumentVerificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Document Verification" Width="900" Height="680" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="24,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <fa:IconBlock Icon="ShieldAlt" Foreground="#F59E0B" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="DOCUMENT VERIFICATION" Foreground="#FDE68A" FontSize="13" FontWeight="Black" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Verification And QR Lookup" Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" />
          <TextBlock Text="Search by tracking code, document number, verification token, or QR payload." Foreground="#CBD5E1" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Border Name="verificationStateBadge" Grid.Column="1" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999" Padding="12,6" VerticalAlignment="Top">
          <TextBlock Name="verificationStateText" Text="Awaiting Lookup" Foreground="#475569" FontSize="11" FontWeight="Bold" />
        </Border>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20,24,24">
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="Verification Lookup" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Text="Released documents keep a verification token and can generate a QR payload for internal validation." Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Name="lookupBox" Grid.Column="0" Style="{StaticResource StyledTextBoxStyle}" Height="40" VerticalContentAlignment="Center" KeyDown="LookupBox_KeyDown" />
              <Button Grid.Column="2" Content="Verify" Width="116" Height="40" Style="{StaticResource PrimaryButtonStyle}" Click="BtnVerify_Click" />
            </Grid>
            <TextBlock Name="lookupHintText" Text="Paste the QR payload or enter the exact tracking code, document number, or verification token." Style="{StaticResource SmallTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Name="resultCard" Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Name="resultSummaryText" Text="Verification details will appear here." Style="{StaticResource SubtitleTextStyle}" FontWeight="Bold" />
            <TextBlock Name="resultMetaText" Text="Lookup metadata" Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="0.95*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <UniformGrid Columns="2" Margin="0,0,0,14">
                  <StackPanel Margin="0,0,12,12">
                    <TextBlock Text="Tracking Code" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Name="trackingCodeText" Text="-" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Document Number" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Name="documentNumberText" Text="-" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,12">
                    <TextBlock Text="Resident" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Name="residentNameText" Text="-" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Document Type" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Name="documentTypeText" Text="-" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,12">
                    <TextBlock Text="Released On" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Name="releasedOnText" Text="-" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Expires On" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Name="expiresOnText" Text="-" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,12">
                    <TextBlock Text="Verification Token" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Name="verificationTokenText" Text="-" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="OR / Fee" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Name="paymentMetaText" Text="-" Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="Purpose" Style="{StaticResource LabelTextStyle}" />
                <Border Margin="0,6,0,0" Background="#F8FAFC" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="12" Padding="12">
                  <TextBlock Name="purposeText" Text="-" Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Verification Payload" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,0" />
                <Border Margin="0,6,0,0" Background="#F8FAFC" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="12" Padding="12">
                  <TextBlock Name="payloadText" Text="-" Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
              <Border Grid.Column="2" Background="#FCFDFE" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="18" Padding="16">
                <StackPanel>
                  <TextBlock Text="Verification QR" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" />
                  <TextBlock Name="qrHelpText" Text="Released records with tokens generate a QR payload for desktop verification." Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <Border Margin="0,16,0,0" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="16" Padding="14">
                    <Grid>
                      <Image Name="qrImage" Width="220" Height="220" Stretch="Uniform" />
                      <TextBlock Name="qrEmptyText" Text="QR becomes available once a verification token exists." Style="{StaticResource SmallTextStyle}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="180" />
                    </Grid>
                  </Border>
                  <Border Margin="0,14,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="12">
                    <TextBlock Name="stateSummaryText" Text="Verification result summary" Style="{StaticResource SmallTextStyle}" Foreground="#1D4ED8" FontWeight="Bold" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>
        <StackPanel Name="emptyState" Visibility="Visible" Margin="0,4,0,0" HorizontalAlignment="Center">
          <Border Width="82" Height="82" CornerRadius="26" Background="#F8FAFC" Margin="0,0,0,14">
            <fa:IconBlock Icon="Search" FontSize="30" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Name="emptyTitleText" Text="Run a document lookup to start verification." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
          <TextBlock Name="emptyMetaText" Text="The lookup supports queue tracking codes, document numbers, verification tokens, and the QR payload generated by this system." Style="{StaticResource SmallTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="540" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Column="0">
          <Button Name="btnCopyToken" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Padding="12,0" Height="36" IsEnabled="False" Click="BtnCopyToken_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Copy" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Copy Token" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="btnCopyPayload" Style="{StaticResource SecondaryButtonStyle}" Padding="12,0" Height="36" IsEnabled="False" Click="BtnCopyPayload_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Qrcode" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Copy QR Payload" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
        <Button Grid.Column="1" Content="Close" Width="110" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClose_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>