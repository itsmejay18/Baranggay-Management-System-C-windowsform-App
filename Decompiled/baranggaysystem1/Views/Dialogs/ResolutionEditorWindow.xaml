<Window x:Class="baranggaysystem1.Views.Dialogs.ResolutionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Resolution" Width="700" Height="760"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#7C3AED" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="FileContract" Foreground="#DDD6FE" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Name="eyebrowText" Text="NEW RESOLUTION" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="headerTitleText" Text="Draft a resolution or ordinance"
                   Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Keep a permanent record of legislative documents with their effectivity and approval status."
                   Foreground="#EDE9FE" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,6,0">
            <TextBlock Text="Document Type" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="typeCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,6,0">
            <TextBlock Text="Document Number" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtNumber" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="50" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="6,0,0,0">
            <TextBlock Text="Series Year" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtYear" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="4" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Title" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtTitle" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="300" />

        <TextBlock Text="Short Description" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtDescription" Style="{StaticResource StyledTextBoxStyle}" Height="70"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />

        <TextBlock Text="Full Text / Body" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtFullText" Style="{StaticResource StyledTextBoxStyle}" Height="220"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,6,0">
            <TextBlock Text="Effectivity Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Name="dpEffectivity" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,6,0">
            <TextBlock Text="Authored By" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtAuthor" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="150" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="6,0,0,0">
            <TextBlock Text="Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="statusCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}"
            BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40"
                Margin="0,0,12,0" IsCancel="True" />
        <Button Name="btnSave" Content="Save Resolution" Style="{StaticResource PrimaryButtonStyle}"
                Width="160" Height="40" IsDefault="True" Click="BtnSave_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
