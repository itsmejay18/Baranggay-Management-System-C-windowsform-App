<Window x:Class="baranggaysystem1.Views.Dialogs.TanodMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Tanod Member" Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#DC2626" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="UserShield" Foreground="#FECACA" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="NEW TANOD" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Register a tanod member" Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <TextBlock Text="Full Name" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
        <TextBox Name="txtFullName" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="150" />

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Rank / Position" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtRank" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="50" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Contact Number" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtContact" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="50" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Date Assigned" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <DatePicker Name="dpAssigned" Height="40" />

        <TextBlock Text="Remarks" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtRemarks" Style="{StaticResource StyledTextBoxStyle}" Height="100"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 Padding="10" MaxLength="255" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}"
            BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40"
                Margin="0,0,12,0" IsCancel="True" />
        <Button Name="btnSave" Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                Width="140" Height="40" IsDefault="True" Click="BtnSave_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
