<Window x:Class="baranggaysystem1.Views.Dialogs.AyudaProgramWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Width="560" Height="700" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding WindowTitle}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1D4ED8" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="Wallet" Foreground="#BFDBFE" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Foreground="#FFFFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" Text="{Binding HeaderEyebrowText}" />
        </StackPanel>
        <TextBlock Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" Text="{Binding HeaderTitleText}" />
        <TextBlock Foreground="#DBEAFE" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding HeaderDescriptionText}" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <TextBlock Text="Program Name" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" Margin="0,0,0,18" Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Category" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox IsEditable="True" Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Program Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Allocated Budget (PHP)" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" Text="{Binding AllocatedBudget, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Start Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Height="40" SelectedDate="{Binding StartDate}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="End Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Height="40" SelectedDate="{Binding EndDate}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Program Notes" Style="{StaticResource LabelTextStyle}" Margin="0,20,0,8" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="88" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
        <Border Margin="0,24,0,0" Padding="16" Background="#DBEAFE" CornerRadius="8" BorderBrush="#BFDBFE" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="InfoCircle" Foreground="#1D4ED8" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="Programs stay in the Ayuda module and their remaining budget updates automatically as releases are recorded." Foreground="#1E3A8A" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40" Margin="0,0,12,0" IsCancel="True" />
        <Button Style="{StaticResource PrimaryButtonStyle}" Width="190" Height="40" Content="{Binding SaveButtonText}" Command="{Binding SaveProgramCommand}" />
      </StackPanel>
    </Border>
    <Border Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center">
        <fa:IconBlock Icon="Spinner" FontSize="40" Foreground="#1D4ED8" HorizontalAlignment="Center">
          <UIElement.RenderTransform>
            <RotateTransform CenterX="20" CenterY="20" />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </fa:IconBlock>
        <TextBlock Text="Saving ayuda program..." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>