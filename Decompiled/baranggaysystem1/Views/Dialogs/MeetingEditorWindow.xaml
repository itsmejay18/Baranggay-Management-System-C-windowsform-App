<Window x:Class="baranggaysystem1.Views.Dialogs.MeetingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Meeting" Width="640" Height="720"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource Slate50Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#4F46E5" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="Landmark" Foreground="#C7D2FE" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Name="eyebrowText" Text="NEW MEETING" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="headerTitleText" Text="Schedule a barangay meeting"
                   Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Capture the agenda, venue, and time. Record minutes and attendance after the session."
                   Foreground="#E0E7FF" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <TextBlock Text="Meeting Title" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
        <TextBox Name="txtTitle" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="200" />

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Meeting Type" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="typeCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="statusCombo" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <DatePicker Name="dpDate" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Time (HH:MM, 24-hour)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtTime" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="5" Text="09:00" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Venue" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtVenue" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="200" />

        <TextBlock Text="Agenda" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtAgenda" Style="{StaticResource StyledTextBoxStyle}" Height="100"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />

        <TextBlock Text="Minutes / Summary" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,8" />
        <TextBox Name="txtMinutes" Style="{StaticResource StyledTextBoxStyle}" Height="120"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Attendance Count" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Name="txtAttendance" Style="{StaticResource StyledTextBoxStyle}" Height="40" Text="0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
            <CheckBox Name="chkQuorum" Content="Quorum reached" Margin="0,0,0,10" FontSize="12" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}"
            BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40"
                Margin="0,0,12,0" IsCancel="True" />
        <Button Name="btnSave" Content="Save Meeting" Style="{StaticResource PrimaryButtonStyle}"
                Width="160" Height="40" IsDefault="True" Click="BtnSave_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
