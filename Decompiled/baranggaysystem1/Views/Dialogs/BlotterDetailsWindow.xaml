<Window x:Class="baranggaysystem1.Views.Dialogs.BlotterDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Width="1440" Height="920" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" WindowState="Maximized" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding Title}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="BlotterCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="Border.Padding" Value="14" />
      </Style>
      <Style x:Key="BlotterSectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Slate800Brush}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="22,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="42" Height="42" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center">
            <fa:IconBlock Icon="Gavel" Foreground="#FBBF24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Foreground="#FFFFFFFF" FontFamily="{StaticResource CenturyGothic}" FontSize="22" FontWeight="Bold" Text="{Binding Title}" />
            <TextBlock Foreground="#CBD5E1" Margin="0,4,0,0" FontSize="12" Text="{Binding CaseCaption}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="18" Padding="14,6" VerticalAlignment="Center">
          <TextBlock Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="12" Text="{Binding CurrentStatus}" />
        </Border>
      </Grid>
    </Border>
    <TabControl Grid.Row="1" Margin="18,14,18,0" Background="#00FFFFFF" BorderThickness="0">
      <TabItem Header="Details">
        <Grid Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource BlotterCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Complainant" Style="{StaticResource BlotterSectionTitleStyle}" />
              <Grid Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource StyledTextBoxStyle}" Height="34" FontSize="12" Text="{Binding ComplainantSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="Find Resident" Style="{StaticResource SecondaryButtonStyle}" Height="34" Command="{Binding SearchComplainantsCommand}" />
              </Grid>
              <Border Grid.Row="2" Margin="0,10,0,0" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                  <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate800Brush}" Text="{Binding ComplainantDisplayName}" />
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Slate600Brush}" FontSize="12" Text="{Binding ComplainantAddress}" />
                  <TextBlock Margin="0,6,0,0" Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}" Text="{Binding ComplainantSummary}" />
                </StackPanel>
              </Border>
              <TextBlock Grid.Row="3" Text="Residents" Style="{StaticResource LabelTextStyle}" Margin="0,10,0,6" />
              <ListBox Grid.Row="4" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" Background="#FFFFFFFF" HorizontalContentAlignment="Stretch" ItemsSource="{Binding ResidentSearchResults}" SelectedItem="{Binding SelectedComplainantResult}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,0,0,1" Padding="10,8">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Slate800Brush}" FontSize="12" Text="{Binding FullName}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" Foreground="{StaticResource Slate600Brush}" Text="{Binding Address}" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}">
                          <Run Text="Resident ID: " /> <Run Text="{Binding ResidentId}" /> <Run Text=" | Contact: " /> <Run Text="{Binding ContactNo}" /></TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <Grid Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="176" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource BlotterCardStyle}">
              <StackPanel>
                <TextBlock Text="Case" Style="{StaticResource BlotterSectionTitleStyle}" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Respondent" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="34" FontSize="12" Text="{Binding RespondentName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Resident ID" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="34" FontSize="12" Text="{Binding RespondentResidentIdText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Status" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox Style="{StaticResource StyledComboBoxStyle}" Height="34" Padding="4" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding CurrentStatus}" IsEnabled="{Binding IsExistingRecord}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Type" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox Style="{StaticResource StyledComboBoxStyle}" Height="34" Padding="4" ItemsSource="{Binding IncidentTypes}" SelectedItem="{Binding IncidentType}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Date" Style="{StaticResource LabelTextStyle}" />
                    <DatePicker Height="34" Padding="4" SelectedDate="{Binding IncidentDate}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Time" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="34" FontSize="12" Text="{Binding IncidentTimeText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Location" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="34" FontSize="12" Text="{Binding IncidentLocation, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Referral" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="34" FontSize="12" Text="{Binding ReferralDestination, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsExistingRecord}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource BlotterCardStyle}" Margin="0,12,0,12">
              <StackPanel>
                <TextBlock Text="Narrative" Style="{StaticResource BlotterSectionTitleStyle}" />
                <TextBox Margin="0,10,0,0" Style="{StaticResource StyledTextBoxStyle}" Height="124" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Text="{Binding IncidentDetails, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource BlotterCardStyle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="10" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Follow-up" Style="{StaticResource BlotterSectionTitleStyle}" />
                <Grid Row="1" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Witnesses" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="60" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding Witnesses, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Action Taken" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="60" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding ActionTaken, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Grid Row="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Resolution" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="60" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding ResolutionDetails, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Closure Notes" Style="{StaticResource LabelTextStyle}" />
                    <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="60" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding ClosureNotes, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="AI Review">
        <Grid Margin="20,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="AI Review" Style="{StaticResource BlotterSectionTitleStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Run AI Analysis" Style="{StaticResource PrimaryButtonStyle}" Height="36" MinWidth="150" Command="{Binding RunAiAnalysisCommand}" IsEnabled="{Binding IsAiBusy, Converter={StaticResource InverseBooleanConverter}}" />
          </Grid>
          <Grid Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="Risk Level" Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}" />
                <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding AiRiskLevel}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="Category" Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}" />
                <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding AiCategory}" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource BlotterCardStyle}">
            <StackPanel>
              <TextBlock Text="Summary" Style="{StaticResource BlotterSectionTitleStyle}" />
              <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Slate700Brush}" FontSize="13" Text="{Binding AiSummary}" />
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Timeline">
        <Grid Margin="20,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Timeline" Style="{StaticResource BlotterSectionTitleStyle}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Text="{Binding CurrentStatus}" />
            </Border>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource BlotterCardStyle}" Margin="0,14,0,14">
            <StackPanel>
              <TextBlock Text="Mediation" Style="{StaticResource BlotterSectionTitleStyle}" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Date" Style="{StaticResource LabelTextStyle}" />
                  <DatePicker Height="34" Padding="4" SelectedDate="{Binding MediationDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Time" Style="{StaticResource LabelTextStyle}" />
                  <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="34" FontSize="12" Text="{Binding MediationTimeText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Venue" Style="{StaticResource LabelTextStyle}" />
                  <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="34" FontSize="12" Text="{Binding MediationVenue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource BlotterCardStyle}" Padding="0">
            <ListBox BorderThickness="0" Background="#00FFFFFF" HorizontalContentAlignment="Stretch" ItemsSource="{Binding TimelineEvents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Slate800Brush}" FontSize="12" Text="{Binding Date, StringFormat='MMM dd, yyyy'}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}" Text="{Binding Date, StringFormat=HH:mm}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Slate800Brush}" FontSize="12" Text="{Binding Event}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Slate600Brush}" FontSize="12" Text="{Binding Details}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}" Text="{Binding User, StringFormat=By: {0}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="18,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Content="Update Status" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="126" Margin="0,0,8,0" Command="{Binding UpdateStatusCommand}" IsEnabled="{Binding IsExistingRecord}" />
          <Button Content="Schedule Mediation" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="148" Command="{Binding ScheduleMediationCommand}" IsEnabled="{Binding IsExistingRecord}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="102" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
          <Button Content="Save Case" Style="{StaticResource PrimaryButtonStyle}" Height="36" MinWidth="132" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>