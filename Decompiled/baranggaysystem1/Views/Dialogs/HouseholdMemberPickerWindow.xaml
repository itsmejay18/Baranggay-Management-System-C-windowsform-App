<Window x:Class="baranggaysystem1.Views.Dialogs.HouseholdMemberPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Add Family Member" Width="720" Height="560" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PickerListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="itemBorder" Background="#FFFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12" BorderBrush="{StaticResource Slate100Brush}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="itemBorder" Property="Border.BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                  <Setter TargetName="itemBorder" Property="Border.Background" Value="#F8FBFF" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="itemBorder" Property="Border.BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                  <Setter TargetName="itemBorder" Property="Border.BorderThickness" Value="2" />
                  <Setter TargetName="itemBorder" Property="Border.Background" Value="#EFF6FF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ResidentStateBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="10,4" />
        <Setter Property="Background" Value="#DCFCE7" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsTransfer}">
            <Setter Property="Background" Value="#FEF3C7" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ResidentStateTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#166534" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsTransfer}">
            <Setter Property="Foreground" Value="#92400E" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="46" Height="46" CornerRadius="12" Background="#DBEAFE" Margin="0,0,14,0">
            <fa:IconBlock Icon="Users" Foreground="#2563EB" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Add Family Member" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Text="Search residents and attach them to this household." Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center" Background="#E0F2FE" Padding="12,7" CornerRadius="999">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Home" Foreground="#0369A1" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Household linking" FontSize="11" FontWeight="Bold" Foreground="#075985" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFFFF" CornerRadius="8" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Height="38" Margin="0,0,10,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="38" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="13" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" MinWidth="96" Height="38" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="2" Margin="20,14,20,0" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1" CornerRadius="10">
      <Grid>
        <ListBox Name="candidateList" ItemContainerStyle="{StaticResource PickerListItemStyle}" BorderThickness="0" Background="#00FFFFFF" Padding="14" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResident, Mode=TwoWay}" MouseDoubleClick="CandidateList_MouseDoubleClick">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Background="#EFF6FF">
                  <fa:IconBlock Icon="User" Foreground="#2563EB" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                  <TextBlock Foreground="{StaticResource Slate900Brush}" FontWeight="Bold" FontSize="14" Text="{Binding FullName}" />
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <fa:IconBlock Icon="PhoneAlt" FontSize="10" Foreground="{StaticResource Slate400Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SmallTextStyle}" Text="{Binding ContactNo}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <fa:IconBlock Icon="MapMarkerAlt" FontSize="10" Foreground="{StaticResource Slate400Brush}" Margin="0,0,6,0" VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" Width="360" Text="{Binding AddressLabel}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Border Style="{StaticResource ResidentStateBadgeStyle}" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource ResidentStateTextStyle}" Text="{Binding HouseholdLabel}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
          <fa:IconBlock Icon="UserSlash" FontSize="42" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Text="{Binding EmptyStateMessage}" />
        </StackPanel>
        <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel VerticalAlignment="Center">
            <fa:IconBlock Icon="Spinner" FontSize="34" Foreground="{StaticResource Slate400Brush}" HorizontalAlignment="Center">
              <UIElement.RenderTransform>
                <RotateTransform CenterX="17" CenterY="17" />
              </UIElement.RenderTransform>
              <FrameworkElement.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </FrameworkElement.Triggers>
            </fa:IconBlock>
            <TextBlock Text="Loading residents..." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="20,16" Margin="0,14,0,0">
      <Grid>
        <Button Name="btnAttach" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Height="38" Click="BtnAttach_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="UserPlus" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Add to Household" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="38" Click="BtnClose_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>