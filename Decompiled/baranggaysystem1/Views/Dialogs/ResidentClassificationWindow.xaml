<Window x:Class="baranggaysystem1.Views.Dialogs.ResidentClassificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Tag or Category" Width="560" Height="590" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{StaticResource Slate50Brush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1D4ED8" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <fa:IconBlock Icon="Tags" Foreground="#BFDBFE" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Name="eyebrowText" Text="CLASSIFICATION" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="headerTitleText" Text="Maintain resident tags and categories" Foreground="#FFFFFFFF" FontSize="23" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" TextWrapping="Wrap" />
        <TextBlock Name="headerSubtitleText" Text="Save labels used to organize resident records and registry views." Foreground="#DBEAFE" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Type" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="typeComboBox" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Status" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Name="statusComboBox" Style="{StaticResource StyledComboBoxStyle}" Height="40" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Name" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <TextBox Name="nameTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" MaxLength="100" />
        <TextBlock Text="Description" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <TextBox Name="descriptionTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="120" MaxLength="255" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />
        <TextBlock Text="Color" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="56" />
          </Grid.ColumnDefinitions>
          <ComboBox Name="colorComboBox" Grid.Column="0" Style="{StaticResource StyledComboBoxStyle}" Height="40" SelectionChanged="ColorComboBox_SelectionChanged" />
          <Border Name="colorPreview" Grid.Column="1" Height="40" Margin="12,0,0,0" CornerRadius="8" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" />
        </Grid>
        <Border Name="systemNotice" Visibility="Collapsed" Margin="0,20,0,0" Padding="14" Background="#EFF6FF" CornerRadius="8" BorderBrush="#DBEAFE" BorderThickness="1">
          <DockPanel>
            <fa:IconBlock Icon="InfoCircle" Foreground="#2563EB" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Text="This system category is connected to existing resident registry flags. Its type is locked, and it cannot be deleted." Foreground="#1D4ED8" FontSize="12" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40" Margin="0,0,12,0" IsCancel="True" />
        <Button Name="saveButton" Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="130" Height="40" IsDefault="True" Click="SaveButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>