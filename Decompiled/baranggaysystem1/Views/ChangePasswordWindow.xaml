<Window x:Class="baranggaysystem1.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        Background="#FF1a1a2e">

    <Grid Margin="32">
        <StackPanel>
            <TextBlock Text="Change Password"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,8" />

            <TextBlock x:Name="subtitleLabel"
                       Text="Please set a new password to continue."
                       FontSize="13"
                       Foreground="#8899A6"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <!-- Current Password -->
            <TextBlock Text="Current Password" FontSize="12" Foreground="#AAB8C2" Margin="0,0,0,4" />
            <PasswordBox x:Name="currentPasswordBox"
                         FontSize="14"
                         Padding="10,8"
                         Background="#FF2d2d44"
                         Foreground="White"
                         BorderBrush="#FF5c5c8a"
                         Margin="0,0,0,16" />

            <!-- New Password -->
            <TextBlock Text="New Password (min 6 characters)" FontSize="12" Foreground="#AAB8C2" Margin="0,0,0,4" />
            <PasswordBox x:Name="newPasswordBox"
                         FontSize="14"
                         Padding="10,8"
                         Background="#FF2d2d44"
                         Foreground="White"
                         BorderBrush="#FF5c5c8a"
                         Margin="0,0,0,16" />

            <!-- Confirm Password -->
            <TextBlock Text="Confirm New Password" FontSize="12" Foreground="#AAB8C2" Margin="0,0,0,4" />
            <PasswordBox x:Name="confirmPasswordBox"
                         FontSize="14"
                         Padding="10,8"
                         Background="#FF2d2d44"
                         Foreground="White"
                         BorderBrush="#FF5c5c8a"
                         Margin="0,0,0,16" />

            <!-- Error -->
            <TextBlock x:Name="errorLabel"
                       Text=""
                       FontSize="12"
                       Foreground="#FF6B6B"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />

            <!-- Success -->
            <TextBlock x:Name="successLabel"
                       Text=""
                       FontSize="12"
                       Foreground="#4CAF50"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Change Password"
                        Click="ChangeButton_Click"
                        Padding="20,8"
                        FontSize="13"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0" />

                <Button x:Name="cancelButton"
                        Content="Cancel"
                        Click="CancelButton_Click"
                        Padding="20,8"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="#AAB8C2"
                        BorderBrush="#5c5c8a"
                        BorderThickness="1"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
