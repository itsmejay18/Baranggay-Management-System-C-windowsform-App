<UserControl x:Class="baranggaysystem1.Views.Pages.TanodPatrolPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             Background="{StaticResource PageBgBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="10" Background="#FEF2F2" Margin="0,0,14,0">
            <fa:IconBlock Icon="ShieldAlt" Foreground="#DC2626" FontSize="20"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Tanod Patrol" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="recordCountLabel" Text="Manage tanod members, patrol shifts, and incident logs."
                       Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="btnNewMember" Content="+ Tanod Member" Style="{StaticResource SecondaryButtonStyle}"
                  MinWidth="140" Margin="0,0,8,0" Click="BtnNewMember_Click" />
          <Button Name="btnNewShift" Content="+ Schedule Shift" Style="{StaticResource SecondaryButtonStyle}"
                  MinWidth="140" Margin="0,0,8,0" Click="BtnNewShift_Click" />
          <Button Name="btnNewLog" Content="+ Patrol Log" Style="{StaticResource PrimaryButtonStyle}"
                  MinWidth="140" Click="BtnNewLog_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFFFF" Padding="20,0"
            BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <RadioButton Name="tabShifts" Content="Shifts" GroupName="TanodTabs"
                     IsChecked="True" Checked="Tab_Checked"
                     Padding="16,12" FontWeight="SemiBold" FontSize="13" />
        <RadioButton Name="tabLogs" Content="Patrol Logs" GroupName="TanodTabs"
                     Checked="Tab_Checked"
                     Padding="16,12" FontWeight="SemiBold" FontSize="13" />
        <RadioButton Name="tabMembers" Content="Members" GroupName="TanodTabs"
                     Checked="Tab_Checked"
                     Padding="16,12" FontWeight="SemiBold" FontSize="13" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFFFF" CornerRadius="6"
                BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Height="36">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="13"
                          Foreground="{StaticResource Slate500Brush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF"
                     VerticalContentAlignment="Center" FontSize="13" Margin="0,0,8,0"
                     TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <ComboBox Name="filterCombo" Grid.Column="1" Width="170" Height="36" Margin="10,0,0,0"
                  Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Height="36"
                MinWidth="0" Padding="12,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#FFFFFFFF" Margin="20,14,20,0" CornerRadius="8"
            BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}"
                  RowStyle="{StaticResource StyledDataGridRowStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="MainGrid_SelectionChanged"
                  MouseDoubleClick="MainGrid_DoubleClick" />
        <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
          <fa:IconBlock Icon="ShieldAlt" FontSize="48" Foreground="{StaticResource Slate300Brush}"
                        HorizontalAlignment="Center" Margin="0,0,0,12" />
          <TextBlock Name="emptyLabel" Text="No records found."
                     Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Name="contextActionBar" Grid.Row="4" Visibility="Collapsed"
            Background="{StaticResource Slate100Brush}" Margin="20,10,20,20"
            Padding="16,10" CornerRadius="8"
            BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <fa:IconBlock Icon="CheckCircle" Foreground="#DC2626" FontSize="14"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="Selected: " VerticalAlignment="Center" FontWeight="Bold"
                   Foreground="{StaticResource Slate700Brush}" />
        <TextBlock Name="selectedLabel" Text="" VerticalAlignment="Center" FontWeight="Bold"
                   Foreground="{StaticResource Slate900Brush}" Margin="4,0,20,0" />
        <Button Name="btnAttendance" Content="View Attendance" Style="{StaticResource ContextualActionButtonStyle}"
                Margin="0,0,8,0" Click="BtnAttendance_Click" />
        <Button Name="btnDelete" Content="Delete" Style="{StaticResource ActionButtonStyle}"
                Click="BtnDelete_Click" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
