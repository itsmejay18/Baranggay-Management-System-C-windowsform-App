<UserControl x:Class="baranggaysystem1.Views.Pages.CollectionsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="24" Height="24" CornerRadius="10" Background="#ECFDF5" Margin="0,0,8,0">
            <fa:IconBlock Icon="BoxOpen" Foreground="#0F766E" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Finance Operations" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="recordCountLabel" Text="Manage expenses, inventory stock, and barangay assets." Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#DBEAFE" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999" Padding="10,6" Margin="0,0,10,0">
            <TextBlock Name="sectionBadgeText" Text="Expense Ledger" Foreground="#1D4ED8" FontWeight="Bold" FontSize="12" />
          </Border>
          <Button Name="btnAddRecord" Content="Record Expense" Style="{StaticResource PrimaryButtonStyle}" MinWidth="160" Click="BtnAdd_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Row="1" Margin="20,14,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Margin="0,0,10,0" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Total Expenses" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="totalExpenseMetric" Text="PHP 0.00" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="{StaticResource Slate900Brush}" />
          <TextBlock Text="All recorded expense entries" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="0,0,10,0" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Pending Expenses" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="pendingExpenseMetric" Text="0" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="#B45309" />
          <TextBlock Text="Entries still awaiting settlement" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Margin="0,0,10,0" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Inventory Value" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="inventoryValueMetric" Text="PHP 0.00" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="#0F766E" />
          <TextBlock Text="Estimated value on hand" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Margin="0,0,10,0" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Low Stock Alerts" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="lowStockMetric" Text="0" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="#DC2626" />
          <TextBlock Text="Items at or below reorder" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Active Asset Value" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="activeAssetMetric" Text="PHP 0.00" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="#334155" />
          <TextBlock Text="Acquisition value of active assets" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFFFF" CornerRadius="6" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Height="36">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="13" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,6,0" TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <ComboBox Name="categoryFilter" Grid.Column="1" Margin="12,0,0,0" Height="36" Width="180" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <ComboBox Name="statusFilter" Grid.Column="2" Margin="8,0,0,0" Height="36" Width="180" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="0" Padding="12,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="#FFFFFFFF" Margin="20,14,20,0" CornerRadius="8" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1" ClipToBounds="True">
      <TabControl Name="financeTabs" SelectionChanged="FinanceTabs_SelectionChanged">
        <TabItem Header="Expenses Ledger">
          <Grid>
            <DataGrid Name="expenseGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ExpenseGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="120" Binding="{Binding [expense_date_display]}" />
                <DataGridTextColumn Header="Expense" Width="2*" Binding="{Binding [expense_title]}" />
                <DataGridTextColumn Header="Category" Width="1.3*" Binding="{Binding [expense_category]}" />
                <DataGridTextColumn Header="Payee" Width="1.5*" Binding="{Binding [payee_display]}" />
                <DataGridTextColumn Header="Amount" Width="120" Binding="{Binding [amount_display]}" />
                <DataGridTextColumn Header="Method" Width="120" Binding="{Binding [payment_method_display]}" />
                <DataGridTextColumn Header="Status" Width="120" Binding="{Binding [status_display]}" />
                <DataGridTextColumn Header="Reference" Width="1.2*" Binding="{Binding [reference_display]}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Name="expenseEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <fa:IconBlock Icon="MoneyBillWave" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
              <TextBlock Name="expenseEmptyLabel" Text="No expense entries found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Inventory Stock">
          <Grid>
            <DataGrid Name="inventoryGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="InventoryGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Width="2*" Binding="{Binding [item_name]}" />
                <DataGridTextColumn Header="Category" Width="1.4*" Binding="{Binding [category]}" />
                <DataGridTextColumn Header="Stock" Width="120" Binding="{Binding [quantity_display]}" />
                <DataGridTextColumn Header="Reorder" Width="120" Binding="{Binding [reorder_display]}" />
                <DataGridTextColumn Header="Unit Cost" Width="120" Binding="{Binding [unit_cost_display]}" />
                <DataGridTextColumn Header="Value" Width="120" Binding="{Binding [stock_value_display]}" />
                <DataGridTextColumn Header="Stock State" Width="140" Binding="{Binding [stock_state_display]}" />
                <DataGridTextColumn Header="Location" Width="1.5*" Binding="{Binding [location_display]}" />
                <DataGridTextColumn Header="Status" Width="110" Binding="{Binding [item_status_display]}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Name="inventoryEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <fa:IconBlock Icon="BoxOpen" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
              <TextBlock Name="inventoryEmptyLabel" Text="No inventory items found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Assets Registry">
          <Grid>
            <DataGrid Name="assetGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="AssetGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Asset" Width="2*" Binding="{Binding [asset_name]}" />
                <DataGridTextColumn Header="Category" Width="1.4*" Binding="{Binding [asset_category]}" />
                <DataGridTextColumn Header="Tag" Width="1.1*" Binding="{Binding [asset_tag_display]}" />
                <DataGridTextColumn Header="Acquired" Width="120" Binding="{Binding [acquisition_date_display]}" />
                <DataGridTextColumn Header="Value" Width="120" Binding="{Binding [acquisition_cost_display]}" />
                <DataGridTextColumn Header="Condition" Width="130" Binding="{Binding [condition_status_display]}" />
                <DataGridTextColumn Header="Lifecycle" Width="130" Binding="{Binding [lifecycle_status_display]}" />
                <DataGridTextColumn Header="Location" Width="1.5*" Binding="{Binding [assigned_location_display]}" />
                <DataGridTextColumn Header="Custodian" Width="1.4*" Binding="{Binding [custodian_name_display]}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Name="assetEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <fa:IconBlock Icon="Building" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
              <TextBlock Name="assetEmptyLabel" Text="No asset records found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>
    <Border Name="contextActionBar" Grid.Row="4" Visibility="Collapsed" Background="{StaticResource Slate100Brush}" Margin="20,10,20,0" Padding="16,10" CornerRadius="8" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Name="selectedRecordLabel" Text="No record selected" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" />
          <TextBlock Name="selectedRecordMetaLabel" Text="Select a finance record to view details or edit it." Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="btnEditSelected" Content="Edit Record" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,0" Click="BtnEditSelected_Click" />
          <Button Name="btnViewSelected" Content="View Details" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="BtnViewSelected_Click" />
          <Button Content="Clear" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Foreground="{StaticResource Slate500Brush}" Click="BtnClearSelection_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="5" Margin="20,10,20,14" Background="#00FFFFFF" Height="38">
      <Grid>
        <TextBlock Name="footerCountLabel" Text="No finance records loaded." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <TextBlock Name="footerHintLabel" Text="Use this workspace for internal finance operations beyond resident payment receipts." Style="{StaticResource SmallTextStyle}" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
