<UserControl x:Class="baranggaysystem1.Views.Pages.NotificationOutboxPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="OutboxSurfaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="16" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="OutboxMetricCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource OutboxSurfaceCardStyle}">
        <Setter Property="Border.Padding" Value="10,8" />
      </Style>
      <Style x:Key="OutboxMetricLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate500Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="9" />
      </Style>
      <Style x:Key="OutboxMetricValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
      </Style>
      <Style x:Key="OutboxSearchShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FCFDFE" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Height" Value="36" />
      </Style>
      <Style x:Key="OutboxCompactButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="MinWidth" Value="92" />
      </Style>
      <Style x:Key="OutboxCompactPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="MinWidth" Value="112" />
      </Style>
      <Style x:Key="OutboxHeroChipStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,3,5,0" />
      </Style>
      <Style x:Key="OutboxHeroChipTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate700Brush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
      </Style>
      <Style x:Key="OutboxDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource StyledDataGridColumnHeaderStyle}">
        <Setter Property="Background" Value="#0F172A" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>
      <Style x:Key="OutboxDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource StyledDataGridRowStyle}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <Trigger Property="DataGridRow.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#FFFCFDFE" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF8FAFC" />
          </Trigger>
          <Trigger Property="DataGridRow.IsSelected" Value="True">
            <Setter Property="Background" Value="#FFEFF6FF" />
            <Setter Property="Foreground" Value="#FF1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="OutboxDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
      </Style>
      <Style x:Key="OutboxCompactLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Slate600Brush}" />
        <Setter Property="Margin" Value="0,0,0,3" />
      </Style>
      <Style x:Key="OutboxSelectionMetaStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate500Brush}" />
        <Setter Property="FontSize" Value="10.5" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Padding="16,10,16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="12" Background="#EDE9FE" Margin="0,0,14,0">
            <fa:IconBlock Icon="PaperPlane" Foreground="#7C3AED" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Notification Outbox" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="recordCountLabel" Text="Review, filter, and retry queued SMS &amp; email notifications." Style="{StaticResource SubtitleTextStyle}" Margin="0,1,0,0" FontWeight="SemiBold" />
            <WrapPanel Margin="0,6,0,0">
              <Border Style="{StaticResource OutboxHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="Envelope" FontSize="10" Foreground="#7C3AED" Margin="0,0,5,0" VerticalAlignment="Center" />
                  <TextBlock Name="totalChip" Text="0 notifications" Style="{StaticResource OutboxHeroChipTextStyle}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource OutboxHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="Clock" FontSize="10" Foreground="#D97706" Margin="0,0,5,0" VerticalAlignment="Center" />
                  <TextBlock Name="pendingChip" Text="0 pending" Style="{StaticResource OutboxHeroChipTextStyle}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource OutboxHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="ExclamationTriangle" FontSize="10" Foreground="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center" />
                  <TextBlock Name="failedChip" Text="0 failed" Style="{StaticResource OutboxHeroChipTextStyle}" />
                </StackPanel>
              </Border>
            </WrapPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Name="btnRetryFailed" Style="{StaticResource OutboxCompactButtonStyle}" Margin="0,0,8,0" Click="BtnRetryFailed_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Redo" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Retry All Failed" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OutboxCompactPrimaryButtonStyle}" Click="BtnRefresh_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="SyncAlt" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Refresh" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Row="1" Margin="12,10,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource OutboxMetricCardStyle}" Margin="0,0,10,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="12" Background="#DBEAFE">
            <fa:IconBlock Icon="Envelope" Foreground="#2563EB" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Total" Style="{StaticResource OutboxMetricLabelStyle}" />
            <TextBlock Name="totalCountValue" Text="0" Style="{StaticResource OutboxMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource OutboxMetricCardStyle}" Margin="0,0,10,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="12" Background="#FEF3C7">
            <fa:IconBlock Icon="HourglassHalf" Foreground="#D97706" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Pending" Style="{StaticResource OutboxMetricLabelStyle}" />
            <TextBlock Name="pendingCountValue" Text="0" Style="{StaticResource OutboxMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource OutboxMetricCardStyle}" Margin="0,0,10,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="12" Background="#DCFCE7">
            <fa:IconBlock Icon="CheckCircle" Foreground="#16A34A" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Sent" Style="{StaticResource OutboxMetricLabelStyle}" />
            <TextBlock Name="sentCountValue" Text="0" Style="{StaticResource OutboxMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource OutboxMetricCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="12" Background="#FEE2E2">
            <fa:IconBlock Icon="TimesCircle" Foreground="#DC2626" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Failed" Style="{StaticResource OutboxMetricLabelStyle}" />
            <TextBlock Name="failedCountValue" Text="0" Style="{StaticResource OutboxMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource ToolbarBorderStyle}" Padding="14,8" Margin="12,12,12,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource OutboxSearchShellStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="12" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF" Margin="0,0,8,0" VerticalContentAlignment="Center" FontSize="12.5" TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <ComboBox Name="statusFilterCombo" Grid.Column="1" Height="36" Margin="10,0,0,0" SelectionChanged="FilterCombo_SelectionChanged" />
        <ComboBox Name="channelFilterCombo" Grid.Column="2" Height="36" Margin="10,0,0,0" SelectionChanged="FilterCombo_SelectionChanged" />
        <ComboBox Name="moduleFilterCombo" Grid.Column="3" Height="36" Margin="10,0,0,0" SelectionChanged="FilterCombo_SelectionChanged" />
        <Button Grid.Column="5" Style="{StaticResource OutboxCompactButtonStyle}" Margin="12,0,0,0" Click="BtnClearFilters_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="TimesCircle" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Clear Filters" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Grid Row="3" Margin="12,12,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*" />
        <ColumnDefinition Width="1.1*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource OutboxSurfaceCardStyle}" Margin="0,0,12,0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Outbox Queue" Style="{StaticResource SectionHeaderTextStyle}" />
              <TextBlock Name="tableMetaLabel" Text="Queued notification dispatch queue" Style="{StaticResource SmallTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Name="tableVisibleLabel" Grid.Column="1" Text="0 visible" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" VerticalAlignment="Center" />
          </Grid>
          <Grid Row="1">
            <DataGrid Name="mainGrid" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" HeadersVisibility="Column" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource OutboxDataGridHeaderStyle}" RowStyle="{StaticResource OutboxDataGridRowStyle}" CellStyle="{StaticResource OutboxDataGridCellStyle}" SelectionChanged="MainGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="70" Binding="{Binding NotificationId}" />
                <DataGridTextColumn Header="Channel" Width="75" Binding="{Binding Channel}" />
                <DataGridTextColumn Header="Recipient" Width="170" Binding="{Binding Recipient}" />
                <DataGridTextColumn Header="Subject" Width="*" Binding="{Binding Subject}" />
                <DataGridTextColumn Header="Status" Width="85" Binding="{Binding Status}" />
                <DataGridTextColumn Header="Attempts" Width="72" Binding="{Binding Attempts}" />
                <DataGridTextColumn Header="Module" Width="95" Binding="{Binding SourceModule}" />
                <DataGridTextColumn Header="Scheduled" Width="145" Binding="{Binding ScheduledAt}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <fa:IconBlock Icon="PaperPlane" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
              <TextBlock Name="emptyLabel" Text="No notifications in the outbox." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource OutboxSurfaceCardStyle}" Padding="16,14,16,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Notification Details" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Name="selectedSummaryLabel" Text="Select a notification to inspect its details." Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,10,0,0">
            <Border Style="{StaticResource OutboxHeroChipStyle}">
              <TextBlock Name="selectedChannelChip" Text="Channel: -" Style="{StaticResource OutboxHeroChipTextStyle}" />
            </Border>
            <Border Style="{StaticResource OutboxHeroChipStyle}">
              <TextBlock Name="selectedStatusChip" Text="Status: -" Style="{StaticResource OutboxHeroChipTextStyle}" />
            </Border>
            <Border Style="{StaticResource OutboxHeroChipStyle}">
              <TextBlock Name="selectedModuleChip" Text="Module: -" Style="{StaticResource OutboxHeroChipTextStyle}" />
            </Border>
          </WrapPanel>
          <Grid Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Recipient" Style="{StaticResource OutboxCompactLabelStyle}" />
              <TextBlock Name="selectedRecipientLabel" Text="-" Style="{StaticResource OutboxSelectionMetaStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
              <TextBlock Text="Scheduled At" Style="{StaticResource OutboxCompactLabelStyle}" />
              <TextBlock Name="selectedScheduledLabel" Text="-" Style="{StaticResource OutboxSelectionMetaStyle}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <Grid Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Sent At" Style="{StaticResource OutboxCompactLabelStyle}" />
              <TextBlock Name="selectedSentAtLabel" Text="-" Style="{StaticResource OutboxSelectionMetaStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
              <TextBlock Text="Attempts" Style="{StaticResource OutboxCompactLabelStyle}" />
              <TextBlock Name="selectedAttemptsLabel" Text="-" Style="{StaticResource OutboxSelectionMetaStyle}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="4" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Message" Style="{StaticResource OutboxCompactLabelStyle}" />
              <TextBox Name="selectedMessageBox" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" MinHeight="120" MaxHeight="220" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" Background="#FCFDFE" Padding="10" VerticalScrollBarVisibility="Auto" />
              <TextBlock Text="Last Error" Style="{StaticResource OutboxCompactLabelStyle}" />
              <TextBox Name="selectedErrorBox" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" MinHeight="60" MaxHeight="140" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" Background="#FFF7ED" Padding="10" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
          </ScrollViewer>
          <Button Name="btnRetrySingle" Grid.Row="5" Margin="0,12,0,0" Style="{StaticResource OutboxCompactPrimaryButtonStyle}" HorizontalAlignment="Stretch" IsEnabled="False" Click="BtnRetrySingle_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <fa:IconBlock Icon="Redo" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Retry This Notification" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="4" Margin="20,6,20,14" Background="#00FFFFFF">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="footerCountLabel" Text="No notifications loaded." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <TextBlock Name="footerRefreshLabel" Grid.Column="1" Text="" Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" Opacity="0.72" />
      </Grid>
    </Border>
  </Grid>
</UserControl>