<UserControl x:Class="baranggaysystem1.Views.Pages.ClearancesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="QueueStatCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="Border.Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="QueueStatLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate500Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style x:Key="QueueStatValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
        <Setter Property="FontSize" Value="14" />
      </Style>
      <Style x:Key="QueueSurfaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="16" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="QueueSearchShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Height" Value="34" />
      </Style>
      <Style x:Key="QueueMetaBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Slate50Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
      <Style x:Key="QueueDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource StyledDataGridRowStyle}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <Trigger Property="DataGridRow.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#FFFBFD" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF8FAFC" />
          </Trigger>
          <Trigger Property="DataGridRow.IsSelected" Value="True">
            <Setter Property="Background" Value="#FFEFF6FF" />
            <Setter Property="Foreground" Value="#FF1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="QueueDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="QueueRequestBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFF8FAFC" />
        <Setter Property="BorderBrush" Value="#FFE2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="8,2" />
      </Style>
      <Style x:Key="QueueStatusBadgeBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFF8FAFC" />
        <Setter Property="BorderBrush" Value="#FFE2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="10,4" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="SUBMITTED">
            <Setter Property="Background" Value="#FFE0F2FE" />
            <Setter Property="BorderBrush" Value="#FF7DD3FC" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="APPROVED">
            <Setter Property="Background" Value="#FFDBEAFE" />
            <Setter Property="BorderBrush" Value="#FF93C5FD" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="RELEASED">
            <Setter Property="Background" Value="#FFDCFCE7" />
            <Setter Property="BorderBrush" Value="#FF86EFAC" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="REJECTED">
            <Setter Property="Background" Value="#FFFEE2E2" />
            <Setter Property="BorderBrush" Value="#FFFCA5A5" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="CANCELLED">
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="QueueStatusBadgeTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate700Brush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="SUBMITTED">
            <Setter Property="Foreground" Value="#FF0369A1" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="APPROVED">
            <Setter Property="Foreground" Value="#FF1D4ED8" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="RELEASED">
            <Setter Property="Foreground" Value="#FF15803D" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="REJECTED">
            <Setter Property="Foreground" Value="#FFB91C1C" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="CANCELLED">
            <Setter Property="Foreground" Value="#FF475569" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="QueueTimelineSecondaryTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate500Brush}" />
        <Style.Triggers>
          <Trigger Property="Text" Value="Awaiting release">
            <Setter Property="Foreground" Value="{StaticResource Slate400Brush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Padding="14,5,14,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Certificate" Foreground="#D97706" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Clearance &amp; Certification Queue" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" VerticalAlignment="Center" />
            <TextBlock Name="recordCountLabel" Text="" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="21,2,0,0">
            <TextBlock Text="Queue:" FontSize="9" Foreground="{StaticResource Slate500Brush}" VerticalAlignment="Center" Margin="0,0,3,0" />
            <TextBlock Name="visibleQueueMetric" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Pending:" FontSize="9" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,3,0" />
            <TextBlock Name="pendingQueueMetric" Text="0" FontSize="11" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Released:" FontSize="9" Foreground="#15803D" VerticalAlignment="Center" Margin="0,0,3,0" />
            <TextBlock Name="releasedQueueMetric" Text="0" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Follow-up:" FontSize="9" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,3,0" />
            <TextBlock Name="attentionQueueMetric" Text="0" FontSize="11" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,0" Height="26" Padding="6,0" Click="BtnVerify_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="ShieldAlt" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="Verify" VerticalAlignment="Center" FontSize="10" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Height="26" Padding="6,0">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Download" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="Export" VerticalAlignment="Center" FontSize="10" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="8,0" Click="BtnAdd_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Plus" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="New Request" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="10" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}" Padding="14,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource QueueSearchShellStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="11" Foreground="{StaticResource Slate400Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid Column="1">
              <TextBox Name="searchBox" Margin="0,0,12,0" Background="#00FFFFFF" BorderThickness="0" VerticalContentAlignment="Center" FontSize="11" TextChanged="SearchBox_TextChanged" />
              <TextBlock Text="Search tracking code, document no., token, resident, or purpose" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Slate400Brush}" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="" Binding="{Binding Text, ElementName=searchBox}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
          </Grid>
        </Border>
        <ComboBox Name="typeFilter" Grid.Column="1" Width="178" Height="34" Margin="10,0,0,0" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <ComboBox Name="statusFilter" Grid.Column="2" Width="142" Height="34" Margin="8,0,0,0" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="0" Padding="10,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh Queue" VerticalAlignment="Center" FontSize="11" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="2" Margin="20,16,20,0" ClipToBounds="True" Style="{StaticResource QueueSurfaceCardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFCFDFE" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,0,0,1" Padding="18,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Request Board" Style="{StaticResource SectionHeaderTextStyle}" />
              <TextBlock Name="tableMetaLabel" Text="Browse the live queue, then select a request to release or cancel." Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource QueueMetaBadgeStyle}">
                <TextBlock Name="tableVisibleLabel" Text="0 visible" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" />
              </Border>
              <Border Style="{StaticResource QueueMetaBadgeStyle}" Margin="0">
                <TextBlock Name="tableSelectionLabel" Text="No selection" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" />
              </Border>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Row="1">
          <DataGrid Name="mainGrid" Margin="10,8,10,10" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource QueueDataGridRowStyle}" CellStyle="{StaticResource QueueDataGridCellStyle}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" RowHeight="78" HeadersVisibility="Column" CanUserAddRows="False" SelectionChanged="MainGrid_SelectionChanged">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Release and Print" Click="BtnIssue_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="Stamp" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Print Preview" Click="BtnPrintPreview_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="Eye" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Verification &amp; QR" Click="BtnVerifySelected_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="Qrcode" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Cancel Request" Click="BtnCancel_Click" Foreground="#B91C1C">
                  <MenuItem.Icon><fa:IconBlock Icon="Times" FontSize="12" Foreground="#B91C1C" /></MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Request" Width="1.45*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8">
                      <TextBlock Foreground="{StaticResource Slate900Brush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding [tracking_code]}" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource QueueRequestBadgeStyle}">
                          <TextBlock Style="{StaticResource SmallTextStyle}" FontWeight="Bold" Text="{Binding [request_meta]}" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Resident" Width="1.55*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8">
                      <TextBlock Foreground="{StaticResource Slate900Brush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding [resident_name]}" />
                      <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" Foreground="{StaticResource Slate500Brush}" Text="{Binding [resident_meta]}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Document" Width="1.8*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8">
                      <TextBlock Foreground="{StaticResource Slate900Brush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding [certification_type]}" />
                      <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" Text="{Binding [purpose_display]}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Timeline" Width="1.7*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8">
                      <TextBlock Text="Requested" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" Foreground="{StaticResource Slate500Brush}" />
                      <TextBlock Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" Text="{Binding [requested_on]}" />
                      <TextBlock Text="Released" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" Foreground="{StaticResource Slate500Brush}" Margin="0,6,0,0" />
                      <TextBlock Style="{StaticResource QueueTimelineSecondaryTextStyle}" Text="{Binding [released_on_display]}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Fee" Width="0.95*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8">
                      <TextBlock Foreground="{StaticResource Slate900Brush}" FontWeight="Bold" Text="{Binding [fee_display]}" />
                      <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" Text="{Binding [or_number_display]}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="1.15*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8">
                      <Border Style="{StaticResource QueueStatusBadgeBorderStyle}" HorizontalAlignment="Left" Tag="{Binding [status]}">
                        <TextBlock Style="{StaticResource QueueStatusBadgeTextStyle}" Text="{Binding [status_display]}" Tag="{Binding [status]}" />
                      </Border>
                      <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" Text="{Binding [status_meta]}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <fa:IconBlock Icon="FileAlt" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Name="emptyLabel" Text="No clearance records found for current filters." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Try adjusting your filters or submit a new request." Style="{StaticResource SmallTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Border Name="contextActionBar" Grid.Row="3" Visibility="Collapsed" Margin="20,12,20,0" Padding="18,14" Style="{StaticResource QueueSurfaceCardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Bolt" Foreground="#FF4F46E5" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Queue actions for" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Slate700Brush}" />
            <TextBlock Name="selectedRecordLabel" Text="REQ-000001" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" Margin="6,0,0,0" />
          </StackPanel>
          <TextBlock Name="selectedRecordMetaLabel" Text="Select a queue record to manage release or cancellation." Style="{StaticResource SmallTextStyle}" Margin="24,6,0,0" />
          <TextBlock Name="selectedVerificationLabel" Text="Verification details appear here once a request is selected." Style="{StaticResource SmallTextStyle}" Margin="24,4,0,0" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,14,0,0">
            <Button Name="btnRelease" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,8" Click="BtnIssue_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="Stamp" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Name="btnReleaseLabel" Text="Release and Print" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
              </StackPanel>
            </Button>
            <Button Name="btnPreview" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8" Click="BtnPrintPreview_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="Eye" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Print Preview" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="btnCancel" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8" Click="BtnCancel_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="Times" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Cancel Request" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="btnVerifySelected" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" Click="BtnVerifySelected_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="Qrcode" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Verification &amp; QR" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="4" Foreground="{StaticResource Slate400Brush}" Click="BtnClearSelection_Click">
          <fa:IconBlock Icon="Times" FontSize="12" />
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="4" Margin="20,12,20,16" Padding="16,12" Style="{StaticResource QueueSurfaceCardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Name="footerCountLabel" Text="No records loaded." Style="{StaticResource SmallTextStyle}" FontWeight="SemiBold" />
          <TextBlock Text="Tip: select a queue row to reveal release and cancellation actions." Style="{StaticResource SmallTextStyle}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Queue sync stays aligned with the local MySQL certificate records" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>