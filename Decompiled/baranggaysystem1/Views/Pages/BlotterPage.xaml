<UserControl x:Class="baranggaysystem1.Views.Pages.BlotterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="BlotterSurfaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="18" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.06" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BlotterHeroChipStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFF7ED" />
        <Setter Property="BorderBrush" Value="#FED7AA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,4,6,0" />
      </Style>
      <Style x:Key="BlotterHeroChipTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="#9A3412" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
      </Style>
      <Style x:Key="BlotterMetricCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource BlotterSurfaceCardStyle}">
        <Setter Property="Border.Padding" Value="10,8" />
      </Style>
      <Style x:Key="BlotterMetricLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate500Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="9.5" />
      </Style>
      <Style x:Key="BlotterMetricValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
      </Style>
      <Style x:Key="BlotterSearchShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FCFDFE" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Height" Value="36" />
      </Style>
      <Style x:Key="BlotterCompactButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="MinWidth" Value="92" />
      </Style>
      <Style x:Key="BlotterCompactPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="MinWidth" Value="126" />
      </Style>
      <Style x:Key="BlotterDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource StyledDataGridColumnHeaderStyle}">
        <Setter Property="Background" Value="#1C1917" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>
      <Style x:Key="BlotterDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource StyledDataGridRowStyle}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <Trigger Property="DataGridRow.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#FFFCFCFD" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFFFF7ED" />
          </Trigger>
          <Trigger Property="DataGridRow.IsSelected" Value="True">
            <Setter Property="Background" Value="#FFFFEDD5" />
            <Setter Property="Foreground" Value="#9A3412" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="BlotterDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
      </Style>
      <Style x:Key="BlotterCaseBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FEF2F2" />
        <Setter Property="BorderBrush" Value="#FECACA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="10,4" />
      </Style>
      <Style x:Key="BlotterStatusBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="12,5" />
        <Style.Triggers>
          <DataTrigger Value="ONGOING" Binding="{Binding [status_display]}">
            <Setter Property="Background" Value="#FEF3C7" />
            <Setter Property="BorderBrush" Value="#FCD34D" />
          </DataTrigger>
          <DataTrigger Value="SETTLED" Binding="{Binding [status_display]}">
            <Setter Property="Background" Value="#DCFCE7" />
            <Setter Property="BorderBrush" Value="#86EFAC" />
          </DataTrigger>
          <DataTrigger Value="REFERRED" Binding="{Binding [status_display]}">
            <Setter Property="Background" Value="#DBEAFE" />
            <Setter Property="BorderBrush" Value="#93C5FD" />
          </DataTrigger>
          <DataTrigger Value="CLOSED" Binding="{Binding [status_display]}">
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="BlotterStatusTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Slate700Brush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Style.Triggers>
          <DataTrigger Value="ONGOING" Binding="{Binding [status_display]}">
            <Setter Property="Foreground" Value="#92400E" />
          </DataTrigger>
          <DataTrigger Value="SETTLED" Binding="{Binding [status_display]}">
            <Setter Property="Foreground" Value="#166534" />
          </DataTrigger>
          <DataTrigger Value="REFERRED" Binding="{Binding [status_display]}">
            <Setter Property="Foreground" Value="#1D4ED8" />
          </DataTrigger>
          <DataTrigger Value="CLOSED" Binding="{Binding [status_display]}">
            <Setter Property="Foreground" Value="#334155" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="BlotterSelectionMetaStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate600Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Padding="16,10,16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FECACA" Offset="0" />
                <GradientStop Color="#FED7AA" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <fa:IconBlock Icon="Gavel" Foreground="#DC2626" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Blotter Cases &amp; Mediation" Style="{StaticResource HeadingTextStyle}" FontSize="15" />
            <TextBlock Name="recordCountLabel" Text="Loading blotter case registry..." Style="{StaticResource SubtitleTextStyle}" FontSize="11" Margin="0,1,0,0" />
            <WrapPanel Margin="0,3,0,0">
              <Border Style="{StaticResource BlotterHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="Eye" FontSize="10" Foreground="#EA580C" VerticalAlignment="Center" />
                  <TextBlock Name="headerVisibleLabel" Text="0 visible now" Style="{StaticResource BlotterHeroChipTextStyle}" Margin="5,0,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource BlotterHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="Clock" FontSize="10" Foreground="#DC2626" VerticalAlignment="Center" />
                  <TextBlock Name="headerActiveLabel" Text="0 active / pending" Style="{StaticResource BlotterHeroChipTextStyle}" Margin="5,0,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource BlotterHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="Tags" FontSize="10" Foreground="#C2410C" VerticalAlignment="Center" />
                  <TextBlock Name="headerTypeLabel" Text="0 incident type(s)" Style="{StaticResource BlotterHeroChipTextStyle}" Margin="5,0,0,0" />
                </StackPanel>
              </Border>
            </WrapPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="btnExportCsv" Style="{StaticResource BlotterCompactButtonStyle}" Margin="0,0,6,0" MinWidth="100">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="FileExport" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Export CSV" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="File New Case" Style="{StaticResource BlotterCompactPrimaryButtonStyle}" MinWidth="132" Click="BtnAdd_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <WrapPanel Grid.Row="1" Margin="16,8,16,0">
      <Border Style="{StaticResource BlotterMetricCardStyle}" Width="180" Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="9" Background="#FEF2F2" Margin="0,0,10,0">
            <fa:IconBlock Icon="Gavel" Foreground="#DC2626" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Total Cases" Style="{StaticResource BlotterMetricLabelStyle}" />
            <TextBlock Name="totalCasesMetric" Text="0" Style="{StaticResource BlotterMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource BlotterMetricCardStyle}" Width="180" Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="9" Background="#FFF7ED" Margin="0,0,10,0">
            <fa:IconBlock Icon="Filter" Foreground="#EA580C" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Visible Results" Style="{StaticResource BlotterMetricLabelStyle}" />
            <TextBlock Name="visibleCasesMetric" Text="0" Style="{StaticResource BlotterMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource BlotterMetricCardStyle}" Width="180" Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="9" Background="#FEF3C7" Margin="0,0,10,0">
            <fa:IconBlock Icon="ExclamationCircle" Foreground="#B45309" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Active / Pending" Style="{StaticResource BlotterMetricLabelStyle}" />
            <TextBlock Name="ongoingCasesMetric" Text="0" Style="{StaticResource BlotterMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource BlotterMetricCardStyle}" Width="180">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="9" Background="#DCFCE7" Margin="0,0,10,0">
            <fa:IconBlock Icon="CheckCircle" Foreground="#15803D" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Resolved / Closed" Style="{StaticResource BlotterMetricLabelStyle}" />
            <TextBlock Name="resolvedCasesMetric" Text="0" Style="{StaticResource BlotterMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource BlotterSurfaceCardStyle}" Margin="16,8,16,0" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.2*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource BlotterSearchShellStyle}" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="12" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid Column="1">
              <TextBox Name="searchBox" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="11.5" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged" />
              <TextBlock Name="searchPlaceholderText" Text="Search case number, complainant, respondent, type, or status" Foreground="{StaticResource Slate400Brush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </Border>
        <ComboBox Name="timeFilterCombo" Grid.Column="2" Height="36" Width="130" VerticalAlignment="Center" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="TimeFilter_SelectionChanged">
          <ComboBoxItem Content="All Time" IsSelected="True" />
          <ComboBoxItem Content="This Week" />
          <ComboBoxItem Content="This Month" />
          <ComboBoxItem Content="This Year" />
        </ComboBox>
        <ComboBox Name="caseTypeFilterCombo" Grid.Column="4" Height="36" Width="170" VerticalAlignment="Center" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="CaseTypeFilter_SelectionChanged">
          <ComboBoxItem Content="All Case Types" IsSelected="True" />
        </ComboBox>
        <ComboBox Name="statusFilterCombo" Grid.Column="6" Height="36" Width="138" VerticalAlignment="Center" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="StatusFilter_SelectionChanged">
          <ComboBoxItem Content="All Status" IsSelected="True" />
          <ComboBoxItem Content="ONGOING" />
          <ComboBoxItem Content="SETTLED" />
          <ComboBoxItem Content="REFERRED" />
          <ComboBoxItem Content="CLOSED" />
        </ComboBox>
        <Border Grid.Column="8" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="999" Padding="10,6" VerticalAlignment="Center">
          <WrapPanel VerticalAlignment="Center">
            <fa:IconBlock Icon="InfoCircle" FontSize="10" Foreground="#C2410C" VerticalAlignment="Center" />
            <TextBlock Name="toolbarInsightLabel" Text="Showing the full blotter queue." FontWeight="Bold" FontSize="10.5" Foreground="#92400E" Margin="6,0,0,0" VerticalAlignment="Center" />
            <TextBlock Name="activeFilterLabel" Text="Filters: All search terms, all case types, all statuses, all time." Style="{StaticResource SmallTextStyle}" Foreground="#B45309" FontSize="9.5" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          </WrapPanel>
        </Border>
        <Button Grid.Column="10" Style="{StaticResource BlotterCompactButtonStyle}" Click="BtnClearFilters_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="TimesCircle" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Text="Clear Filters" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="12" Style="{StaticResource BlotterCompactButtonStyle}" MinWidth="0" Padding="10,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh Queue" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource BlotterSurfaceCardStyle}" Margin="20,14,20,0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FCFDFE" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,0,0,1" Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Case Registry" FontFamily="{StaticResource CenturyGothic}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" />
              <TextBlock Name="tableSummaryLabel" Text="0 case(s) ready for review and mediation actions." Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="999" Padding="10,5" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="InfoCircle" FontSize="11" Foreground="#DC2626" VerticalAlignment="Center" />
                <TextBlock Text=" Select a case to unlock actions" Style="{StaticResource SmallTextStyle}" Foreground="#B91C1C" FontWeight="Bold" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid Row="1">
          <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource BlotterDataGridHeaderStyle}" RowStyle="{StaticResource BlotterDataGridRowStyle}" CellStyle="{StaticResource BlotterDataGridCellStyle}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" RowHeight="76" HeadersVisibility="Column" SelectionChanged="MainGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Case File" Width="180">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Border Style="{StaticResource BlotterCaseBadgeStyle}" HorizontalAlignment="Left">
                        <TextBlock Foreground="#B91C1C" FontWeight="Bold" Text="{Binding [case_no]}" />
                      </Border>
                      <TextBlock Text="Barangay blotter record" Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" Foreground="{StaticResource Slate500Brush}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Parties" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="Complainant" Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}" />
                      <TextBlock Foreground="{StaticResource Slate900Brush}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding [complainant_name]}" />
                      <TextBlock Text="Respondent" Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate500Brush}" Margin="0,6,0,0" />
                      <TextBlock Foreground="{StaticResource Slate800Brush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding [respondent_name]}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Incident" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="32" Height="32" CornerRadius="10" Background="#FFF7ED" Margin="0,0,10,0">
                        <fa:IconBlock Icon="ExclamationCircle" FontSize="13" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel>
                        <TextBlock Foreground="{StaticResource Slate900Brush}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding [incident_type]}" />
                        <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,3,0,0" Foreground="{StaticResource Slate600Brush}" Text="{Binding [incident_date_display], StringFormat=Incident Date: {0}}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource BlotterStatusBadgeStyle}" HorizontalAlignment="Center">
                      <TextBlock Style="{StaticResource BlotterStatusTextStyle}" Text="{Binding [status_display]}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Border Width="78" Height="78" CornerRadius="24" Background="#FEF2F2" Margin="0,0,0,14">
              <fa:IconBlock Icon="Gavel" FontSize="30" Foreground="#FCA5A5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Name="emptyLabel" Text="No blotter cases match the current filters." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Border Name="contextActionBar" Grid.Row="4" Visibility="Collapsed" Margin="20,12,20,0" Padding="16" CornerRadius="18" BorderBrush="#FECACA" BorderThickness="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFFFFF" Offset="0" />
          <GradientStop Color="#FFFBF7" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="46" Height="46" CornerRadius="14" Background="#FEF2F2" Margin="0,0,14,0">
            <fa:IconBlock Icon="Gavel" Foreground="#DC2626" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Selected Case" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" Foreground="{StaticResource Slate600Brush}" />
            <TextBlock Name="selectedRecordLabel" Text="BLT-2026-00001" FontFamily="{StaticResource CenturyGothic}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" Margin="0,3,0,0" />
            <TextBlock Name="selectedPartiesLabel" Text="Complainant vs Respondent" Style="{StaticResource BlotterSelectionMetaStyle}" Margin="0,4,0,0" />
            <TextBlock Name="selectedRecordMetaLabel" Text="General | ONGOING | Apr 20, 2026" Style="{StaticResource BlotterSelectionMetaStyle}" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Name="btnEditCase" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,8" Click="BtnEdit_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="FolderOpen" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Open Details" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="btnResolve" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8" Click="BtnEdit_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="CheckCircle" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Resolve / Close" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="btnReferral" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8" Click="BtnEdit_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="ExternalLinkAlt" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Refer Case" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" Click="BtnClearSelection_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Times" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Clear Selection" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </Grid>
    </Border>
    <Border Grid.Row="5" Margin="20,10,20,14" Background="#00FFFFFF" Height="38">
      <Grid>
        <TextBlock Name="footerCountLabel" Text="0 case(s) loaded." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Name="lastRefreshLabel" Text="Last refreshed --" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
          <TextBlock Text="  |  " Style="{StaticResource SmallTextStyle}" Opacity="0.5" />
          <TextBlock Text="System Version 2.0.4 | Professional Edition" Style="{StaticResource SmallTextStyle}" Opacity="0.5" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>