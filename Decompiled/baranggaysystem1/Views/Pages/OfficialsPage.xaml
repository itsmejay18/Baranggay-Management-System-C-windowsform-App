<UserControl x:Class="baranggaysystem1.Views.Pages.OfficialsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="10" Background="#FFFBEB" Margin="0,0,14,0">
            <fa:IconBlock Icon="Star" Foreground="#F59E0B" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Barangay Governance" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="recordCountLabel" Text="Managing active officials and term records." Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="📥 Export CSV" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" MinWidth="110" />
          <Button Content="✚ Add New Official" Style="{StaticResource PrimaryButtonStyle}" MinWidth="160" Click="BtnAdd_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFFFF" CornerRadius="6" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Height="36">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="13" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,6,0" TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
          <ComboBox Height="36" Width="160" Style="{StaticResource StyledComboBoxStyle}" SelectedIndex="0">
            <ComboBoxItem Content="Current Term (2024)" />
            <ComboBoxItem Content="All Terms" />
          </ComboBox>
        </StackPanel>
        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="0" Padding="12,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh Official List" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="#FFFFFFFF" Margin="20,14,20,0" CornerRadius="8" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MainGrid_SelectionChanged" />
        <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <fa:IconBlock Icon="UserShield" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
          <TextBlock Name="emptyLabel" Text="No official records found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Name="contextActionBar" Grid.Row="3" Visibility="Collapsed" Background="{StaticResource Slate100Brush}" Margin="20,10,20,0" Padding="16,10" CornerRadius="8" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <fa:IconBlock Icon="Star" Foreground="#F59E0B" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Text="Actions for: " VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Slate700Brush}" />
          <TextBlock Name="selectedRecordLabel" Text="Hon. Juan Dela Cruz" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" Margin="4,0,20,0" />
          <Button Name="btnEditOfficial" Content="📝 Edit Appointment" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,0" />
          <Button Name="btnTerminate" Content="✕ Terminate Term" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
          <Button Name="btnCertOfService" Content="📜 Issue CSR" Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}" Content="✕" Padding="4" Foreground="{StaticResource Slate400Brush}" Click="BtnClearSelection_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="4" Margin="20,10,20,14" Background="#00FFFFFF" Height="38">
      <Grid>
        <TextBlock Name="footerCountLabel" Text="0 officials registered." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="System Version 2.0.4 • Professional Edition" Style="{StaticResource SmallTextStyle}" Opacity="0.5" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>