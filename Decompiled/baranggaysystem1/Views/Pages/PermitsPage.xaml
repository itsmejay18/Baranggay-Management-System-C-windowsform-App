<UserControl x:Class="baranggaysystem1.Views.Pages.PermitsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="10" Background="#EFF6FF" Margin="0,0,14,0">
            <fa:IconBlock Icon="ShieldAlt" Foreground="#3B82F6" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Permits Queue" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="recordCountLabel" Text="Manage barangay permit requests" Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Name="toolbarPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="+ New Permit" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAdd_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFFFF" CornerRadius="6" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Height="36">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="13" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,6,0" TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="0" Padding="12,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="#FFFFFFFF" Margin="20,14,20,0" CornerRadius="8" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MainGrid_SelectionChanged" />
        <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <fa:IconBlock Icon="ShieldAlt" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
          <TextBlock Name="emptyLabel" Text="No permit requests found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="3" Margin="20,6,20,14" Background="#00FFFFFF">
      <TextBlock Name="footerCountLabel" Text="No records loaded." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>