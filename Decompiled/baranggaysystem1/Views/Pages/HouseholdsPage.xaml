<UserControl x:Class="baranggaysystem1.Views.Pages.HouseholdsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="HouseholdSurfaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="16" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HouseholdHeroChipStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,3,5,0" />
      </Style>
      <Style x:Key="HouseholdHeroChipTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate700Brush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
      </Style>
      <Style x:Key="HouseholdMetricCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource HouseholdSurfaceCardStyle}">
        <Setter Property="Border.Padding" Value="8,6" />
      </Style>
      <Style x:Key="HouseholdMetricLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate500Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="9" />
      </Style>
      <Style x:Key="HouseholdMetricValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
      </Style>
      <Style x:Key="HouseholdSearchShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FCFDFE" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Height" Value="36" />
      </Style>
      <Style x:Key="HouseholdCompactButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="MinWidth" Value="88" />
      </Style>
      <Style x:Key="HouseholdCompactPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="MinWidth" Value="118" />
      </Style>
      <Style x:Key="HouseholdCompactLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Slate600Brush}" />
        <Setter Property="Margin" Value="0,0,0,3" />
      </Style>
      <Style x:Key="HouseholdDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource StyledDataGridColumnHeaderStyle}">
        <Setter Property="Background" Value="#0F172A" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>
      <Style x:Key="HouseholdDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource StyledDataGridRowStyle}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <Trigger Property="DataGridRow.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#FFFCFDFE" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FFF8FAFC" />
          </Trigger>
          <Trigger Property="DataGridRow.IsSelected" Value="True">
            <Setter Property="Background" Value="#FFEFF6FF" />
            <Setter Property="Foreground" Value="#FF1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="HouseholdDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
      </Style>
      <Style x:Key="HouseholdIdBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#EEF2FF" />
        <Setter Property="BorderBrush" Value="#C7D2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="10,4" />
      </Style>
      <Style x:Key="HouseholdPurokBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#ECFDF5" />
        <Setter Property="BorderBrush" Value="#A7F3D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="10,4" />
      </Style>
      <Style x:Key="HouseholdMembersBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="999" />
        <Setter Property="Border.Padding" Value="10,4" />
      </Style>
      <Style x:Key="HouseholdSelectionMetaStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Slate600Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Padding="14,8,14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,10,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DDD6FE" Offset="0" />
                <GradientStop Color="#E0F2FE" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <fa:IconBlock Icon="Home" Foreground="#7C3AED" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Household Registry" Style="{StaticResource HeadingTextStyle}" FontSize="14" />
            <TextBlock Name="recordCountLabel" Text="Loading household registry..." Style="{StaticResource SubtitleTextStyle}" FontSize="10.5" Margin="0,1,0,0" />
            <WrapPanel Margin="0,3,0,0">
              <Border Style="{StaticResource HouseholdHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="Eye" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                  <TextBlock Name="headerVisibleLabel" Text="0 visible now" Style="{StaticResource HouseholdHeroChipTextStyle}" Margin="5,0,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HouseholdHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="MapMarkerAlt" FontSize="10" Foreground="#059669" VerticalAlignment="Center" />
                  <TextBlock Name="headerCoverageLabel" Text="0 puroks covered" Style="{StaticResource HouseholdHeroChipTextStyle}" Margin="5,0,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HouseholdHeroChipStyle}">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="Users" FontSize="10" Foreground="#F59E0B" VerticalAlignment="Center" />
                  <TextBlock Name="headerMembersLabel" Text="0 listed members" Style="{StaticResource HouseholdHeroChipTextStyle}" Margin="5,0,0,0" />
                </StackPanel>
              </Border>
            </WrapPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="btnExportCsv" Style="{StaticResource HouseholdCompactButtonStyle}" Margin="0,0,6,0" MinWidth="94">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="FileExport" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Export CSV" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="New Household" Style="{StaticResource HouseholdCompactPrimaryButtonStyle}" MinWidth="126" Click="BtnAdd_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <WrapPanel Grid.Row="1" Margin="14,6,14,0">
      <Border Style="{StaticResource HouseholdMetricCardStyle}" Width="160" Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="8" Background="#EEF2FF" Margin="0,0,8,0">
            <fa:IconBlock Icon="Home" Foreground="#4F46E5" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Total Households" Style="{StaticResource HouseholdMetricLabelStyle}" />
            <TextBlock Name="totalHouseholdsMetric" Text="0" Style="{StaticResource HouseholdMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource HouseholdMetricCardStyle}" Width="160" Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="8" Background="#E0F2FE" Margin="0,0,8,0">
            <fa:IconBlock Icon="Filter" Foreground="#0284C7" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Visible Results" Style="{StaticResource HouseholdMetricLabelStyle}" />
            <TextBlock Name="visibleHouseholdsMetric" Text="0" Style="{StaticResource HouseholdMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource HouseholdMetricCardStyle}" Width="160" Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="8" Background="#ECFDF5" Margin="0,0,8,0">
            <fa:IconBlock Icon="Users" Foreground="#059669" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Listed Members" Style="{StaticResource HouseholdMetricLabelStyle}" />
            <TextBlock Name="totalMembersMetric" Text="0" Style="{StaticResource HouseholdMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource HouseholdMetricCardStyle}" Width="160">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="8" Background="#FEF3C7" Margin="0,0,8,0">
            <fa:IconBlock Icon="MapMarkedAlt" Foreground="#D97706" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Purok Coverage" Style="{StaticResource HouseholdMetricLabelStyle}" />
            <TextBlock Name="purokCoverageMetric" Text="0" Style="{StaticResource HouseholdMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource HouseholdSurfaceCardStyle}" Margin="14,6,14,0" Padding="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.1*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="1.05*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HouseholdSearchShellStyle}" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="12" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid Column="1">
              <TextBox Name="searchBox" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="11.5" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged" />
              <TextBlock Name="searchPlaceholderText" Text="Search household ID, purok, address, or coordinates" Foreground="{StaticResource Slate400Brush}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,8,0" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </Border>
        <ComboBox Name="purokFilterCombo" Grid.Column="2" Height="34" MinWidth="148" VerticalAlignment="Center" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="PurokFilterCombo_SelectionChanged" />
        <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1" CornerRadius="999" Padding="10,6" VerticalAlignment="Center">
          <WrapPanel VerticalAlignment="Center">
            <fa:IconBlock Icon="InfoCircle" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
            <TextBlock Name="toolbarInsightLabel" Text="Showing the full household registry." FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource Slate800Brush}" Margin="6,0,0,0" VerticalAlignment="Center" />
            <TextBlock Name="activeFilterLabel" Text="Filters: All households and all puroks." Style="{StaticResource SmallTextStyle}" FontSize="9.5" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          </WrapPanel>
        </Border>
        <Button Grid.Column="6" Style="{StaticResource HouseholdCompactButtonStyle}" Height="32" MinWidth="98" Click="BtnClearFilters_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="TimesCircle" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Text="Clear Filters" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="8" Style="{StaticResource HouseholdCompactButtonStyle}" Height="32" MinWidth="0" Padding="10,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh Registry" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource HouseholdSurfaceCardStyle}" Margin="20,14,20,0" Padding="0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FCFDFE" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,0,0,1" Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Registry Table" FontFamily="{StaticResource CenturyGothic}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" />
              <TextBlock Name="tableSummaryLabel" Text="0 result(s) ready for review and household actions." Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999" Padding="10,5" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="InfoCircle" FontSize="11" Foreground="#2563EB" VerticalAlignment="Center" />
                <TextBlock Text=" Select a row to unlock household actions" Style="{StaticResource SmallTextStyle}" Foreground="#1D4ED8" FontWeight="Bold" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid Row="1">
          <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource HouseholdDataGridHeaderStyle}" RowStyle="{StaticResource HouseholdDataGridRowStyle}" CellStyle="{StaticResource HouseholdDataGridCellStyle}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" RowHeight="56" HeadersVisibility="Column" Margin="0" SelectionChanged="MainGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Household" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource HouseholdIdBadgeStyle}" HorizontalAlignment="Left">
                      <TextBlock Foreground="#4338CA" FontWeight="Bold" Text="{Binding [household_id], StringFormat=HH-{0:0000}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Purok" Width="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource HouseholdPurokBadgeStyle}" HorizontalAlignment="Left">
                      <TextBlock Foreground="#047857" FontWeight="Bold" Text="{Binding [purok_display]}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Address" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="28" Height="28" CornerRadius="8" Background="#F8FAFC" Margin="0,0,10,0">
                        <fa:IconBlock Icon="MapMarkerAlt" FontSize="11" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel>
                        <TextBlock Foreground="{StaticResource Slate900Brush}" FontWeight="SemiBold" Text="{Binding [street_display]}" />
                        <TextBlock Text="Registered street address" Style="{StaticResource SmallTextStyle}" Margin="0,2,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Members" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource HouseholdMembersBadgeStyle}" HorizontalAlignment="Center">
                      <TextBlock Foreground="{StaticResource Slate700Brush}" FontWeight="Bold" Text="{Binding [member_count], StringFormat={}{0} member(s)}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Coordinates" Width="180">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource SmallTextStyle}" Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap" Text="{Binding [coordinates_display]}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Updated" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{StaticResource Slate800Brush}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="16" Text="{Binding [updated_display]}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Border Width="74" Height="74" CornerRadius="24" Background="#F8FAFC" Margin="0,0,0,14">
              <fa:IconBlock Icon="Home" FontSize="30" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Name="emptyLabel" Text="No household records found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Border Name="contextActionBar" Grid.Row="4" Visibility="Collapsed" Margin="20,12,20,0" Padding="16" CornerRadius="16" BorderBrush="#DBEAFE" BorderThickness="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFFFFF" Offset="0" />
          <GradientStop Color="#F8FBFF" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="14" Background="#EEF2FF" Margin="0,0,14,0">
            <fa:IconBlock Icon="Home" Foreground="#4F46E5" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Selected Household" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" Foreground="{StaticResource Slate600Brush}" />
            <TextBlock Name="selectedRecordLabel" Text="Household #123" FontFamily="{StaticResource CenturyGothic}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" Margin="0,3,0,0" />
            <TextBlock Name="selectedRecordMetaLabel" Text="Purok 1 | 0 member(s) | No coordinates saved" Style="{StaticResource HouseholdSelectionMetaStyle}" Margin="0,4,0,0" />
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Name="btnEditDetails" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,8" Click="BtnEditDetails_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Edit" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Edit Details" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="btnViewMembers" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,8" Click="BtnEdit_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Users" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Manage Family" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="btnTransferHistory" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,8" Click="BtnTransferHistory_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="History" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Transfer History" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="btnCertificate" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8" Click="BtnCertificate_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="FileAlt" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Household Cert" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="btnTransfer" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8" Click="BtnTransfer_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="ExchangeAlt" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Transfer Family" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="btnDeleteHousehold" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,8" Click="BtnDelete_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="TrashAlt" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Delete Household" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" Click="BtnClearSelection_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Times" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Clear Selection" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </Grid>
    </Border>
    <Border Grid.Row="5" Margin="20,10,20,14" Background="#00FFFFFF" Height="38">
      <Grid>
        <TextBlock Name="footerCountLabel" Text="0 households loaded." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Name="lastRefreshLabel" Text="Last refreshed --" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
          <TextBlock Text="  |  " Style="{StaticResource SmallTextStyle}" Opacity="0.5" />
