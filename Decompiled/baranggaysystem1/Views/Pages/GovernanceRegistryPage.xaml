<UserControl x:Class="baranggaysystem1.Views.Pages.GovernanceRegistryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="24" Height="24" CornerRadius="10" Background="#EFF6FF" Margin="0,0,8,0">
            <fa:IconBlock Icon="Bullhorn" Foreground="#2563EB" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Announcements &amp; Projects" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="recordCountLabel" Text="Manage public notices, projects, and programs from one registry." Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#DBEAFE" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999" Padding="10,6" Margin="0,0,10,0">
            <TextBlock Name="sectionBadgeText" Text="Announcement Registry" Foreground="#1D4ED8" FontWeight="Bold" FontSize="12" />
          </Border>
          <Button Name="btnAddRecord" Content="Create Announcement" Style="{StaticResource PrimaryButtonStyle}" MinWidth="180" Click="BtnAdd_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Row="1" Margin="20,14,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Margin="0,0,10,0" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Total Announcements" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="totalAnnouncementsMetric" Text="0" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="{StaticResource Slate900Brush}" />
          <TextBlock Text="All notice records" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="0,0,10,0" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Published" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="publishedAnnouncementsMetric" Text="0" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="#1D4ED8" />
          <TextBlock Text="Live announcements" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Margin="0,0,10,0" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Pinned Notices" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="pinnedAnnouncementsMetric" Text="0" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="#7C3AED" />
          <TextBlock Text="Prioritized dashboard posts" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Margin="0,0,10,0" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Total Initiatives" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="totalInitiativesMetric" Text="0" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="#0F766E" />
          <TextBlock Text="Projects and programs tracked" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Padding="8,6" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Completed" Style="{StaticResource SmallTextStyle}" />
          <TextBlock Name="completedInitiativesMetric" Text="0" FontSize="13" FontWeight="Bold" Margin="0,6,0,2" Foreground="#166534" />
          <TextBlock Text="Initiatives marked complete" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFFFF" CornerRadius="6" BorderBrush="{StaticResource Slate300Brush}" BorderThickness="1" Height="36">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="13" Foreground="{StaticResource Slate500Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,6,0" TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <ComboBox Name="categoryFilter" Grid.Column="1" Margin="12,0,0,0" Height="36" Width="180" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <ComboBox Name="statusFilter" Grid.Column="2" Margin="8,0,0,0" Height="36" Width="180" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="0" Padding="12,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="#FFFFFFFF" Margin="20,14,20,0" CornerRadius="8" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1" ClipToBounds="True">
      <TabControl Name="governanceTabs" SelectionChanged="GovernanceTabs_SelectionChanged">
        <TabItem Name="announcementTab" Header="Announcements">
          <Grid>
            <DataGrid Name="announcementGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="AnnouncementGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Width="2.2*" Binding="{Binding [title]}" />
                <DataGridTextColumn Header="Priority" Width="1.1*" Binding="{Binding [priority]}" />
                <DataGridTextColumn Header="Status" Width="1.1*" Binding="{Binding [status]}" />
                <DataGridTextColumn Header="Pinned" Width="90" Binding="{Binding [pinned_display]}" />
                <DataGridTextColumn Header="Published" Width="120" Binding="{Binding [created_at_display]}" />
                <DataGridTextColumn Header="Message" Width="2.5*" Binding="{Binding [body_preview_display]}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Name="announcementEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <fa:IconBlock Icon="Bullhorn" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
              <TextBlock Name="announcementEmptyLabel" Text="No announcements found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Name="projectTab" Header="Projects &amp; Programs">
          <Grid>
            <DataGrid Name="projectGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ProjectGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="1.8*" Binding="{Binding [name]}" />
                <DataGridTextColumn Header="Type" Width="100" Binding="{Binding [record_type]}" />
                <DataGridTextColumn Header="Status" Width="120" Binding="{Binding [status]}" />
                <DataGridTextColumn Header="Budget" Width="120" Binding="{Binding [budget_display]}" />
                <DataGridTextColumn Header="Lead" Width="1.3*" Binding="{Binding [lead_display]}" />
                <DataGridTextColumn Header="Schedule" Width="1.4*" Binding="{Binding [schedule_display]}" />
                <DataGridTextColumn Header="Attendance" Width="130" Binding="{Binding [attendance_display]}" />
                <DataGridTextColumn Header="Outcome" Width="1.5*" Binding="{Binding [outcome_display]}" />
                <DataGridTextColumn Header="Last Activity" Width="120" Binding="{Binding [last_activity_display]}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Name="projectEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <fa:IconBlock Icon="Tasks" FontSize="48" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
              <TextBlock Name="projectEmptyLabel" Text="No project or program records found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>
    <Border Name="contextActionBar" Grid.Row="4" Visibility="Collapsed" Background="{StaticResource Slate100Brush}" Margin="20,10,20,0" Padding="16,10" CornerRadius="8" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Name="selectedRecordLabel" Text="No record selected" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" />
          <TextBlock Name="selectedRecordMetaLabel" Text="Select an announcement or initiative record to review it." Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="btnEditSelected" Content="Edit Record" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,0" Click="BtnEditSelected_Click" />
          <Button Name="btnViewSelected" Content="View Details" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="BtnViewSelected_Click" />
          <Button Name="btnDeleteSelected" Content="Delete" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Padding="10,4" Foreground="#B91C1C" Click="BtnDeleteSelected_Click" />
          <Button Content="Clear" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Foreground="{StaticResource Slate500Brush}" Click="BtnClearSelection_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="5" Margin="20,10,20,14" Background="#00FFFFFF" Height="38">
      <Grid>
        <TextBlock Name="footerCountLabel" Text="No registry records loaded." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <TextBlock Name="footerHintLabel" Text="Use this workspace when the dashboard cards are too limited for day-to-day announcement and initiative maintenance." Style="{StaticResource SmallTextStyle}" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
