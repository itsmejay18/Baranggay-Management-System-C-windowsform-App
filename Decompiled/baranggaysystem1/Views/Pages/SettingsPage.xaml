<UserControl x:Class="baranggaysystem1.Views.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="{StaticResource PageBgBrush}" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SettingsTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <Style x:Key="SettingsTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{StaticResource Slate700Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Border Name="tabBorder" Margin="{TemplateBinding FrameworkElement.Margin}" Padding="{TemplateBinding Control.Padding}" Background="#FFFFFFFF" BorderThickness="1" CornerRadius="14" BorderBrush="{StaticResource Slate200Brush}">
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="tabBorder" Property="Border.Background" Value="#E9F2FF" />
                  <Setter TargetName="tabBorder" Property="Border.BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="tabBorder" Property="Border.Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="tabBorder" Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <StackPanel Orientation="Horizontal">
        <Border Width="24" Height="24" CornerRadius="10" Background="{StaticResource Slate100Brush}" Margin="0,0,8,0">
          <fa:IconBlock Icon="Cog" Foreground="{StaticResource Slate700Brush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="System Settings" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20,24,32" MaxWidth="960" HorizontalAlignment="Left">
        <TabControl Style="{StaticResource SettingsTabControlStyle}">
          <TabItem Header="Branding" Style="{StaticResource SettingsTabItemStyle}">
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,18,0,20">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="System Name" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtSystemName" Style="{StaticResource StyledTextBoxStyle}" Height="40" Margin="0,0,0,16" />
                    <TextBlock Text="Barangay Name" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtBarangayName" Style="{StaticResource StyledTextBoxStyle}" Height="40" Margin="0,0,0,16" />
                    <TextBlock Text="Municipality" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtMunicipality" Style="{StaticResource StyledTextBoxStyle}" Height="40" Margin="0,0,0,16" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Province" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                        <TextBox Name="txtProvince" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Region" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                        <TextBox Name="txtRegion" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,20,0,0">
                      <Button Name="btnSaveBranding" Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="140" Margin="0,0,10,0" Click="BtnSaveBranding_Click" />
                      <Button Name="btnResetBranding" Content="Restore Defaults" Style="{StaticResource GhostButtonStyle}" Width="150" Click="BtnResetBranding_Click" />
                    </WrapPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Logo" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <Border Width="170" Height="170" CornerRadius="16" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" HorizontalAlignment="Left">
                      <Grid>
                        <Image Name="logoPreview" Stretch="Uniform" Margin="10" Visibility="Collapsed" />
                        <StackPanel Name="logoPreviewFallback" VerticalAlignment="Center">
                          <fa:IconBlock Icon="Image" FontSize="40" Foreground="{StaticResource Slate300Brush}" HorizontalAlignment="Center" />
                          <TextBlock Text="NO LOGO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Slate400Brush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Button Name="btnUploadLogo" Content="Upload" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,8" Width="150" Click="BtnUploadLogo_Click" />
                    <Button Name="btnRemoveLogo" Content="Remove" Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource AccentRedBrush}" Width="150" Click="BtnRemoveLogo_Click" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </TabItem>
          <TabItem Header="Office" Style="{StaticResource SettingsTabItemStyle}">
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,18,0,20">
              <StackPanel>
                <TextBlock Text="Office Address" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                <TextBox Name="txtOfficeAddress" Style="{StaticResource StyledTextBoxStyle}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,16" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Contact Number" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtContactNumber" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Email" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtOfficialEmail" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,20,0,0">
                  <Button Name="btnSaveOfficeSettings" Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="140" Margin="0,0,10,0" Click="BtnSaveOfficeSettings_Click" />
                  <Button Name="btnResetOfficeSettings" Content="Clear" Style="{StaticResource GhostButtonStyle}" Width="140" Click="BtnResetOfficeSettings_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </TabItem>
          <TabItem Header="Database" Style="{StaticResource SettingsTabItemStyle}">
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,18,0,20">
              <StackPanel>
                <TextBlock Text="Connection Profile" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                <ComboBox Name="cmbConnectionProfile" Style="{StaticResource StyledComboBoxStyle}" Height="40" Width="300" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="CmbConnectionProfile_SelectionChanged" />
                <TextBlock Name="lblConnectionProfileDescription" Text="" Style="{StaticResource SmallTextStyle}" Margin="0,0,0,18" TextWrapping="Wrap" />
                <Grid Name="pnlMySqlConnectionFields">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Host" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtDbHost" Style="{StaticResource StyledTextBoxStyle}" Height="40" Margin="0,0,0,16" />
                    <TextBlock Text="User" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtDbUser" Style="{StaticResource StyledTextBoxStyle}" Height="40" Margin="0,0,0,16" />
                    <TextBlock Text="Password" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <PasswordBox Name="txtDbPassword" Style="{StaticResource StyledPasswordBoxStyle}" Height="40" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Port" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtDbPort" Style="{StaticResource StyledTextBoxStyle}" Height="40" Margin="0,0,0,16" />
                    <TextBlock Text="Database" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtDbName" Style="{StaticResource StyledTextBoxStyle}" Height="40" Margin="0,0,0,16" />
                    <CheckBox Name="chkDbUseSsl" Content="Use SSL" VerticalAlignment="Center" Margin="0,12,0,0" />
                  </StackPanel>
                </Grid>
                <Border Name="pnlSqliteDetails" Margin="0,0,0,4" Background="#F8FAFC" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="14" Padding="16" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="SQLite File" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                    <TextBox Name="txtSqlitePath" Style="{StaticResource StyledTextBoxStyle}" Height="40" IsReadOnly="True" />
                  </StackPanel>
                </Border>
                <WrapPanel Margin="0,20,0,0">
                  <Button Name="btnTestConnection" Content="Test" Style="{StaticResource SecondaryButtonStyle}" Width="130" Margin="0,0,10,0" Click="BtnTestConnection_Click" />
                  <Button Name="btnSaveConnection" Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="130" Margin="0,0,10,0" Background="#8B5CF6" BorderBrush="#8B5CF6" Click="BtnSaveConnection_Click" />
                  <Button Name="btnResetConnection" Content="Reset" Style="{StaticResource GhostButtonStyle}" Width="130" Click="BtnResetConnection_Click" />
                </WrapPanel>
                <Border Margin="0,24,0,0" Background="#F8FAFC" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="16" Padding="18">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                      <fa:IconBlock Icon="Save" Foreground="#0F766E" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                      <TextBlock Text="Backup and Restore" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                      </Grid.ColumnDefinitions>
                      <WrapPanel Grid.Column="0">
                        <Button Name="btnRunFullBackup" Content="Full" Style="{StaticResource PrimaryButtonStyle}" Width="120" Margin="0,0,10,10" Click="BtnRunFullBackup_Click" />
                        <Button Name="btnRunIncrementalBackup" Content="Incremental" Style="{StaticResource SecondaryButtonStyle}" Width="130" Margin="0,0,10,10" Click="BtnRunIncrementalBackup_Click" />
                        <Button Name="btnRunDifferentialBackup" Content="Differential" Style="{StaticResource SecondaryButtonStyle}" Width="130" Margin="0,0,10,10" Click="BtnRunDifferentialBackup_Click" />
                        <Button Name="btnOpenBackupFolder" Content="Open Folder" Style="{StaticResource GhostButtonStyle}" Width="140" Margin="0,0,10,10" Click="BtnOpenBackupFolder_Click" />
                        <Button Name="btnRestoreBackup" Content="Restore" Style="{StaticResource GhostButtonStyle}" Width="140" Margin="0,0,0,10" Click="BtnRestoreBackup_Click" />
                      </WrapPanel>
                      <Border Grid.Column="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel>
                          <TextBlock Text="Latest Backup" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" />
                          <TextBlock Name="lblBackupSummary" Text="—" Style="{StaticResource SmallTextStyle}" Margin="0,8,0,0" FontWeight="Bold" TextWrapping="Wrap" />
                          <TextBlock Name="lblBackupMeta" Text="" Style="{StaticResource SmallTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                          <TextBlock Name="lblBackupDirectory" Text="" Style="{StaticResource SmallTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </TabItem>
        </TabControl>
        <Border Background="#F8FAFC" CornerRadius="12" Padding="20" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Name="lblBrandingSummary" Text="" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" />
              <TextBlock Name="lblConnectionSummary" Text="" Style="{StaticResource SmallLightTextStyle}" Margin="0,4,0,0" />
              <TextBlock Name="lblConnectionModeSummary" Text="" Style="{StaticResource SmallLightTextStyle}" Margin="0,4,0,0" />
              <TextBlock Name="lblEnvironmentSummary" Text="" Visibility="Collapsed" />
              <TextBlock Name="lblLogoSummary" Text="" Visibility="Collapsed" />
            </StackPanel>
            <fa:IconBlock Grid.Column="1" Icon="CheckCircle" Foreground="#22C55E" FontSize="28" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
