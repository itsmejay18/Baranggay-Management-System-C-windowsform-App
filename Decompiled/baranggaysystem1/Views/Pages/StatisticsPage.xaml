<UserControl x:Class="baranggaysystem1.Views.Pages.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             Background="{StaticResource PageBgBrush}">
  <UserControl.Resources>
    <Style x:Key="KpiBorder" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Direction="270" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="KpiValue" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
    </Style>
    <Style x:Key="KpiLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Slate500Brush}" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="SectionCard" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Slate900Brush}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- A simple horizontal bar row used for all category charts -->
    <DataTemplate x:Key="BarRowTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Slate700Brush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1" Background="{StaticResource Slate100Brush}" Height="14"
                CornerRadius="7" VerticalAlignment="Center">
          <Grid HorizontalAlignment="Stretch">
            <Border Background="#4F46E5" HorizontalAlignment="Left" CornerRadius="7"
                    Width="{Binding BarWidth}" Height="14" />
          </Grid>
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat=N0}" FontSize="11"
                   FontWeight="Bold" Foreground="{StaticResource Slate900Brush}"
                   VerticalAlignment="Center" Margin="10,0,0,0" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="10" Background="#EEF2FF" Margin="0,0,14,0">
            <fa:IconBlock Icon="ChartBar" Foreground="#4F46E5" FontSize="20"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Statistics" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="lblUpdatedAt" Text="Loading statistics..."
                       Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="Export CSV" Style="{StaticResource GhostButtonStyle}"
                MinWidth="110" Margin="0,0,8,0" Click="BtnExport_Click" />
        <Button Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                MinWidth="120" Click="BtnRefresh_Click" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,14,20,24">

        <!-- PRIMARY KPI ROW -->
        <TextBlock Text="Community" Style="{StaticResource SectionTitle}" />
        <WrapPanel>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valResidents" Text="0" Style="{StaticResource KpiValue}" />
              <TextBlock Text="Total Residents" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valActive" Text="0" Style="{StaticResource KpiValue}" Foreground="#16A34A" />
              <TextBlock Text="Active" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valHouseholds" Text="0" Style="{StaticResource KpiValue}" />
              <TextBlock Text="Households" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valPuroks" Text="0" Style="{StaticResource KpiValue}" />
              <TextBlock Text="Active Puroks" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valMale" Text="0" Style="{StaticResource KpiValue}" Foreground="#2563EB" />
              <TextBlock Text="Male" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valFemale" Text="0" Style="{StaticResource KpiValue}" Foreground="#DB2777" />
              <TextBlock Text="Female" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valDeceased" Text="0" Style="{StaticResource KpiValue}" Foreground="{StaticResource Slate500Brush}" />
              <TextBlock Text="Deceased" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
        </WrapPanel>

        <!-- CLASSIFICATIONS ROW -->
        <TextBlock Text="Classifications" Style="{StaticResource SectionTitle}" Margin="0,10,0,12" />
        <WrapPanel>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valSeniors" Text="0" Style="{StaticResource KpiValue}" Foreground="#D97706" />
              <TextBlock Text="Seniors" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valYouth" Text="0" Style="{StaticResource KpiValue}" Foreground="#7C3AED" />
              <TextBlock Text="Youth" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valPwd" Text="0" Style="{StaticResource KpiValue}" Foreground="#059669" />
              <TextBlock Text="PWD" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valSoloParents" Text="0" Style="{StaticResource KpiValue}" Foreground="#DB2777" />
              <TextBlock Text="Solo Parents" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valIndigent" Text="0" Style="{StaticResource KpiValue}" Foreground="#B91C1C" />
              <TextBlock Text="Indigent" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="val4Ps" Text="0" Style="{StaticResource KpiValue}" Foreground="#0EA5E9" />
              <TextBlock Text="4Ps Beneficiaries" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valVoters" Text="0" Style="{StaticResource KpiValue}" Foreground="#0F766E" />
              <TextBlock Text="Registered Voters" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
        </WrapPanel>

        <!-- OPERATIONS ROW -->
        <TextBlock Text="Operations" Style="{StaticResource SectionTitle}" Margin="0,10,0,12" />
        <WrapPanel>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valPendingCerts" Text="0" Style="{StaticResource KpiValue}" Foreground="#D97706" />
              <TextBlock Text="Pending Certificates" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valReleasedCerts" Text="0" Style="{StaticResource KpiValue}" Foreground="#16A34A" />
              <TextBlock Text="Released This Month" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valOpenBlotter" Text="0" Style="{StaticResource KpiValue}" Foreground="#B91C1C" />
              <TextBlock Text="Open Blotter" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valResolvedBlotter" Text="0" Style="{StaticResource KpiValue}" Foreground="#16A34A" />
              <TextBlock Text="Resolved Cases" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valMeetings" Text="0" Style="{StaticResource KpiValue}" Foreground="#4F46E5" />
              <TextBlock Text="Upcoming Meetings" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valBookings" Text="0" Style="{StaticResource KpiValue}" Foreground="#059669" />
              <TextBlock Text="Pending Bookings" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valShiftsToday" Text="0" Style="{StaticResource KpiValue}" Foreground="#DC2626" />
              <TextBlock Text="Shifts Today" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valPatrolLogs" Text="0" Style="{StaticResource KpiValue}" Foreground="#EA580C" />
              <TextBlock Text="Patrol Logs (7d)" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valRevenue" Text="₱0.00" Style="{StaticResource KpiValue}" Foreground="#15803D" />
              <TextBlock Text="Revenue (Month)" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource KpiBorder}">
            <StackPanel>
              <TextBlock Name="valAyuda" Text="0" Style="{StaticResource KpiValue}" Foreground="#8B5CF6" />
              <TextBlock Text="Ayuda Released (Month)" Style="{StaticResource KpiLabel}" />
            </StackPanel>
          </Border>
        </WrapPanel>

        <!-- CHARTS -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Text="Residents by Purok" Style="{StaticResource SectionTitle}" />
              <ItemsControl Name="chartPurok" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyPurok" Text="No data yet." FontSize="11"
                         Foreground="{StaticResource Slate400Brush}" Visibility="Collapsed"
                         HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Text="Residents by Age Bracket" Style="{StaticResource SectionTitle}" />
              <ItemsControl Name="chartAge" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyAge" Text="No data yet." FontSize="11"
                         Foreground="{StaticResource Slate400Brush}" Visibility="Collapsed"
                         HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Text="Blotter by Incident Type" Style="{StaticResource SectionTitle}" />
              <ItemsControl Name="chartBlotter" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyBlotter" Text="No data yet." FontSize="11"
                         Foreground="{StaticResource Slate400Brush}" Visibility="Collapsed"
                         HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Text="Certificates Requested by Type" Style="{StaticResource SectionTitle}" />
              <ItemsControl Name="chartCerts" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyCerts" Text="No data yet." FontSize="11"
                         Foreground="{StaticResource Slate400Brush}" Visibility="Collapsed"
                         HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Text="Bookings by Facility" Style="{StaticResource SectionTitle}" />
              <ItemsControl Name="chartBookings" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyBookings" Text="No data yet." FontSize="11"
                         Foreground="{StaticResource Slate400Brush}" Visibility="Collapsed"
                         HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SectionCard}">
            <StackPanel>
              <TextBlock Text="Patrol Logs by Severity" Style="{StaticResource SectionTitle}" />
              <ItemsControl Name="chartSeverity" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptySeverity" Text="No data yet." FontSize="11"
                         Foreground="{StaticResource Slate400Brush}" Visibility="Collapsed"
                         HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="Certificate Volume - Last 6 Months" Style="{StaticResource SectionTitle}" />
            <ItemsControl Name="chartTrend" ItemTemplate="{StaticResource BarRowTemplate}" />
            <TextBlock Name="emptyTrend" Text="No data yet." FontSize="11"
                       Foreground="{StaticResource Slate400Brush}" Visibility="Collapsed"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
