<UserControl x:Class="baranggaysystem1.Views.Pages.HomeLandingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="MetroHeaderTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource CenturyGothic}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="MetroHeaderBodyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource TrebuchetMs}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#C8D3E0" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="MetroTileEyebrowStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource TrebuchetMs}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#E8EFF8" />
      </Style>
      <Style x:Key="MetroTileTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource CenturyGothic}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="MetroTileBodyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource TrebuchetMs}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#D8E0EA" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="MetroMetricValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource CenturyGothic}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <ControlTemplate x:Key="MetroTileTemplate" TargetType="{x:Type Button}">
        <Border Name="tileBorder" Background="{TemplateBinding Control.Background}" BorderBrush="#233042" BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True">
          <Grid>
            <Rectangle Height="2" VerticalAlignment="Top" Fill="#18FFFFFF" />
            <ContentPresenter Margin="{TemplateBinding Control.Padding}" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="tileBorder" Property="Border.BorderBrush" Value="#4B607A" />
            <Setter TargetName="tileBorder" Property="UIElement.Opacity" Value="0.96" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="tileBorder" Property="UIElement.Opacity" Value="0.84" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="tileBorder" Property="UIElement.Opacity" Value="0.42" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="MetroTileButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource MetroTileTemplate}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#0F1724">
    <Grid.RowDefinitions>
      <RowDefinition Height="108" />
      <RowDefinition Height="76" />
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.9*" />
        <ColumnDefinition Width="1.1*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#121A2A" BorderBrush="#243142" BorderThickness="0,0,1,1">
        <Grid Margin="26,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="74" Height="74" CornerRadius="8" Background="#0E1421" BorderBrush="#273244" BorderThickness="1" VerticalAlignment="Center">
            <Grid>
              <Ellipse Width="42" Height="42" Fill="#1D991B1B" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Name="workspaceLogoImage" Width="52" Height="52" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <fa:IconBlock Name="workspaceLogoFallback" Icon="University" FontSize="30" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Barangay Operations Workspace" Style="{StaticResource MetroHeaderTitleStyle}" />
            <TextBlock Name="lblWorkspaceSubtitle" Text="Resident, document, and case services in one control board." Margin="0,6,0,0" Style="{StaticResource MetroHeaderBodyStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A2434" Offset="0" />
            <GradientStop Color="#AA1F24" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Border BorderBrush="#243142" BorderThickness="0,0,0,1">
          <Grid Margin="24,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="#1BF7E8E8" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20,12" VerticalAlignment="Center" HorizontalAlignment="Left">
              <StackPanel>
                <TextBlock Name="lblSessionTitle" Text="System Administrator" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource TrebuchetMs}" />
                <TextBlock Name="lblSessionSubtext" Text="Online" Margin="0,6,0,0" Foreground="#FDECEC" FontSize="13" FontFamily="{StaticResource TrebuchetMs}" />
              </StackPanel>
            </Border>
            <Grid Column="1" Width="76" Height="76" Margin="18,0,0,0" VerticalAlignment="Center">
              <Border Background="#164780D9" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="18">
                <fa:IconBlock Icon="Bell" FontSize="28" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Width="28" Height="28" CornerRadius="14" Background="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                <TextBlock Name="txtTopBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="#182332" BorderBrush="#243142" BorderThickness="0,0,0,1" />
    <Border Grid.Row="2" Background="#202B3C" BorderBrush="#243142" BorderThickness="0,0,0,1" />
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <Grid MinWidth="1280" Margin="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="172" />
          <RowDefinition Height="172" />
          <RowDefinition Height="172" />
        </Grid.RowDefinitions>
        <Button Name="tileDashboard" Grid.Row="0" Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#1D4ED8" Click="TileDashboard_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="ChartPie" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Dashboard" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Alerts, KPIs, and quick actions." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tileResidents" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#232D3D" Click="TileResidents_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="Users" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Residents" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Name="txtResidentFootnote" Text="Resident files and account records." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tileHouseholds" Grid.Row="0" Grid.Column="2" Style="{StaticResource MetroTileButtonStyle}" Background="#059669" Click="TileHouseholds_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="Home" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Households" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Name="txtHouseholdFootnote" Text="Family groups and address records." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tileClearances" Grid.Row="0" Grid.Column="3" Style="{StaticResource MetroTileButtonStyle}" Background="#2563EB" Click="TileClearances_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="Scroll" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Clearances" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Certificates and document requests." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tileGovernance" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource MetroTileButtonStyle}" Background="#0E1A2A" Click="TileGovernance_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="126" Height="126" VerticalAlignment="Center">
              <Border Background="#10243A" BorderBrush="#37526B" BorderThickness="1" CornerRadius="16">
                <fa:IconBlock Icon="ShieldAlt" FontSize="68" Foreground="#8FD0FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Control Desk" Style="{StaticResource MetroTileEyebrowStyle}" />
              <TextBlock Text="Announcements &amp; Projects" Margin="0,10,0,0" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Community updates, projects, and barangay operations registry." Margin="0,12,0,0" MaxWidth="310" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="1" Background="#121A2A" BorderBrush="#233042" BorderThickness="1" CornerRadius="2">
          <Grid Margin="28">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Name="lblHeroGreeting" Text="Good morning" FontSize="15" FontWeight="SemiBold" Foreground="#E5E7EB" FontFamily="{StaticResource TrebuchetMs}" />
            <TextBlock Name="lblHugeDate" Grid.Row="1" Text="Tuesday, 28 April 2026" Margin="0,18,0,0" FontSize="44" Foreground="#FFFFFFFF" FontFamily="{StaticResource CenturyGothic}" FontWeight="Bold" />
            <TextBlock Name="lblHeroClock" Grid.Row="2" Text="11:01:12 AM" Margin="0,28,0,0" FontSize="26" Foreground="#FFFFFFFF" FontFamily="{StaticResource TrebuchetMs}" FontWeight="SemiBold" />
          </Grid>
        </Border>
        <Button Name="tileBlotter" Grid.Row="1" Grid.Column="3" Style="{StaticResource MetroTileButtonStyle}" Background="#2E3949" Click="TileBlotter_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="BalanceScale" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Blotter" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Cases, incidents, and mediation." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Border Name="tileHealth" Grid.Row="1" Grid.Column="4" Margin="1" Background="#059669" BorderBrush="#233042" BorderThickness="1" CornerRadius="2">
          <Grid Margin="24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="DATABASE" Style="{StaticResource MetroTileEyebrowStyle}" />
            <TextBlock Grid.Row="1" Text="CONNECTED" FontSize="26" FontWeight="Bold" Foreground="#FFFFFFFF" FontFamily="{StaticResource CenturyGothic}" VerticalAlignment="Center" />
            <TextBlock Name="txtConnectedFooter" Grid.Row="2" Text="Native WPF service layer ready." Style="{StaticResource MetroTileBodyStyle}" />
          </Grid>
        </Border>
        <Button Name="tilePayments" Grid.Row="1" Grid.Column="5" Style="{StaticResource MetroTileButtonStyle}" Background="#2563EB" Click="TilePayments_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="CreditCard" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Payments" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Name="txtPaymentsFootnote" Text="Balances and receipts." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tileOfficials" Grid.Row="2" Grid.Column="0" Style="{StaticResource MetroTileButtonStyle}" Background="#C81E1E" Click="TileOfficials_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="UserTie" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Officials" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Council and office roster." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tileSettings" Grid.Row="2" Grid.Column="1" Style="{StaticResource MetroTileButtonStyle}" Background="#D97706" Click="TileSettings_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="Cog" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Settings" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="System configuration." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tilePermissions" Grid.Row="2" Grid.Column="2" Style="{StaticResource MetroTileButtonStyle}" Background="#49566A" Click="TilePermissions_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="Key" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Access" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Roles and permissions." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tilePending" Grid.Row="2" Grid.Column="3" Style="{StaticResource MetroTileButtonStyle}" Background="#E52323" Click="TilePending_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
              <fa:IconBlock Icon="CalendarAlt" FontSize="40" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
              <TextBlock Name="txtPendingCount" Text="0" Margin="12,0,0,0" Style="{StaticResource MetroMetricValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Pending" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Awaiting review." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tileCollections" Grid.Row="2" Grid.Column="4" Style="{StaticResource MetroTileButtonStyle}" Background="#D87B00" Click="TileCollections_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
              <fa:IconBlock Icon="Wallet" FontSize="40" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
              <TextBlock Name="txtRevenueValue" Text="P0.00" Margin="12,0,0,0" Style="{StaticResource MetroMetricValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Finance" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Collected this month." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="tileExit" Grid.Row="2" Grid.Column="5" Style="{StaticResource MetroTileButtonStyle}" Background="#E52323" Click="TileExit_Click">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <fa:IconBlock Icon="SignOutAlt" FontSize="54" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock Text="Exit" Style="{StaticResource MetroTileTitleStyle}" />
              <TextBlock Text="Close the app." Margin="0,14,0,0" Style="{StaticResource MetroTileBodyStyle}" />
            </StackPanel>
          </Grid>
        </Button>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>