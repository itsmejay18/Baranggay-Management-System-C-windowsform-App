<Window x:Class="baranggaysystem1.Views.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="450"
        ResizeMode="NoResize"
        Background="#FF1a1a2e">

    <Grid Margin="32">
        <StackPanel>
            <!-- Title -->
            <TextBlock Text="Forgot Password"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,8" />

            <TextBlock Text="Answer your security questions to reset your password."
                       FontSize="13"
                       Foreground="#8899A6"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <!-- Username -->
            <TextBlock Text="Username" FontSize="12" Foreground="#AAB8C2" Margin="0,0,0,4" />
            <TextBox x:Name="usernameBox"
                     FontSize="14"
                     Padding="10,8"
                     Background="#FF2d2d44"
                     Foreground="White"
                     BorderBrush="#FF5c5c8a"
                     Margin="0,0,0,12"
                     TextChanged="UsernameBox_TextChanged" />

            <!-- Security Questions Panel (shown after username lookup) -->
            <StackPanel x:Name="questionsPanel" Visibility="Collapsed">
                <TextBlock x:Name="question1Label"
                           Text="Security Question 1:"
                           FontSize="12"
                           Foreground="#AAB8C2"
                           Margin="0,0,0,4" />
                <TextBox x:Name="answer1Box"
                         FontSize="14"
                         Padding="10,8"
                         Background="#FF2d2d44"
                         Foreground="White"
                         BorderBrush="#FF5c5c8a"
                         Margin="0,0,0,12" />

                <TextBlock x:Name="question2Label"
                           Text="Security Question 2:"
                           FontSize="12"
                           Foreground="#AAB8C2"
                           Margin="0,0,0,4"
                           Visibility="Collapsed" />
                <TextBox x:Name="answer2Box"
                         FontSize="14"
                         Padding="10,8"
                         Background="#FF2d2d44"
                         Foreground="White"
                         BorderBrush="#FF5c5c8a"
                         Margin="0,0,0,12"
                         Visibility="Collapsed" />
            </StackPanel>

            <!-- No questions message -->
            <TextBlock x:Name="noQuestionsLabel"
                       Text="No security questions set up for this account. Please contact an administrator."
                       FontSize="12"
                       Foreground="#FF6B6B"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />

            <!-- Result message -->
            <Border x:Name="resultPanel"
                    Background="#FF2d4a2d"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="resultLabel"
                               Text=""
                               FontSize="13"
                               Foreground="#4CAF50"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="tempPasswordLabel"
                               Text=""
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,8,0,0"
                               FontFamily="Consolas" />
                </StackPanel>
            </Border>

            <!-- Error message -->
            <TextBlock x:Name="errorLabel"
                       Text=""
                       FontSize="12"
                       Foreground="#FF6B6B"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="lookupButton"
                        Content="Look Up"
                        Click="LookupButton_Click"
                        Padding="20,8"
                        FontSize="13"
                        Background="#3498db"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0" />

                <Button x:Name="resetButton"
                        Content="Reset Password"
                        Click="ResetButton_Click"
                        Padding="20,8"
                        FontSize="13"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Margin="0,0,8,0" />

                <Button Content="Close"
                        Click="CloseButton_Click"
                        Padding="20,8"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="#AAB8C2"
                        BorderBrush="#5c5c8a"
                        BorderThickness="1"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
