<Window x:Class="baranggaysystem1.Views.SecurityQuestionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Up Security Questions"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        Background="#FF1a1a2e">

    <Grid Margin="32">
        <StackPanel>
            <TextBlock Text="Security Questions"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,8" />
            <TextBlock Text="Set up security questions to enable self-service password reset."
                       FontSize="13"
                       Foreground="#8899A6"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <!-- Question 1 -->
            <TextBlock Text="Security Question 1 *" FontSize="12" Foreground="#AAB8C2" Margin="0,0,0,4" />
            <ComboBox x:Name="question1Combo"
                      FontSize="13"
                      Padding="8,6"
                      Background="#FF2d2d44"
                      Foreground="White"
                      Margin="0,0,0,8">
                <ComboBoxItem Content="What is your mother's maiden name?" />
                <ComboBoxItem Content="What was the name of your first pet?" />
                <ComboBoxItem Content="What city were you born in?" />
                <ComboBoxItem Content="What is your favorite food?" />
                <ComboBoxItem Content="What was the name of your elementary school?" />
                <ComboBoxItem Content="What is your childhood nickname?" />
            </ComboBox>

            <TextBlock Text="Answer 1 *" FontSize="12" Foreground="#AAB8C2" Margin="0,0,0,4" />
            <PasswordBox x:Name="answer1Box"
                         FontSize="14"
                         Padding="10,8"
                         Background="#FF2d2d44"
                         Foreground="White"
                         BorderBrush="#FF5c5c8a"
                         Margin="0,0,0,16" />

            <!-- Question 2 (optional) -->
            <TextBlock Text="Security Question 2 (optional)" FontSize="12" Foreground="#AAB8C2" Margin="0,0,0,4" />
            <ComboBox x:Name="question2Combo"
                      FontSize="13"
                      Padding="8,6"
                      Background="#FF2d2d44"
                      Foreground="White"
                      Margin="0,0,0,8">
                <ComboBoxItem Content="(None)" IsSelected="True" />
                <ComboBoxItem Content="What is your favorite movie?" />
                <ComboBoxItem Content="What street did you grow up on?" />
                <ComboBoxItem Content="What was your first job?" />
                <ComboBoxItem Content="What is your favorite book?" />
                <ComboBoxItem Content="What is the name of your best friend?" />
            </ComboBox>

            <TextBlock Text="Answer 2" FontSize="12" Foreground="#AAB8C2" Margin="0,0,0,4" />
            <PasswordBox x:Name="answer2Box"
                         FontSize="14"
                         Padding="10,8"
                         Background="#FF2d2d44"
                         Foreground="White"
                         BorderBrush="#FF5c5c8a"
                         Margin="0,0,0,16" />

            <!-- Status -->
            <TextBlock x:Name="statusLabel"
                       Text=""
                       FontSize="12"
                       Foreground="#4CAF50"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"
                        Click="SaveButton_Click"
                        Padding="20,8"
                        FontSize="13"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0" />
                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Padding="20,8"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="#AAB8C2"
                        BorderBrush="#5c5c8a"
                        BorderThickness="1"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
