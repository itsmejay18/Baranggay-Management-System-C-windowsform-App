<Window x:Class="baranggaysystem1.Views.RegisterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:baranggaysystem1.ViewModels" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Barangay Management System - Register" MinWidth="1000" MinHeight="700" WindowState="Maximized" WindowStartupLocation="CenterScreen" Style="{StaticResource BaseWindowStyle}" Background="{StaticResource Slate50Brush}" UseLayoutRounding="True" xmlns:views="clr-namespace:baranggaysystem1.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="RegisterAccentBrush" Color="#173A6A" />
      <SolidColorBrush x:Key="RegisterStageBrush" Color="#EFF5FC" />
      <SolidColorBrush x:Key="RegisterOutlineBrush" Color="#D8E3F0" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.DataContext>
    <vm:RegisterViewModel />
  </FrameworkElement.DataContext>
  <Grid Margin="24">
    <Border CornerRadius="24" Background="#FFFFFFFF" BorderBrush="{StaticResource RegisterOutlineBrush}" BorderThickness="1">
      <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.08*" />
          <ColumnDefinition Width="0.92*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0F2B57" Padding="56,48">
          <Grid>
            <Rectangle Width="360" Height="360" RadiusX="180" RadiusY="180" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-160,0" />
            <Rectangle Width="260" Height="260" RadiusX="130" RadiusY="130" Fill="#12FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-140,0,0,-140" />
            <StackPanel MaxWidth="380" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Grid Width="188" Height="188" Margin="0,0,0,28">
                <Ellipse Fill="#F7FAFF" Opacity="0.97">
                  <UIElement.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Color="#08203F" Opacity="0.18" />
                  </UIElement.Effect>
                </Ellipse>
                <Grid>
                  <UIElement.Clip>
                    <EllipseGeometry Center="94,94" RadiusX="94" RadiusY="94" />
                  </UIElement.Clip>
                  <Image Name="logoImage" Margin="8" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                  <StackPanel Name="logoFallback" VerticalAlignment="Center">
                    <fa:IconBlock Icon="University" Foreground="{StaticResource RegisterAccentBrush}" FontSize="56" HorizontalAlignment="Center" />
                    <TextBlock Name="logoFallbackText" Text="BMS" Foreground="{StaticResource RegisterAccentBrush}" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Margin="0,8,0,0" />
                  </StackPanel>
                </Grid>
              </Grid>
              <TextBlock Text="OFFICE PROFILE" FontSize="12" FontWeight="SemiBold" Foreground="#B9CBE3" HorizontalAlignment="Center" Margin="0,0,0,18" />
              <TextBlock Name="brandPrimaryText" Text="Local Government of Barangay San Jose" FontSize="30" FontWeight="Bold" Foreground="#FFFFFFFF" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10" />
              <TextBlock Name="brandSecondaryText" Text="Barangay San Jose | Province" FontSize="15" Foreground="#D7E3F3" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Name="brandAddressText" Text="Office address" FontSize="13" Foreground="#B4C4DB" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30" />
              <Border Height="1" Width="280" Background="#24FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,24" />
              <TextBlock Text="Create staff access, assign roles, and keep onboarding in one secure desktop workspace." FontSize="14" Foreground="#DCE7F5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#F9FBFE" Offset="0" />
              <GradientStop Color="#EDF4FB" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Ellipse Width="340" Height="340" Fill="#A6FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-130,0" />
            <Ellipse Width="220" Height="220" Fill="#6ED8E6F8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-80,0,0,-80" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="0,24">
                <Border Width="390" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFFFFFF" BorderBrush="{StaticResource RegisterOutlineBrush}" BorderThickness="1" CornerRadius="20">
                  <UIElement.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="10" Color="#203C63" Opacity="0.14" />
                  </UIElement.Effect>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource RegisterAccentBrush}" CornerRadius="20,20,0,0" Padding="18,12">
                      <TextBlock Text="Employee Registration" Foreground="#FFFFFFFF" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                    <Grid Row="1" Margin="28,24,28,28">
                      <StackPanel>
                        <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,12">
                          <Ellipse Fill="#F8FBFF" />
                          <Grid>
                            <UIElement.Clip>
                              <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" />
                            </UIElement.Clip>
                            <Image Name="rightLogoImage" Margin="8" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                            <StackPanel Name="rightLogoFallback" VerticalAlignment="Center">
                              <fa:IconBlock Icon="University" Foreground="{StaticResource RegisterAccentBrush}" FontSize="32" HorizontalAlignment="Center" />
                              <TextBlock Name="rightLogoFallbackText" Text="BMS" Foreground="{StaticResource RegisterAccentBrush}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                          </Grid>
                        </Grid>
                        <TextBlock Name="softwareNameText" Text="Barangay Management System" FontSize="19" FontWeight="Bold" Foreground="{StaticResource RegisterAccentBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Name="softwareSubtitleText" Text="Create staff access for Barangay San Jose" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock Text="Create a new staff account and assign the right role before the employee signs in." FontSize="11" Foreground="{StaticResource Slate500Brush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18" />
                        <Border Background="#F8FBFF" BorderBrush="{StaticResource RegisterOutlineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" ClipToBounds="True" Background="#FFFFFFFF" BorderBrush="{StaticResource RegisterOutlineBrush}" BorderThickness="1" Margin="0,0,14,0">
                              <Image Name="photoPreview" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="Photo (optional)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                              <TextBlock Text="Add a staff profile image for easier account identification." FontSize="11" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                              <WrapPanel>
                                <Button Content="Upload" Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="88" Padding="12,0" FontSize="11" Margin="0,0,8,8" Command="{Binding UploadPhotoCommand}" />
                                <Button Content="Remove" Style="{StaticResource GhostButtonStyle}" Height="32" MinWidth="88" Padding="12,0" FontSize="11" Margin="0,0,0,8" Command="{Binding RemovePhotoCommand}" />
                              </WrapPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock Text="Username / Employee ID" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                        <Border Background="#FFFFFFFF" CornerRadius="8" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" Height="46" Margin="0,0,0,14">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="44" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <fa:IconBlock Icon="User" Foreground="{StaticResource Slate400Brush}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBox Name="txtUsername" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="14" Padding="4,0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                          </Grid>
                        </Border>
                        <TextBlock Text="Password" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                        <Border Background="#FFFFFFFF" CornerRadius="8" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" Height="46" Margin="0,0,0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="44" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <fa:IconBlock Icon="Lock" Foreground="{StaticResource Slate400Brush}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <PasswordBox Name="txtPassword" Grid.Column="1" Style="{StaticResource StyledPasswordBoxStyle}" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="14" Padding="4,0" />
                          </Grid>
                        </Border>
                        <TextBlock Text="Minimum 6 characters with uppercase, lowercase, and a number." FontSize="11" Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,14" />
                        <TextBlock Text="Role" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource StyledComboBoxStyle}" Height="46" Margin="0,0,0,16" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" />
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                          <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="ExclamationTriangle" Foreground="#DC2626" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" MaxWidth="260" Text="{Binding ErrorMessage}" />
                          </StackPanel>
                        </Border>
                        <Button Name="btnRegister" Content="CREATE ACCOUNT" Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource RegisterAccentBrush}" BorderBrush="{StaticResource RegisterAccentBrush}" Height="46" FontSize="15" FontWeight="Bold" IsDefault="True" Click="BtnRegister_Click" />
                        <Border Height="1" Background="{StaticResource Slate200Brush}" Margin="0,18,0,16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock Text="Already have an account?" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" />
                          <Button Content="Back to login" Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource RegisterAccentBrush}" FontWeight="Bold" Margin="8,0,0,0" Command="{Binding BackToLoginCommand}" />
                        </StackPanel>
                      </StackPanel>
                      <Border Background="#80FFFFFF" CornerRadius="18" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center">
                          <fa:IconBlock Icon="Spinner" FontSize="30" Foreground="{StaticResource RegisterAccentBrush}" HorizontalAlignment="Center">
                            <UIElement.RenderTransform>
                              <RotateTransform CenterX="15" CenterY="15" />
                            </UIElement.RenderTransform>
                            <FrameworkElement.Triggers>
                              <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                  <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                  </Storyboard>
                                </BeginStoryboard>
                              </EventTrigger>
                            </FrameworkElement.Triggers>
                          </fa:IconBlock>
                          <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding BusyMessage}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>