<Window x:Class="baranggaysystem1.Views.BulkImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Import Residents"
        WindowStartupLocation="CenterOwner"
        Width="700"
        Height="600"
        ResizeMode="CanResize"
        Background="#FF1a1a2e">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Bulk Import Residents"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,4" />
            <TextBlock Text="Import residents from a CSV file. Required columns: last_name, first_name."
                       FontSize="13"
                       Foreground="#8899A6"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- File Selection -->
        <Border Grid.Row="1" Background="#FF2d2d44" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Select CSV File"
                            Click="SelectFile_Click"
                            Padding="16,8"
                            FontSize="13"
                            Background="#3498db"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,8,0" />
                    <Button Content="Download Template"
                            Click="DownloadTemplate_Click"
                            Padding="16,8"
                            FontSize="13"
                            Background="Transparent"
                            Foreground="#AAB8C2"
                            BorderBrush="#5c5c8a"
                            BorderThickness="1"
                            Cursor="Hand" />
                </StackPanel>

                <TextBlock x:Name="filePathLabel"
                           Text="No file selected"
                           FontSize="12"
                           Foreground="#657786"
                           Margin="0,8,0,0" />

                <!-- Options -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="skipDuplicatesCheck"
                              Content="Skip duplicate names"
                              Foreground="#AAB8C2"
                              IsChecked="True"
                              Margin="0,0,16,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results Area -->
        <Border Grid.Row="2" Background="#FF2d2d44" CornerRadius="8" Padding="16">
            <Grid>
                <!-- Parse results -->
                <StackPanel x:Name="parseResultsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="parseStatusLabel"
                               Text=""
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1a4a1a" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock x:Name="validCountLabel" Text="0 valid" FontSize="12" Foreground="#4CAF50" />
                        </Border>
                        <Border Background="#4a1a1a" CornerRadius="4" Padding="8,4">
                            <TextBlock x:Name="errorCountLabel" Text="0 errors" FontSize="12" Foreground="#FF6B6B" />
                        </Border>
                    </StackPanel>

                    <!-- Error list -->
                    <TextBlock Text="Validation Errors:" FontSize="12" Foreground="#AAB8C2" Margin="0,8,0,4"
                               x:Name="errorsHeader" Visibility="Collapsed" />
                    <ListBox x:Name="errorsList"
                             MaxHeight="150"
                             Background="#FF1a1a2e"
                             Foreground="#FF6B6B"
                             BorderThickness="0"
                             FontSize="11"
                             Visibility="Collapsed" />
                </StackPanel>

                <!-- Import results -->
                <StackPanel x:Name="importResultsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="importStatusLabel"
                               Text=""
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#4CAF50"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="importDetailsLabel"
                               Text=""
                               FontSize="13"
                               Foreground="#AAB8C2"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Empty state -->
                <TextBlock x:Name="emptyStateLabel"
                           Text="Select a CSV file to preview the import."
                           FontSize="14"
                           Foreground="#657786"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="importButton"
                    Content="Import Residents"
                    Click="ImportButton_Click"
                    Padding="20,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsEnabled="False"
                    Margin="0,0,8,0" />
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Padding="20,10"
                    FontSize="14"
                    Background="Transparent"
                    Foreground="#AAB8C2"
                    BorderBrush="#5c5c8a"
                    BorderThickness="1"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
