<nav:FullscreenFormBase x:Class="baranggaysystem1.Views.Panels.CertificateFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:controls="clr-namespace:baranggaysystem1.Views.Controls"
             xmlns:nav="clr-namespace:baranggaysystem1.ViewModels.Navigation">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Validation Panel -->
        <controls:FormValidationPanel x:Name="validationPanel" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed" />

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Resident Selection (shown when no resident is pre-selected) -->
                <StackPanel x:Name="residentPickerSection" Margin="0,0,0,16">
                    <TextBlock Text="Resident *" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox x:Name="cmbResident" Style="{StaticResource StyledComboBoxStyle}" Padding="6"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="ComboField_Changed"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="FullName" />
                </StackPanel>

                <!-- Pre-selected Resident Display (shown when resident is pre-selected) -->
                <Border x:Name="residentDisplaySection" Visibility="Collapsed"
                        Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="User" FontSize="16" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="txtResidentDisplay" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Separator Margin="0,0,0,16" Background="{StaticResource Slate100Brush}" />

                <!-- Document Type -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Document Type *" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox x:Name="cmbDocumentType" Style="{StaticResource StyledComboBoxStyle}" Padding="6"
                              DisplayMemberPath="Name"
                              SelectionChanged="DocumentType_Changed" />
                </StackPanel>

                <!-- Purpose -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Purpose *" Style="{StaticResource LabelTextStyle}" />
                    <TextBox x:Name="txtPurpose" Style="{StaticResource StyledTextBoxStyle}"
                             TextChanged="Field_Changed" LostFocus="Field_LostFocus"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <!-- Business Fields (conditional) -->
                <StackPanel x:Name="businessFieldsSection" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Business Information" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Business Name *" Style="{StaticResource LabelTextStyle}" />
                            <TextBox x:Name="txtBusinessName" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Business Nature *" Style="{StaticResource LabelTextStyle}" />
                            <TextBox x:Name="txtBusinessNature" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Separator Margin="0,4,0,16" Background="{StaticResource Slate100Brush}" />

                <!-- Payment Section (shown for Issue mode) -->
                <StackPanel x:Name="paymentSection" Visibility="Collapsed">
                    <TextBlock Text="Payment Details" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fee (PHP)" Style="{StaticResource LabelTextStyle}" />
                            <TextBox x:Name="txtFee" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OR Number" Style="{StaticResource LabelTextStyle}" />
                            <TextBox x:Name="txtOrNumber" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Payment Method" Style="{StaticResource LabelTextStyle}" />
                            <ComboBox x:Name="cmbPaymentMethod" Style="{StaticResource StyledComboBoxStyle}" Padding="6" SelectionChanged="ComboField_Changed" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Issued Date" Style="{StaticResource LabelTextStyle}" />
                        <DatePicker x:Name="dpIssuedDate" Padding="4" Height="32" SelectedDateChanged="DateField_Changed" />
                    </StackPanel>
                    <Separator Margin="0,4,0,16" Background="{StaticResource Slate100Brush}" />
                </StackPanel>

                <!-- Helper Text -->
                <TextBlock x:Name="txtHelperText" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</nav:FullscreenFormBase>
