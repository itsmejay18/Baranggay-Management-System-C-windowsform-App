<nav:FullscreenFormBase x:Class="baranggaysystem1.Views.Panels.ResidentFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:controls="clr-namespace:baranggaysystem1.Views.Controls"
             xmlns:nav="clr-namespace:baranggaysystem1.ViewModels.Navigation">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Validation Panel -->
        <controls:FormValidationPanel x:Name="validationPanel" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed" />

        <!-- Tabbed Form Content -->
        <TabControl Grid.Row="1" Margin="0" Padding="0" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Personal Info -->
            <TabItem Header="Personal Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <!-- Photo Upload Area -->
                        <Border Width="80" Height="80" CornerRadius="40" Background="#1E3A5F"
                                HorizontalAlignment="Left" Margin="0,0,0,16" Cursor="Hand"
                                MouseLeftButtonDown="PhotoArea_Click" ToolTip="Click to upload photo">
                            <Grid>
                                <Image x:Name="residentPhoto" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40" />
                                    </Image.Clip>
                                </Image>
                                <StackPanel x:Name="photoPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <fa:IconBlock Icon="Camera" FontSize="24" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    <TextBlock Text="Photo" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First Name *" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtFirstName" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last Name *" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtLastName" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Middle Name" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtMiddleName" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Suffix" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtSuffix" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                        </Grid>
                        <Separator Margin="0,4,0,12" Background="{StaticResource Slate100Brush}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gender *" Style="{StaticResource LabelTextStyle}" />
                                <ComboBox x:Name="cmbGender" Style="{StaticResource StyledComboBoxStyle}" Padding="6" SelectionChanged="ComboField_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Civil Status" Style="{StaticResource LabelTextStyle}" />
                                <ComboBox x:Name="cmbCivilStatus" Style="{StaticResource StyledComboBoxStyle}" Padding="6" SelectionChanged="ComboField_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Birth Date *" Style="{StaticResource LabelTextStyle}" />
                                <DatePicker x:Name="dpBirthDate" Padding="4" Height="32" SelectedDateChanged="DateField_Changed" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nationality" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtNationality" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Religion" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtReligion" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Blood Type" Style="{StaticResource LabelTextStyle}" />
                                <ComboBox x:Name="cmbBloodType" Style="{StaticResource StyledComboBoxStyle}" Padding="6" SelectionChanged="ComboField_Changed" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Occupation" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtOccupation" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Educational Attainment" Style="{StaticResource LabelTextStyle}" />
                                <ComboBox x:Name="cmbEducation" Style="{StaticResource StyledComboBoxStyle}" Padding="6" SelectionChanged="ComboField_Changed" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Place of Birth" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtPlaceOfBirth" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email Address" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtEmail" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Address & Household -->
            <TabItem Header="Address &amp; Household">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Purok / Zone *" Style="{StaticResource LabelTextStyle}" />
                                <ComboBox x:Name="cmbPurok" DisplayMemberPath="Name" Style="{StaticResource StyledComboBoxStyle}" Padding="6" SelectionChanged="ComboField_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Contact Number" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtContact" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="House No." Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtHouseNo" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Street" Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtStreet" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                        </Grid>
                        <Separator Margin="0,4,0,12" Background="{StaticResource Slate100Brush}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Date of Residency" Style="{StaticResource LabelTextStyle}" />
                                <DatePicker x:Name="dpResidency" Padding="4" Height="32" SelectedDateChanged="DateField_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Household Relationship" Style="{StaticResource LabelTextStyle}" />
                                <ComboBox x:Name="cmbHouseholdRelationship" Style="{StaticResource StyledComboBoxStyle}" Padding="6" SelectionChanged="ComboField_Changed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Government IDs -->
            <TabItem Header="Government IDs">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Government identification numbers for verification and services." Foreground="#64748B" FontSize="12" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PhilHealth No." Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtPhilHealth" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SSS No." Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtSss" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TIN No." Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtTin" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Voter's ID No." Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="txtVotersId" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Registries -->
            <TabItem Header="Registries">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Check all applicable registries for this resident." Foreground="#64748B" FontSize="12" Margin="0,0,0,16" />
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <CheckBox x:Name="chkPwd" Content="PWD (Person with Disability)" Margin="0,0,0,12" Checked="CheckField_Changed" Unchecked="CheckField_Changed" />
                            <CheckBox x:Name="chkSenior" Content="Senior Citizen" Margin="0,0,0,12" Checked="CheckField_Changed" Unchecked="CheckField_Changed" />
                            <CheckBox x:Name="chk4Ps" Content="4Ps Beneficiary" Margin="0,0,0,12" Checked="CheckField_Changed" Unchecked="CheckField_Changed" />
                            <CheckBox x:Name="chkVoter" Content="Registered Voter" Margin="0,0,0,12" Checked="CheckField_Changed" Unchecked="CheckField_Changed" />
                            <CheckBox x:Name="chkSoloParent" Content="Solo Parent" Margin="0,0,0,12" Checked="CheckField_Changed" Unchecked="CheckField_Changed" />
                            <CheckBox x:Name="chkYouth" Content="Youth (15-30 years old)" Margin="0,0,0,12" Checked="CheckField_Changed" Unchecked="CheckField_Changed" />
                            <CheckBox x:Name="chkIndigent" Content="Indigent" Margin="0,0,0,12" Checked="CheckField_Changed" Unchecked="CheckField_Changed" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</nav:FullscreenFormBase>
