<UserControl x:Class="baranggaysystem1.Views.Panels.ResidentDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <!-- Photo and Name Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="72" Height="72" CornerRadius="36" Background="#1E3A5F" Margin="0,0,16,0">
                    <Grid>
                        <Image x:Name="residentPhoto" Stretch="UniformToFill" Visibility="Collapsed">
                            <Image.Clip>
                                <EllipseGeometry Center="36,36" RadiusX="36" RadiusY="36" />
                            </Image.Clip>
                        </Image>
                        <fa:IconBlock x:Name="photoPlaceholder" Icon="User" FontSize="28" Foreground="#94A3B8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="lblFullName" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" />
                    <TextBlock x:Name="lblResidentMeta" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <Separator Background="{StaticResource Slate100Brush}" Margin="0,0,0,16" />

            <!-- Personal Information Section -->
            <TextBlock Text="Personal Information" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="Gender" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblGender" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,8">
                    <TextBlock Text="Civil Status" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblCivilStatus" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="Birth Date" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblBirthDate" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="Nationality" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblNationality" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,8">
                    <TextBlock Text="Religion" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblReligion" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="Blood Type" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblBloodType" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="Occupation" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblOccupation" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,8">
                    <TextBlock Text="Education" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblEducation" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="Place of Birth" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblPlaceOfBirth" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Separator Background="{StaticResource Slate100Brush}" Margin="0,8,0,16" />

            <!-- Contact & Address Section -->
            <TextBlock Text="Contact &amp; Address" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="Contact No." FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblContact" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,8">
                    <TextBlock Text="Email" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblEmail" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="Purok / Zone" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblPurok" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="House No." FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblHouseNo" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,8">
                    <TextBlock Text="Street" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblStreet" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="Household Relationship" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblHouseholdRelationship" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Separator Background="{StaticResource Slate100Brush}" Margin="0,8,0,16" />

            <!-- Government IDs Section -->
            <TextBlock Text="Government IDs" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="PhilHealth No." FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblPhilHealth" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="SSS No." FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblSss" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="TIN No." FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblTin" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Voter's ID No." FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblVotersId" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Separator Background="{StaticResource Slate100Brush}" Margin="0,8,0,16" />

            <!-- Registries Section -->
            <TextBlock Text="Registries" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,12" />
            <WrapPanel Margin="0,0,0,8">
                <Border x:Name="badgePwd" CornerRadius="4" Background="#DBEAFE" Padding="8,4" Margin="0,0,8,8" Visibility="Collapsed">
                    <TextBlock Text="PWD" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="badgeSenior" CornerRadius="4" Background="#DBEAFE" Padding="8,4" Margin="0,0,8,8" Visibility="Collapsed">
                    <TextBlock Text="Senior Citizen" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="badge4Ps" CornerRadius="4" Background="#FEF3C7" Padding="8,4" Margin="0,0,8,8" Visibility="Collapsed">
                    <TextBlock Text="4Ps Beneficiary" FontSize="11" Foreground="#92400E" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="badgeVoter" CornerRadius="4" Background="#D1FAE5" Padding="8,4" Margin="0,0,8,8" Visibility="Collapsed">
                    <TextBlock Text="Registered Voter" FontSize="11" Foreground="#065F46" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="badgeSoloParent" CornerRadius="4" Background="#FCE7F3" Padding="8,4" Margin="0,0,8,8" Visibility="Collapsed">
                    <TextBlock Text="Solo Parent" FontSize="11" Foreground="#9D174D" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="badgeYouth" CornerRadius="4" Background="#E0E7FF" Padding="8,4" Margin="0,0,8,8" Visibility="Collapsed">
                    <TextBlock Text="Youth" FontSize="11" Foreground="#3730A3" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="badgeIndigent" CornerRadius="4" Background="#FEE2E2" Padding="8,4" Margin="0,0,8,8" Visibility="Collapsed">
                    <TextBlock Text="Indigent" FontSize="11" Foreground="#991B1B" FontWeight="SemiBold" />
                </Border>
            </WrapPanel>

            <!-- Residency Info -->
            <Separator Background="{StaticResource Slate100Brush}" Margin="0,8,0,16" />
            <TextBlock Text="Residency" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="Date of Residency" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblDateOfResidency" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="Status" FontSize="11" Foreground="#64748B" />
                    <TextBlock x:Name="lblStatus" FontSize="13" Foreground="{StaticResource Slate900Brush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
