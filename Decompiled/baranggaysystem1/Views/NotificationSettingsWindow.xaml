<Window x:Class="baranggaysystem1.Views.NotificationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification Settings"
        WindowStartupLocation="CenterOwner"
        Width="600"
        Height="700"
        ResizeMode="CanResize"
        Background="#FF1a1a2e">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Notification Settings"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,8" />
                <TextBlock Text="Configure email and SMS notifications for the system."
                           FontSize="13"
                           Foreground="#8899A6"
                           Margin="0,0,0,24" />

                <!-- SMTP Section -->
                <Border Background="#FF2d2d44" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📧 Email (SMTP)" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                            <CheckBox x:Name="smtpEnabledCheck" Content="Enabled" Foreground="#AAB8C2" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="SMTP Host" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                                <TextBox x:Name="smtpHostBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Port" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                                <TextBox x:Name="smtpPortBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="From Email" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                        <TextBox x:Name="smtpFromBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />

                        <TextBlock Text="From Name" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                        <TextBox x:Name="smtpFromNameBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />

                        <TextBlock Text="Username" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                        <TextBox x:Name="smtpUserBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />

                        <TextBlock Text="Password" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                        <PasswordBox x:Name="smtpPassBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />

                        <CheckBox x:Name="smtpSslCheck" Content="Use SSL/TLS" Foreground="#AAB8C2" Margin="0,4,0,12" IsChecked="True" />

                        <!-- Test button -->
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="smtpTestEmailBox" Width="200" FontSize="12" Padding="6,4" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" />
                            <Button Content="Send Test" Click="TestSmtp_Click" Padding="12,4" FontSize="12" Background="#3498db" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SMS Section -->
                <Border Background="#FF2d2d44" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📱 SMS" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                            <CheckBox x:Name="smsEnabledCheck" Content="Enabled" Foreground="#AAB8C2" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="API URL" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                        <TextBox x:Name="smsApiUrlBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />

                        <TextBlock Text="API Token (Bearer)" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                        <PasswordBox x:Name="smsTokenBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />

                        <TextBlock Text="Sender Name" FontSize="11" Foreground="#8899A6" Margin="0,0,0,2" />
                        <TextBox x:Name="smsSenderBox" FontSize="13" Padding="8,6" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="0,0,0,8" />

                        <!-- Test button -->
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="smsTestNumberBox" Width="200" FontSize="12" Padding="6,4" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" />
                            <Button Content="Send Test" Click="TestSms_Click" Padding="12,4" FontSize="12" Background="#3498db" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Reminder Automation Section -->
                <Border Background="#FF2d2d44" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⏰ Automated Reminders" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                        <CheckBox x:Name="renewalReminderCheck" Content="Certificate Renewal Reminders" Foreground="#AAB8C2" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,12">
                            <TextBlock Text="Remind" FontSize="12" Foreground="#8899A6" VerticalAlignment="Center" />
                            <TextBox x:Name="renewalDaysBox" Width="50" FontSize="12" Padding="4" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="8,0,8,0" TextAlignment="Center" />
                            <TextBlock Text="days before expiry" FontSize="12" Foreground="#8899A6" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox x:Name="blotterReminderCheck" Content="Blotter Case Follow-up Reminders" Foreground="#AAB8C2" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBlock Text="Remind after" FontSize="12" Foreground="#8899A6" VerticalAlignment="Center" />
                            <TextBox x:Name="blotterAgeDaysBox" Width="50" FontSize="12" Padding="4" Background="#FF3d3d5c" Foreground="White" BorderBrush="#FF5c5c8a" Margin="8,0,8,0" TextAlignment="Center" />
                            <TextBlock Text="days of inactivity" FontSize="12" Foreground="#8899A6" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status message -->
                <TextBlock x:Name="statusLabel"
                           Text=""
                           FontSize="12"
                           Foreground="#4CAF50"
                           Margin="0,0,0,12"
                           Visibility="Collapsed" />

                <!-- Save/Cancel -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Save Settings"
                            Click="SaveButton_Click"
                            Padding="20,10"
                            FontSize="14"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,8,0" />
                    <Button Content="Close"
                            Click="CloseButton_Click"
                            Padding="20,10"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="#AAB8C2"
                            BorderBrush="#5c5c8a"
                            BorderThickness="1"
                            Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
