<Window x:Class="baranggaysystem1.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:baranggaysystem1.ViewModels" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Barangay Management System - Secure Login" MinWidth="1000" MinHeight="600" WindowState="Maximized" WindowStartupLocation="CenterScreen" Style="{StaticResource BaseWindowStyle}" Background="#0F2B57" UseLayoutRounding="True" xmlns:views="clr-namespace:baranggaysystem1.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="LoginAccentBrush" Color="#173A6A" />
      <SolidColorBrush x:Key="LoginStageBrush" Color="#EFF5FC" />
      <SolidColorBrush x:Key="LoginOutlineBrush" Color="#D8E3F0" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.DataContext>
    <vm:LoginViewModel />
  </FrameworkElement.DataContext>

  <!-- Full-screen two-column layout -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>

    <!-- LEFT: Branding panel fills available space -->
    <Border Grid.Column="0" Background="#0F2B57">
      <Grid>
        <Rectangle Width="360" Height="360" RadiusX="180" RadiusY="180" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,-100,0" />
        <Rectangle Width="260" Height="260" RadiusX="130" RadiusY="130" Fill="#12FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-80,0,0,-80" />
        <StackPanel MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="48">
          <Grid Width="140" Height="140" Margin="0,0,0,24">
            <Ellipse Fill="#F7FAFF" Opacity="0.97">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Color="#08203F" Opacity="0.15" />
              </UIElement.Effect>
            </Ellipse>
            <Grid>
              <UIElement.Clip>
                <EllipseGeometry Center="70,70" RadiusX="70" RadiusY="70" />
              </UIElement.Clip>
              <Image Name="logoImage" Margin="8" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
              <StackPanel Name="logoFallback" VerticalAlignment="Center">
                <fa:IconBlock Icon="University" Foreground="{StaticResource LoginAccentBrush}" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Name="logoFallbackText" Text="BMS" Foreground="{StaticResource LoginAccentBrush}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>
          </Grid>
          <TextBlock Text="OFFICE PROFILE" FontSize="11" FontWeight="SemiBold" Foreground="#B9CBE3" HorizontalAlignment="Center" Margin="0,0,0,14" />
          <TextBlock Name="brandPrimaryText" Text="Local Government of Barangay San Jose" FontSize="26" FontWeight="Bold" Foreground="#FFFFFFFF" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Name="brandSecondaryText" Text="Barangay San Jose | Province" FontSize="14" Foreground="#D7E3F3" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6" />
          <TextBlock Name="brandAddressText" Text="Office address" FontSize="12" Foreground="#B4C4DB" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />
          <Border Height="1" Width="240" Background="#24FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,20" />
          <TextBlock Text="Community records, permits, certifications, and reporting in one desktop workspace." FontSize="13" Foreground="#DCE7F5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- RIGHT: Login form panel -->
    <Border Grid.Column="1" Background="#FFFFFF">
      <Grid VerticalAlignment="Center" Margin="40,32">
        <StackPanel MaxWidth="340">
          <!-- Logo + Title -->
          <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Ellipse Fill="#F0F5FB" />
            <Grid>
              <UIElement.Clip>
                <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32" />
              </UIElement.Clip>
              <Image Name="rightLogoImage" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
              <StackPanel Name="rightLogoFallback" VerticalAlignment="Center">
                <fa:IconBlock Icon="University" Foreground="{StaticResource LoginAccentBrush}" FontSize="24" HorizontalAlignment="Center" />
                <TextBlock Name="rightLogoFallbackText" Text="BMS" Foreground="{StaticResource LoginAccentBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </Grid>
          <TextBlock Name="softwareNameText" Text="Barangay Management System" FontSize="17" FontWeight="Bold" Foreground="{StaticResource LoginAccentBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,2" />
          <TextBlock Name="softwareSubtitleText" Text="Secure access for Barangay San Jose" FontSize="11" Foreground="{StaticResource Slate500Brush}" TextAlignment="Center" Margin="0,0,0,16" />

          <!-- Connection profile -->
          <ComboBox Name="cmbConnectionProfile" Height="32" FontSize="12" Margin="0,0,0,4" SelectionChanged="CmbConnectionProfile_SelectionChanged" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <fa:IconBlock Name="connectionStatusIcon" Icon="CircleNotch" Foreground="{StaticResource LoginAccentBrush}" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Name="connectionStatusText" Text="Checking database..." Margin="6,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource LoginAccentBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Username -->
          <TextBlock Text="Username / Employee ID" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5" />
          <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1" Height="40" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="#F9FAFB" CornerRadius="8,0,0,8">
                <fa:IconBlock Icon="User" Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
              <TextBox Name="txtUsername" Grid.Column="1" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Padding="8,0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </Border>

          <!-- Password -->
          <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5" />
          <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1" Height="40" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="#F9FAFB" CornerRadius="8,0,0,8">
                <fa:IconBlock Icon="Lock" Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
              <PasswordBox Name="txtPassword" Grid.Column="1" Style="{StaticResource StyledPasswordBoxStyle}" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Padding="8,0" />
            </Grid>
          </Border>

          <TextBlock Text="Use your assigned staff credentials to continue." FontSize="10" Foreground="#6B7280" Margin="0,0,0,14" />

          <!-- Error message -->
          <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="ExclamationTriangle" Foreground="#DC2626" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top" />
              <TextBlock Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap" MaxWidth="280" Text="{Binding ErrorMessage}" />
            </StackPanel>
          </Border>

          <!-- Login button -->
          <Button Name="btnLogin" Content="LOGIN" Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource LoginAccentBrush}" BorderBrush="{StaticResource LoginAccentBrush}" Height="42" FontSize="14" FontWeight="Bold" IsDefault="True" Click="BtnLogin_Click" />

          <!-- Register + Forgot -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock Text="Need a new account?" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
            <Button Content="Request registration" Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource LoginAccentBrush}" FontWeight="Bold" FontSize="12" Margin="6,0,0,0" Command="{Binding RegisterCommand}" />
          </StackPanel>
          <Button Content="Forgot password?" Style="{StaticResource GhostButtonStyle}" Foreground="#6B7280" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" Click="BtnForgotPassword_Click" />
        </StackPanel>

        <!-- Busy overlay -->
        <Border Background="#CCFFFFFF" CornerRadius="12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel VerticalAlignment="Center">
            <fa:IconBlock Icon="Spinner" FontSize="28" Foreground="{StaticResource LoginAccentBrush}" HorizontalAlignment="Center">
              <UIElement.RenderTransform>
                <RotateTransform CenterX="14" CenterY="14" />
              </UIElement.RenderTransform>
              <FrameworkElement.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </FrameworkElement.Triggers>
            </fa:IconBlock>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Text="{Binding BusyMessage}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
