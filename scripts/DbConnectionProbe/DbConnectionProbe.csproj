<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MySql.Data">
      <HintPath>..\..\bin\Debug\net8.0-windows\MySql.Data.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BouncyCastle.Cryptography">
      <HintPath>..\..\bin\Debug\net8.0-windows\BouncyCastle.Cryptography.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Security.Permissions">
      <HintPath>$(USERPROFILE)\.nuget\packages\system.security.permissions\8.0.0\lib\net7.0\System.Security.Permissions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Configuration.ConfigurationManager">
      <HintPath>$(USERPROFILE)\.nuget\packages\system.configuration.configurationmanager\8.0.0\lib\net8.0\System.Configuration.ConfigurationManager.dll</HintPath>
      <Private>true</Private>
    </Reference>
